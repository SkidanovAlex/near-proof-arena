+    /// [x15 research] Samples an integer exactly uniformly from `[0, n)`, for any `n` dividing
+    /// `p - 1` (BabyBear: `n = c * 2^j`, `c | 15`, `j <= 27`).
+    ///
+    /// Draws `x = sample()` (uniform on `[0, p)` for an ideal transcript) and rejects the single
+    /// value `p - 1`, so `x` is uniform on `[0, p - 1)`; since `n | p - 1`, `x mod n` is exactly
+    /// uniform. Rejection probability `1/p` per draw; the loop is unbounded but terminates with
+    /// probability 1 (an in-circuit verifier may instead reject the proof on `x = p - 1`, which
+    /// keeps soundness exact and costs completeness `1/p` per query).
+    fn sample_index_exact(&mut self, n: u64) -> u64 {
+        let p_minus_1 = SC::F::ORDER_U64 - 1;
+        assert!(n >= 1 && p_minus_1 % n == 0, "n must divide p - 1");
+        loop {
+            let x = self.sample().as_canonical_u64();
+            if x != p_minus_1 {
+                return x % n;
+            }
+        }
+    }
