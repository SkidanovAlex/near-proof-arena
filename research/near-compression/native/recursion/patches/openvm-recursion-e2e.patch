+/// L1's verifier program over the base proof: no failures, transcript equals the native one,
+/// one program for both chunks (it depends on the vk and shape only), statement = claim.
+#[test]
+fn e2e_l1_program() {
+    let (ba, pa, vka) = l1_program("positive");
+    let (bb, _, vkb) = l1_program("wrap");
+    assert!(ba.failures.is_empty(), "{:?}", ba.failures);
+    assert_eq!(vka.pre_hash, vkb.pre_hash, "one base vk for both chunks");
+    let mut t = crate::sha384::config::ShaTranscript::default();
+    openvm_stark_backend::verifier::verify(Sha384CpuEngine::new(base_params()).config(), &vka, &pa, &mut t).unwrap();
+    assert_eq!(t.state, ba.transcript.inner.state, "transcript diverged from native");
+    println!("E2E_L1_PROGRAM rows={} jobs={} merkle_nodes={}", ba.instrs.len(), ba.job_units.len(), ba.merkle_nodes);
+    if ba.instrs != bb.instrs {
+        let i = (0..ba.instrs.len().min(bb.instrs.len())).find(|&i| ba.instrs[i] != bb.instrs[i]).unwrap_or(0);
+        println!("E2E_L1_PROGRAM_DIFF lens={} {} first={i}", ba.instrs.len(), bb.instrs.len());
+        for j in i.saturating_sub(6)..(i + 6) {
+            println!("  {j}: A={:?} B={:?}", ba.instrs.get(j), bb.instrs.get(j));
+        }
+    }
+    let claim = SliceBase::new("positive").claim();
+    assert!(check_statement(&ba.public_values(), &claim.public_values()));
+    assert!(!check_statement(&ba.public_values(), &SliceBase::new("wrap").claim().public_values()));
+}
