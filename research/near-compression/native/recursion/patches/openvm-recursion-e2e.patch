+//! [e2e] pq-e2e-slice (results/pq-e2e-slice/README.md): the first end-to-end vertical slice of
+//! the post-quantum chunk proof.
+//!
+//! base AIR set (direct-Wasm EXEC/CODE/RANGE + chunk-statement AIR)
+//!   -> L1 (NV level 1: verifies the base proof, hashes its public values under tag 8)
+//!   -> NV chain at fixed heights; program binding (L2 checks L1's program against the app table,
+//!      the fixed point checks its child's program against its own) is attempted and falls back
+//!      to the unbound statement passthrough when the program differs (gap G1)
+//!   -> FINAL (`Sha384CpuEngine::new_final`)
+//!   -> native V_d (`verify_chunk`): final-domain verification, level, statement digest
+//!      recomputed from the claim (ctx, enc S_0, enc S_S), and (when a program can be pinned)
+//!      the final proof's program openings against the pinned program (`check_final_program`).
+//!
+//! What is proven about the chunk is listed in the README gap list.  In short: the Wasm
+//! execution of one prepared function call (i32.const/add/drop/end, one function, <= 8 stack
+//! slots) is proven by the base AIRs; the chunk context, state roots and the receipt are
+//! STATEMENT-CARRIED STUBS: they are public values of `ChunkStmtAir`, bound by the statement
+//! digest, but no AIR constrains them.
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use openvm_stark_backend::{
+    keygen::types::MultiStarkVerifyingKey,
+    proof::Proof,
+    prover::{AirProvingContext, ColMajorMatrix, CpuColMajorBackend, ProvingContext},
+    test_utils::TestFixture,
+    AirRef, FiatShamirTranscript, StarkEngine,
+};
+use p3_field::{Field, PrimeCharacteristicRing, PrimeField32, TwoAdicField};
+use p3_matrix::dense::RowMajorMatrix;
+
+use crate::sha384::config::{
+    digest_from_bytes, hash_parts, statement_digest, truncate_digest, Digest, Sha384Config,
+    Sha384CpuEngine, ShaTranscript, EF, F,
+};
+
+pub type SC = Sha384Config;
+
+/// The byte-packed direct-Wasm AIRs (generated; code length 5).
+pub mod literal {
+    #![allow(unused_imports, dead_code, clippy::all)]
+    use super::*;
+    include!("e2e_literal_gen.rs");
+}
+
+// ---------------------------------------------------------------------------------------
+// Chunk-statement AIR (STUB carrier)
+// ---------------------------------------------------------------------------------------
+
+/// ctx digest limbs (NV digest format)
+pub const N_CTX: usize = 18;
+/// a SHA-256 state root as 16 x 16-bit limbs
+pub const N_ROOT: usize = 16;
+/// receipt digest limbs
+pub const N_RCPT: usize = 18;
+/// public values of `ChunkStmtAir`: [ctx | pre_state_root | receipt | post_state_root]
+pub const STMT_PVS: usize = N_CTX + N_ROOT + N_RCPT + N_ROOT;
+/// public values of the EXEC AIR (code length 5): 12 header + 27 entry + 27 final + 5 x 25 code
+pub const EXEC_PVS: usize = 12 + 27 + 27 + 5 * 25;
+
+/// STUB: carries ctx, the state roots and the receipt digest as public values.  Its one column is
+/// constrained to zero; nothing relates its public values to the execution (gaps G2-G5).
+#[derive(Clone, Copy)]
+pub struct ChunkStmtAir;
+impl<T> p3_air::BaseAir<T> for ChunkStmtAir {
+    fn width(&self) -> usize {
+        1
+    }
+}
+impl<T> openvm_stark_backend::BaseAirWithPublicValues<T> for ChunkStmtAir {
+    fn num_public_values(&self) -> usize {
+        STMT_PVS
+    }
+}
+impl<T> openvm_stark_backend::PartitionedBaseAir<T> for ChunkStmtAir {}
+impl<AB: p3_air::AirBuilderWithPublicValues> p3_air::Air<AB> for ChunkStmtAir {
+    fn eval(&self, builder: &mut AB) {
+        use p3_air::AirBuilder;
+        use p3_matrix::Matrix;
+        let main = builder.main();
+        let x: AB::Expr = main.row_slice(0).unwrap()[0].clone().into();
+        builder.assert_zero(x);
+    }
+}
+
+/// AIR order of the base proof (= the order of the statement message).
+pub fn base_airs() -> Vec<AirRef<SC>> {
+    vec![
+        Arc::new(literal::Literal0),
+        Arc::new(literal::Literal1),
+        Arc::new(literal::Literal2),
+        Arc::new(ChunkStmtAir),
+    ]
+}
+
+// ---------------------------------------------------------------------------------------
+// The chunk claim (what V_d receives) and its public-value encoding
+// ---------------------------------------------------------------------------------------
+
+/// Native-only hash domains of this slice (proposal; never hashed in-circuit).
+pub const TAG_E2E_CTX: u8 = 10;
+pub const TAG_E2E_RECEIPT: u8 = 11;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct MachineState {
+    pub func: u32,
+    pub pc: u32,
+    pub gas: u64,
+    pub done: bool,
+    pub fail: bool,
+    pub stack: Vec<u32>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CodeEntry {
+    pub pc: u32,
+    pub func: u32,
+    pub opcode: u32,
+    pub imm: u32,
+    pub has: bool,
+    pub kind: u32,
+    pub fee: u64,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Receipt {
+    pub receiver: String,
+    pub method: String,
+    pub prepaid: u64,
+    pub code_hash: [u8; 32],
+}
+
+/// The chunk claim of the slice.  ctx = (chain_id, height, prev_block_hash, gas_price,
+/// protocol_version); enc S_0 = (pre_state_root, receipt, entry, code); enc S_S =
+/// (post_state_root, final).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ChunkClaim {
+    pub chain_id: String,
+    pub height: u64,
+    pub prev_block_hash: [u8; 32],
+    pub gas_price: u64,
+    pub protocol_version: u32,
+    pub pre_state_root: [u8; 32],
+    pub receipt: Receipt,
+    pub entry: MachineState,
+    pub code: Vec<CodeEntry>,
+    pub post_state_root: [u8; 32],
+    pub final_state: MachineState,
+}
+
+fn hex32(s: &str) -> Result<[u8; 32], String> {
+    if s.len() != 64 {
+        return Err(format!("bad hash {s}"));
+    }
+    let mut o = [0u8; 32];
+    for i in 0..32 {
+        o[i] = u8::from_str_radix(&s[2 * i..2 * i + 2], 16).map_err(|e| e.to_string())?;
+    }
+    Ok(o)
+}
+
+fn num<T: std::str::FromStr>(s: &str) -> Result<T, String> {
+    s.parse().map_err(|_| format!("bad number {s}"))
+}
+
+fn parse_state(f: &[&str]) -> Result<MachineState, String> {
+    if f.len() < 5 {
+        return Err("short machine state".into());
+    }
+    Ok(MachineState {
+        func: num(f[0])?,
+        pc: num(f[1])?,
+        gas: num(f[2])?,
+        done: num::<u8>(f[3])? == 1,
+        fail: num::<u8>(f[4])? == 1,
+        stack: f[5..].iter().map(|x| num(x)).collect::<Result<_, _>>()?,
+    })
+}
+
+impl ChunkClaim {
+    pub fn parse(text: &str) -> Result<Self, String> {
+        let mut m: std::collections::HashMap<&str, Vec<&str>> = Default::default();
+        let mut code = vec![];
+        for line in text.lines().map(str::trim).filter(|l| !l.is_empty() && !l.starts_with('#')) {
+            let f: Vec<&str> = line.split_whitespace().collect();
+            if f[0] == "code" {
+                if f.len() != 8 {
+                    return Err(format!("bad code line {line}"));
+                }
+                code.push(CodeEntry {
+                    pc: num(f[1])?,
+                    func: num(f[2])?,
+                    opcode: num(f[3])?,
+                    imm: num(f[4])?,
+                    has: num::<u8>(f[5])? == 1,
+                    kind: num(f[6])?,
+                    fee: num(f[7])?,
+                });
+            } else if m.insert(f[0], f[1..].to_vec()).is_some() {
+                return Err(format!("duplicate field {}", f[0]));
+            }
+        }
+        let g = |k: &str| m.get(k).cloned().ok_or(format!("missing {k}"));
+        let one = |k: &str| -> Result<&str, String> {
+            let v = m.get(k).ok_or(format!("missing {k}"))?;
+            if v.len() != 1 {
+                return Err(format!("field {k} takes one value"));
+            }
+            Ok(v[0])
+        };
+        let r = g("receipt")?;
+        if r.len() != 4 {
+            return Err("bad receipt".into());
+        }
+        Ok(ChunkClaim {
+            chain_id: one("chain_id")?.to_string(),
+            height: num(one("height")?)?,
+            prev_block_hash: hex32(one("prev_block_hash")?)?,
+            gas_price: num(one("gas_price")?)?,
+            protocol_version: num(one("protocol_version")?)?,
+            pre_state_root: hex32(one("pre_state_root")?)?,
+            receipt: Receipt {
+                receiver: r[0].into(),
+                method: r[1].into(),
+                prepaid: num(r[2])?,
+                code_hash: hex32(r[3])?,
+            },
+            entry: parse_state(&g("entry")?)?,
+            code,
+            post_state_root: hex32(one("post_state_root")?)?,
+            final_state: parse_state(&g("final")?)?,
+        })
+    }
+
+    pub fn load(path: &Path) -> Self {
+        Self::parse(&std::fs::read_to_string(path).unwrap_or_else(|e| panic!("{path:?}: {e}")))
+            .unwrap_or_else(|e| panic!("{path:?}: {e}"))
+    }
+
+    fn native_digest(tag: u8, parts: &[&[u8]]) -> Digest {
+        digest_from_bytes(truncate_digest(hash_parts(tag, parts)))
+    }
+
+    /// ctx = SHA-384 (tag 10, truncated as the statement digest) of the chunk-context fields.
+    pub fn ctx_digest(&self) -> Digest {
+        Self::native_digest(
+            TAG_E2E_CTX,
+            &[
+                self.chain_id.as_bytes(),
+                &self.height.to_le_bytes(),
+                &self.prev_block_hash,
+                &self.gas_price.to_le_bytes(),
+                &self.protocol_version.to_le_bytes(),
+            ],
+        )
+    }
+
+    pub fn receipt_digest(&self) -> Digest {
+        let r = &self.receipt;
+        Self::native_digest(
+            TAG_E2E_RECEIPT,
+            &[r.receiver.as_bytes(), r.method.as_bytes(), &r.prepaid.to_le_bytes(), &r.code_hash],
+        )
+    }
+
+    /// The boundary encoding of the direct-Wasm AIR (prepared_code_table_air.boundary()):
+    /// fn (2 x 16 bit), pc (2), sp, done, fail, gas (4 x 16), stack slots 0..8 (2 x 16 each).
+    pub fn enc_state(s: &MachineState) -> Vec<F> {
+        assert!(s.stack.len() <= 8, "eight stack slots");
+        let l16 = |x: u64, i: usize| F::from_u64((x >> (16 * i)) & 0xffff);
+        let mut v = vec![
+            l16(s.func as u64, 0),
+            l16(s.func as u64, 1),
+            l16(s.pc as u64, 0),
+            l16(s.pc as u64, 1),
+            F::from_usize(s.stack.len()),
+            F::from_bool(s.done),
+            F::from_bool(s.fail),
+        ];
+        v.extend((0..4).map(|i| l16(s.gas, i)));
+        for j in 0..8 {
+            let w = s.stack.get(j).copied().unwrap_or(0) as u64;
+            v.extend([l16(w, 0), l16(w, 1)]);
+        }
+        v
+    }
+
+    /// The code descriptor (prepared_code_table_air.descriptor()).
+    pub fn enc_code(e: &CodeEntry) -> Vec<F> {
+        let l16 = |x: u64, i: usize| F::from_u64((x >> (16 * i)) & 0xffff);
+        let ops = [65u32, 106, 26, 11];
+        let op = ops.iter().position(|&o| o == e.opcode).expect("supported opcode");
+        assert!(e.kind < 6);
+        let mut v = vec![l16(e.func as u64, 0), l16(e.func as u64, 1), l16(e.pc as u64, 0), l16(e.pc as u64, 1)];
+        v.extend((0..4).map(|i| F::from_bool(i == op)));
+        v.extend([l16(e.imm as u64, 0), l16(e.imm as u64, 1)]);
+        v.extend((0..4).map(|i| l16(e.fee, i)));
+        v.push(F::from_bool(e.has));
+        v.extend((0..6).map(|i| F::from_bool(e.has && i == e.kind as usize)));
+        v.extend([F::ZERO; 4]);
+        v
+    }
+
+    /// EXEC (AIR 0) public values: nat4(1) nat4(1) nat4(len) | entry | final | code.
+    pub fn exec_public_values(&self) -> Vec<F> {
+        let nat4 = |n: u32| (0..4).map(move |i| F::from_u32((n >> (8 * i)) & 255));
+        let mut v: Vec<F> = nat4(1).chain(nat4(1)).chain(nat4(self.code.len() as u32)).collect();
+        v.extend(Self::enc_state(&self.entry));
+        v.extend(Self::enc_state(&self.final_state));
+        for e in &self.code {
+            v.extend(Self::enc_code(e));
+        }
+        v
+    }
+
+    /// `ChunkStmtAir` public values: [ctx | pre_state_root | receipt | post_state_root].
+    pub fn stmt_public_values(&self) -> Vec<F> {
+        fn root(r: &[u8; 32]) -> Vec<F> {
+            (0..16).map(|i| F::from_u32(u16::from_le_bytes([r[2 * i], r[2 * i + 1]]) as u32)).collect()
+        }
+        let mut v: Vec<F> = super::fmt::digest_limbs(self.ctx_digest()).to_vec();
+        v.extend(root(&self.pre_state_root));
+        v.extend(super::fmt::digest_limbs(self.receipt_digest()));
+        v.extend(root(&self.post_state_root));
+        assert_eq!(v.len(), STMT_PVS);
+        v
+    }
+
+    /// Per-AIR public values of the base proof, in AIR order (the statement message layout).
+    pub fn public_values(&self) -> Vec<Vec<F>> {
+        vec![self.exec_public_values(), vec![], vec![], self.stmt_public_values()]
+    }
+
+    /// The tag-8 statement digest the final proof must expose.
+    pub fn statement_digest(&self) -> Digest {
+        statement_digest(&self.public_values())
+    }
+}
