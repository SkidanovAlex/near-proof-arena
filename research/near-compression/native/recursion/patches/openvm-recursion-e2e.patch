+/// The AIRs enforce the execution: wrong boundary values cannot be proven.
+#[test]
+fn e2e_base_tamper() {
+    let engine = Sha384CpuEngine::new(base_params());
+    let fx = SliceBase::new("positive");
+    // honest passes the debug checker
+    engine.debug(&fx.airs(), &fx.debug_ctx());
+    let cases: Vec<(&str, Box<dyn Fn(&mut SliceBase)>)> = vec![
+        ("final gas", Box::new(|f| f.exec_pvs[12 + 27 + 7] += F::ONE)),
+        ("final done", Box::new(|f| f.exec_pvs[12 + 27 + 5] = F::ZERO)),
+        ("entry gas", Box::new(|f| f.exec_pvs[12 + 7] += F::ONE)),
+        ("code immediate", Box::new(|f| f.exec_pvs[66 + 8] += F::ONE)),
+        ("code length header", Box::new(|f| f.exec_pvs[8] += F::ONE)),
+    ];
+    for (name, m) in cases {
+        let mut f = fx.clone();
+        m(&mut f);
+        must_fail(name, || engine.debug(&f.airs(), &f.debug_ctx()));
+    }
