+#[test]
+fn e2e_claim_encoding() {
+    for case in ["positive", "wrap"] {
+        let fx = SliceBase::new(case);
+        let claim = fx.claim();
+        // V_d's encoding (from the Lean prepare/step fixture) = the generator's EXEC public values
+        assert_eq!(claim.exec_public_values(), fx.exec_pvs, "{case}: exec public values");
+        assert_eq!(claim.exec_public_values().len(), EXEC_PVS);
+        assert_eq!(claim.public_values()[3], fx.stmt_pvs);
+    }
+    let (a, b) = (SliceBase::new("positive").claim(), SliceBase::new("wrap").claim());
+    assert_ne!(a.statement_digest(), b.statement_digest());
+    assert_ne!(a.ctx_digest(), b.ctx_digest());
+    // every claim field moves the digest
+    let d = a.statement_digest();
+    let muts: Vec<(&str, Box<dyn Fn(&mut ChunkClaim)>)> = vec![
+        ("chain_id", Box::new(|c| c.chain_id.push('x'))),
+        ("height", Box::new(|c| c.height += 1)),
+        ("prev_block_hash", Box::new(|c| c.prev_block_hash[31] ^= 1)),
+        ("gas_price", Box::new(|c| c.gas_price += 1)),
+        ("protocol_version", Box::new(|c| c.protocol_version += 1)),
+        ("pre_state_root", Box::new(|c| c.pre_state_root[0] ^= 1)),
+        ("receipt.prepaid", Box::new(|c| c.receipt.prepaid += 1)),
+        ("receipt.code_hash", Box::new(|c| c.receipt.code_hash[5] ^= 1)),
+        ("entry.gas", Box::new(|c| c.entry.gas += 1)),
+        ("code.imm", Box::new(|c| c.code[0].imm += 1)),
+        ("code.fee", Box::new(|c| c.code[0].fee += 1)),
+        ("post_state_root", Box::new(|c| c.post_state_root[0] ^= 1)),
+        ("final.gas", Box::new(|c| c.final_state.gas += 1)),
+        ("final.fail", Box::new(|c| c.final_state.fail = true)),
+        ("final.stack", Box::new(|c| c.final_state.stack.push(35))),
+    ];
+    for (name, m) in muts {
+        let mut c = a.clone();
+        m(&mut c);
+        assert_ne!(c.statement_digest(), d, "{name} does not move the digest");
+    }
+}
