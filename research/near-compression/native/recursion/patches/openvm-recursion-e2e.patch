+struct Level {
+    vk: MultiStarkVerifyingKey<Sha384Config>,
+    proof: Proof<Sha384Config>,
+    program: Vec<[u32; 4]>,
+    heights: Vec<usize>,
+}
+
+fn hwm_gb() -> f64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| s.lines().find(|l| l.starts_with("VmHWM")).map(|l| l.split_whitespace().nth(1).unwrap().parse::<f64>().unwrap()))
+        .unwrap_or(0.0)
+        / 1048576.0
+}
+
+fn level(tag: &str, circ: &NvCircuit, eng: &Sha384CpuEngine, vk: &MultiStarkVerifyingKey<Sha384Config>, p: &Proof<Sha384Config>) -> Level {
+    let _ = std::fs::write("/proc/self/clear_refs", "5");
+    let t = std::time::Instant::now();
+    let (vk1, p1, b, shapes) = prove_level(circ, eng, vk, p);
+    let secs = t.elapsed().as_secs_f64();
+    let heights: Vec<usize> = shapes.iter().map(|s| s.0).collect();
+    println!(
+        "{tag}_RESOURCES wall_s={secs:.1} peak_rss_gb={:.2} program_rows={} merkle_nodes={} heights={heights:?} bind={} child_nv={}",
+        hwm_gb(),
+        b.instrs.len(),
+        b.merkle_nodes,
+        circ.bind,
+        circ.child_nv
+    );
+    soundness(tag, &vk1);
+    println!("{tag}_PROOF_BYTES {}", proof_sizes(&p1));
+    println!("{tag}_LEVEL {}", p1.public_values[0][0]);
+    Level { vk: vk1, proof: p1, program: NvCircuit::app_table(&b.instrs), heights }
+}
+
+fn save(dir: &Option<String>, name: &str, p: &Proof<Sha384Config>) {
+    if let Some(d) = dir {
+        use openvm_stark_backend::codec::Encode;
+        let mut bytes = vec![];
+        p.encode(&mut bytes).unwrap();
+        std::fs::write(format!("{d}/{name}.proof"), &bytes).unwrap();
+    }
+}
+
+/// The chain for one chunk at fixed heights: B1 (L1 over the base proof) -> B2 -> [B3.., E2E_INNER]
+/// -> FINAL (final domain).  Binding (`bind`: L2 checks L1 against the app table = B1's program, the
+/// fixed point checks its child against its own program) is attempted when E2E_BIND=1 (default);
+/// if the generated program reports a binding failure (gap G1) the level falls back to the
+/// unbound passthrough (`child_nv`), as in the recursion lane's measured chains.
+#[allow(clippy::too_many_arguments)]
+fn chain(
+    tag: &str,
+    k: usize,
+    log_rows: usize,
+    fixed: &[usize],
+    engine: &Sha384CpuEngine,
+    final_engine: &Sha384CpuEngine,
+    vk0: &MultiStarkVerifyingKey<Sha384Config>,
+    p0: &Proof<Sha384Config>,
+    save_dir: &Option<String>,
+) -> (Vec<Level>, Level, bool) {
+    let inner = env_usize("E2E_INNER", 0);
+    let mut bound = env_usize("E2E_BIND", 1) == 1;
+    let mut circ = NvCircuit::new(k, log_rows, 1);
+    circ.heights = Some(fixed.to_vec());
+    let b1 = level(&format!("{tag}B1"), &circ, engine, vk0, p0);
+    save(save_dir, &format!("{tag}B1"), &b1.proof);
+    let app = b1.program.clone();
+    let mut levels = vec![b1];
+    for i in 0..=inner + 1 {
+        let is_final = i == inner + 1;
+        let name = if is_final { format!("{tag}FINAL") } else { format!("{tag}B{}", i + 2) };
+        let (pvk, pp) = (&levels.last().unwrap().vk, &levels.last().unwrap().proof);
+        if bound {
+            circ.bind = true;
+            circ.child_nv = false;
+            circ.app = Some(app.clone());
+            let (_, b) = circ.generate(pvk, pp);
+            if !b.failures.is_empty() {
+                println!("E2E_BIND_FAIL {name}: {:?} -> unbound passthrough from here on (gap G1)", b.failures);
+                bound = false;
+            }
+        }
+        if !bound {
+            circ.bind = false;
+            circ.child_nv = true;
+            circ.app = None;
+        }
+        let eng = if is_final { final_engine } else { engine };
+        let l = level(&name, &circ, eng, pvk, pp);
+        save(save_dir, &name, &l.proof);
+        levels.push(l);
+    }
+    let fin = levels.pop().unwrap();
+    (levels, fin, bound)
+}
+
+#[test]
+#[ignore]
+fn e2e_slice_chain() {
+    let save_dir = std::env::var("E2E_SAVE_DIR").ok();
+    let log_rows = env_usize("NV_LOG_ROWS", 17);
+    // ---- base proof of chunk A ----
+    let base_engine = Sha384CpuEngine::new(base_params());
+    describe("E2E_BASE", base_engine.params());
+    let fx_a = SliceBase::new("positive");
+    let claim_a = fx_a.claim();
+    let t = std::time::Instant::now();
+    let (vk0, p0) = fx_a.keygen_and_prove(&base_engine);
+    println!("BASE_RESOURCES wall_s={:.1} peak_rss_gb={:.2}", t.elapsed().as_secs_f64(), hwm_gb());
+    base_engine.verify(&vk0, &p0).unwrap();
+    soundness("BASE", &vk0);
+    println!("BASE_PROOF_BYTES {}", proof_sizes(&p0));
+    assert_eq!(p0.public_values, claim_a.public_values(), "base public values = claim encoding");
+    save(&save_dir, "A_BASE", &p0);
+    // ---- NV engines ----
+    let pp = nv_params("PARENT");
+    describe("NV_PARENT", &pp);
+    let engine = Sha384CpuEngine::new(pp);
+    let fp = if std::env::var("FINAL_LOG_BLOWUP").is_ok() { nv_params("FINAL") } else { nv_params("PARENT") };
+    describe("NV_FINAL", &fp);
+    let final_engine = Sha384CpuEngine::new_final(fp);
+    let k = engine.params().k_whir();
+    // ---- phase A: natural heights to find the fixed point (skipped with E2E_FIXED) ----
+    let fixed: Vec<usize> = if let Ok(s) = std::env::var("E2E_FIXED") {
+        s.split(',').map(|x| x.trim().parse().unwrap()).collect()
+    } else {
+        let mut circ = NvCircuit::new(k, log_rows, 1);
+        let a1 = level("A1", &circ, &engine, &vk0, &p0);
+        circ.child_nv = true;
+        let a2 = level("A2", &circ, &engine, &a1.vk, &a1.proof);
+        let (mats3, b3) = circ.generate(&a2.vk, &a2.proof);
+        assert!(b3.failures.is_empty(), "{:?}", b3.failures);
+        let h3: Vec<usize> = mats3.iter().map(p3_matrix::Matrix::height).collect();
+        println!("A3_GENERATED heights={h3:?} program_rows={}", b3.instrs.len());
+        assert_eq!(h3, a2.heights, "heights did not repeat after A2 (set E2E_FIXED)");
+        a1.heights.iter().zip(&a2.heights).map(|(a, b)| *a.max(b)).collect()
+    };
+    println!("E2E_FIXED_HEIGHTS {fixed:?}");
+    // ---- phase B: the chain for chunk A ----
+    let (levels_a, fin_a, bound) = chain("A_", k, log_rows, &fixed, &engine, &final_engine, &vk0, &p0, &save_dir);
+    let final_level = fin_a.proof.public_values[0][0].as_canonical_u32();
+    println!("E2E_CHAIN bound={bound} final_level={final_level} levels={}", levels_a.len() + 1);
+    if bound {
+        assert_eq!(&fin_a.program, &levels_a.last().unwrap().program, "FINAL program = inner fixed-point program");
+    }
+    // the program V_d would pin (only meaningful when the program is fixed, i.e. after G1)
+    let pinned = VdSetup { vk_final: fin_a.vk.clone(), program: Some(fin_a.program.clone()), level: final_level };
+    let unpinned = VdSetup { program: None, ..pinned.clone() };
+    let vd = |s: &VdSetup, c: &ChunkClaim, p: &Proof<Sha384Config>| verify_chunk(s, &final_engine, c, p);
+    // ---- V_d accepts the honest chunk ----
+    let t = std::time::Instant::now();
+    vd(&pinned, &claim_a, &fin_a.proof).expect("V_d (program pinned) rejects the honest chunk A");
+    println!("E2E_VD_ACCEPT chunk A, program pinned, vd_s={:.3}", t.elapsed().as_secs_f64());
+    vd(&unpinned, &claim_a, &fin_a.proof).expect("V_d (unpinned) rejects the honest chunk A");
+    println!("E2E_VD_ACCEPT chunk A, program unpinned");
+    let reject = |name: &str, s: &VdSetup, c: &ChunkClaim, p: &Proof<Sha384Config>| {
+        let r = vd(s, c, p);
+        assert!(r.is_err(), "V_d accepted tamper {name}");
+        println!("E2E_VD_REJECT {name}: {}", r.unwrap_err());
+    };
+    // ---- statement tampers (both setups) ----
+    for (sn, s) in [("pinned", &pinned), ("unpinned", &unpinned)] {
+        let mut c = claim_a.clone();
+        c.final_state.gas += 1;
+        reject(&format!("[{sn}] wrong S_S (final gas)"), s, &c, &fin_a.proof);
+        let mut c = claim_a.clone();
+        c.post_state_root[0] ^= 1;
+        reject(&format!("[{sn}] wrong S_S (post-state root, stub field)"), s, &c, &fin_a.proof);
+        let mut c = claim_a.clone();
+        c.height += 1;
+        reject(&format!("[{sn}] wrong ctx (height)"), s, &c, &fin_a.proof);
+        let mut c = claim_a.clone();
+        c.code[1].imm = 24;
+        reject(&format!("[{sn}] wrong S_0 (contract immediate)"), s, &c, &fin_a.proof);
+        reject(&format!("[{sn}] claim of chunk B, proof of chunk A"), s, &SliceBase::new("wrap").claim(), &fin_a.proof);
+        let mut bad = fin_a.proof.clone();
+        bad.public_values[0][5] += F::ONE;
+        reject(&format!("[{sn}] final public value limb"), s, &claim_a, &bad);
+        reject(&format!("[{sn}] inner-domain proof presented as final"), s, &claim_a, &levels_a.last().unwrap().proof);
+        let mut s2 = s.clone();
+        s2.level += 1;
+        reject(&format!("[{sn}] pinned level"), &s2, &claim_a, &fin_a.proof);
+    }
+    // ---- the native program check itself ----
+    let mut s = pinned.clone();
+    s.program = Some(levels_a[0].program.clone());
+    reject("program pinned to the L1 program", &s, &claim_a, &fin_a.proof);
+    let mut s = pinned.clone();
+    let prog = s.program.as_mut().unwrap();
+    let mid = prog.len() / 2;
+    prog[mid][0] ^= 1;
+    reject("pinned program, one word changed", &s, &claim_a, &fin_a.proof);
+    // ---- forgery: a final-domain proof of a program that verifies nothing ----
+    if env_usize("E2E_FORGE", 1) == 1 {
+        let mut circ = NvCircuit::new(k, log_rows, 1);
+        circ.heights = Some(fixed.clone());
+        let mut forged_claim = claim_a.clone();
+        forged_claim.final_state.gas = 1;
+        forged_claim.post_state_root = [7u8; 32];
+        let t = std::time::Instant::now();
+        let (mats, b) = generate_program(&circ, forge_statement_program(final_level, forged_claim.statement_digest()));
+        assert!(b.failures.is_empty());
+        let (fvk, forged) = prove_traces(&circ, &final_engine, mats, b.public_values());
+        println!("FORGED_RESOURCES wall_s={:.1} program_rows={} bytes={}", t.elapsed().as_secs_f64(), b.instrs.len(), proof_sizes(&forged));
+        assert_eq!(fvk.pre_hash, pinned.vk_final.pre_hash, "the forged proof is under the honest final vk");
+        match vd(&unpinned, &forged_claim, &forged) {
+            Ok(()) => println!("E2E_VD_FORGERY_ACCEPTED by V_d without the program check (gap G1): a false claim (final gas 1, post root 0x07..) verifies"),
+            Err(e) => panic!("forgery unexpectedly rejected without the program check: {e}"),
+        }
+        reject("forgery (program verifies nothing), program pinned", &pinned, &forged_claim, &forged);
+        save(&save_dir, "FORGED_FINAL", &forged);
+    }
+    // ---- a different chunk (chunk B: other contract constants, ctx and roots) ----
+    if env_usize("E2E_SECOND", 1) == 1 {
+        let fx_b = SliceBase::new("wrap");
+        let claim_b = fx_b.claim();
+        let (vk0b, p0b) = fx_b.keygen_and_prove(&base_engine);
+        assert_eq!(vk0b.pre_hash, vk0.pre_hash, "one base vk for both chunks");
+        println!("B_BASE_PROOF_BYTES {}", proof_sizes(&p0b));
+        let (_, fin_b, bound_b) = chain("B_", k, log_rows, &fixed, &engine, &final_engine, &vk0b, &p0b, &save_dir);
+        assert_eq!(fin_b.vk.pre_hash, pinned.vk_final.pre_hash, "one final vk for both chunks");
+        println!("E2E_G1 final programs of chunks A and B equal: {} (bound A={bound} B={bound_b})", fin_b.program == fin_a.program);
+        vd(&unpinned, &claim_b, &fin_b.proof).expect("V_d (unpinned) rejects the honest chunk B");
+        println!("E2E_VD_ACCEPT chunk B, program unpinned");
+        match vd(&pinned, &claim_b, &fin_b.proof) {
+            Ok(()) => println!("E2E_VD_ACCEPT chunk B with chunk A's pinned program"),
+            Err(e) => println!("E2E_VD_G1 honest chunk B rejected under chunk A's pinned program: {e}"),
+        }
+        reject("[unpinned] proof of chunk B against claim A", &unpinned, &claim_a, &fin_b.proof);
+        reject("[pinned] proof of chunk B against claim A", &pinned, &claim_a, &fin_b.proof);
+    }
+    println!("E2E_SLICE_DONE");
+}
