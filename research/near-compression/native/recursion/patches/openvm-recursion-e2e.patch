+/// L1 circuit (NV level 1 over the base proof): full constraint + bus debug check.
+/// FINDING G1 (recorded, not a desired property): the NV verifier program depends on the child
+/// proof, not only on its vk and shape.  T* samples by rejection (a 32-bit word is rejected with
+/// probability ~1/16), so the number of transcript blocks varies between proofs, and since B5
+/// squeeze / PoW-run job ids are program constants (and PoW-run blocks emit Unit1 rows).  Two
+/// base proofs of one vk (chunks A and B) give different L1 programs.  When G1 is fixed this test
+/// must be flipped to `assert_eq!`.
+#[test]
+fn e2e_finding_program_depends_on_proof() {
+    let (ba, _, _) = l1_program("positive");
+    let (bb, _, _) = l1_program("wrap");
+    assert_ne!(ba.instrs, bb.instrs, "G1 fixed? the L1 programs of chunks A and B are now equal");
+    let first = (0..ba.instrs.len().min(bb.instrs.len())).find(|&i| ba.instrs[i] != bb.instrs[i]).unwrap();
+    let ndiff = ba.instrs.iter().zip(&bb.instrs).filter(|(x, y)| x != y).count();
+    println!(
+        "E2E_G1 L1 programs differ: rows {} vs {}, first difference at row {first} ({:?} vs {:?}), {ndiff} differing rows in the common prefix",
+        ba.instrs.len(),
+        bb.instrs.len(),
+        ba.instrs[first],
+        bb.instrs[first]
+    );
+    // the cause is PoW: with every PoW at zero bits the two programs are identical (squeeze-block
+    // counts still differ, but only PoW-run blocks put the global block count into the program)
+    let mut p = base_params();
+    p.logup.pow_bits = 0;
+    p.whir.mu_pow_bits = 0;
+    p.whir.folding_pow_bits = 0;
+    p.whir.query_phase_pow_bits = 0;
+    let (za, _, _) = l1_program_with("positive", p.clone());
+    let (zb, _, _) = l1_program_with("wrap", p);
+    assert_eq!(za.instrs, zb.instrs, "without PoW the L1 programs of chunks A and B must agree");
+    println!("E2E_G1 without PoW: L1 programs of chunks A and B identical ({} rows)", za.instrs.len());
+}
