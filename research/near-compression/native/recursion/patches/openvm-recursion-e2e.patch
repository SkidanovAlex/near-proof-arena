+
+/// Maximum constraint degree of the base AIR set (measured by `e2e_base_shape`).
+pub const BASE_DEGREE: usize = 6;
+
+/// Base-layer parameters: `child_params_small` (test size) unless `BASE_N_STACK` is set, then
+/// `params_from_env("BASE", ..)` (all `BASE_*` knobs, levers, O-2).
+pub fn base_params() -> SystemParams {
+    let mut p = if std::env::var("BASE_N_STACK").is_ok() {
+        params_from_env("BASE", [8, 1, 20, 0])
+    } else {
+        child_params_small()
+    };
+    p.max_constraint_degree = env_usize("BASE_DEGREE", p.max_constraint_degree.max(BASE_DEGREE));
+    p
+}
+
+fn nv_params(prefix: &str) -> SystemParams {
+    let mut p = params_from_env(prefix, [16, 3, 20, 64]);
+    p.max_constraint_degree = NvCircuit::new(3, 16, 1).layout().degree().max(6);
+    p
+}
