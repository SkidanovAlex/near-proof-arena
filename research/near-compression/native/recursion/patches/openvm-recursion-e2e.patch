+// ---------------------------------------------------------------------------------------
+// Arbitrary NV programs (for the forgery test of a V_d without the program check)
+// ---------------------------------------------------------------------------------------
+
+/// Execute an arbitrary NV program (instead of the verifier) and generate every trace, as
+/// `NvCircuit::generate` does for the verifier program.
+pub fn generate_program(
+    circ: &super::circuit::NvCircuit,
+    f: impl FnOnce(&mut super::builder::Builder),
+) -> (Vec<RowMajorMatrix<F>>, super::builder::Builder) {
+    use super::{
+        hash::{byte_table2, generate2, Work2},
+        transcript2::{replay2, tr2_traces},
+        uair::nv_trace,
+    };
+    let mut b = super::builder::Builder::new(circ.log_rows, circ.reserved());
+    b.prog_log = circ.prog_log;
+    if let Some(app) = &circ.app {
+        b.emit_app(app.clone());
+    }
+    b.begin();
+    f(&mut b);
+    b.finish();
+    let log = b.transcript.clone().into_log();
+    let tr_jobs = replay2(&log);
+    let mut work = Work2 { jobs: b.jobs(), nodes: vec![] };
+    work.jobs.extend(tr_jobs.iter().map(|j| j.job()));
+    let sha = generate2(&work, circ.layout(), circ.heights.as_ref().map(|h| h[1]));
+    let tr = tr2_traces(&tr_jobs);
+    let mut counts = sha.byte_counts.clone();
+    for (c, t) in counts.iter_mut().zip(&tr.byte_counts) {
+        *c += t;
+    }
+    let nv = nv_trace(&b.instrs, &b.vals, &b.wits, &sha.glue_rows, &tr.hash, &tr.samp, &b.app, circ.log_rows, &mut counts);
+    (vec![nv, sha.compress, sha.table, byte_table2(&counts)], b)
+}
+
+/// The forger's program: verifies nothing, exposes `level` and the statement digest `d` of any
+/// claim it likes.  It satisfies every NV AIR constraint; only a pinned-program check (or the
+/// parent's binding) rejects it.
+pub fn forge_statement_program(level: u32, d: Digest) -> impl FnOnce(&mut super::builder::Builder) {
+    move |b| {
+        use super::builder::{digest_cells, ef_from, DigestCells};
+        let l = b.c(F::from_u32(level));
+        b.pv_level(l);
+        let (lo, hi) = digest_cells(d);
+        let lo = b.load(ef_from(lo));
+        let hi = b.load(ef_from(hi));
+        b.pv_digest(&DigestCells { lo, hi, digest: d });
+    }
+}
+
+/// Prove pre-generated NV traces (AIR 0 carries the builder's public values).
+pub fn prove_traces(
+    circ: &super::circuit::NvCircuit,
+    engine: &Sha384CpuEngine,
+    mats: Vec<RowMajorMatrix<F>>,
+    pvs: Vec<F>,
+) -> (MultiStarkVerifyingKey<SC>, Proof<SC>) {
+    use openvm_cpu_backend::CpuBackend;
+    use openvm_stark_backend::prover::DeviceDataTransporter;
+    let airs = circ.airs::<SC>();
+    let (pk, vk) = engine.keygen(&airs);
+    let ctxs: Vec<(usize, AirProvingContext<CpuBackend<SC>>)> = mats
+        .into_iter()
+        .enumerate()
+        .map(|(i, m)| (i, if i == 0 { AirProvingContext::simple(m, pvs.clone()) } else { AirProvingContext::simple_no_pis(m) }))
+        .collect();
+    let d_pk = engine.device().transport_pk_to_device(&pk);
+    let proof = engine.prove(&d_pk, ProvingContext::new(ctxs)).unwrap();
+    engine.verify(&vk, &proof).unwrap();
+    (vk, proof)
+}
+
+#[allow(dead_code)]
+fn _unused(x: F) -> u32 {
+    let _ = Field::is_zero(&x);
+    x.as_canonical_u32()
+}
