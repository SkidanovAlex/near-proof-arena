+/// Base AIR set against NV's envelope; base proof at the configured parameters.
+#[test]
+fn e2e_base_shape() {
+    let engine = Sha384CpuEngine::new(base_params());
+    describe("E2E_BASE", engine.params());
+    let fx = SliceBase::new("positive");
+    let airs = fx.airs();
+    let (_, vk) = engine.keygen(&airs);
+    for (a, avk) in airs.iter().zip(&vk.inner.per_air) {
