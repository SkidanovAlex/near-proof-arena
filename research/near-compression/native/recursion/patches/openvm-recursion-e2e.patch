+    let _ = std::fs::write("/proc/self/clear_refs", "5");
+    let t = std::time::Instant::now();
+    let circ = NvCircuit::new(vk0.inner.params.k_whir(), log_rows, 1);
+    if env_usize("E2E_PROBE_TRACES", 1) == 1 {
+        let (mats, b) = circ.generate(&vk0, &p0);
+        assert!(b.failures.is_empty(), "{:?}", b.failures);
+        let h: Vec<usize> = mats.iter().map(p3_matrix::Matrix::height).collect();
+        println!(
+            "L1_PROBE program_rows={} jobs={} merkle_nodes={} heights={h:?} gen_s={:.1} peak_rss_gb={:.2}",
+            b.instrs.len(),
+            b.job_units.len(),
+            b.merkle_nodes,
+            t.elapsed().as_secs_f64(),
+            hwm_gb()
+        );
+        assert!(check_statement(&b.public_values(), &fx.claim().public_values()));
+    } else {
+        let mut b = Builder::new(log_rows, circ.reserved());
+        b.prog_log = circ.prog_log;
+        b.begin();
+        build_verifier(&mut b, &vk0, &p0);
+        b.finish();
+        assert!(b.failures.is_empty(), "{:?}", b.failures);
+        println!("L1_PROBE program_rows={} jobs={} merkle_nodes={} gen_s={:.1}", b.instrs.len(), b.job_units.len(), b.merkle_nodes, t.elapsed().as_secs_f64());
+    }
+}
