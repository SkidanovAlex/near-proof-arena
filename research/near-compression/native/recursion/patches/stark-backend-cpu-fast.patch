+    fn rows_packed(&self, row_indices: &[usize]) -> Vec<Vec<V>> {
+        type P<F> = <F as p3_field::Field>::Packing;
+        let wl = <P<F> as PackedValue>::WIDTH;
+        let d = V::DIMENSION;
+        let ncols = self.coeffs.len();
