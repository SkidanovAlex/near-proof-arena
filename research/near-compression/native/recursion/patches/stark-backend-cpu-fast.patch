+impl<F, V> PolyOracle<F, V>
+where
+    F: TwoAdicField + PrimeField64,
+    V: ExtensionField<F>,
+{
+    /// Rows of whole leaves: each group of `g` rows lies on a coset `x0 <zeta>` (zeta of order
+    /// g), so f(x0 zeta^t) = sum_j zeta^(tj) x0^j H_j(x0^g) with H_j(Y) = sum_m c_(gm+j) Y^m: one
+    /// pass over the coefficients per leaf instead of one per row. 16 leaves per vector.
+    /// Returns None if the indices do not have that structure.
+    fn rows_cosets(&self, row_indices: &[usize], g: usize) -> Option<Vec<Vec<V>>> {
+        type P<F> = <F as p3_field::Field>::Packing;
+        let wl = <P<F> as PackedValue>::WIDTH;
