+                }
+                // base-field columns: 8 independent Horner chains over coefficient segments
+                // (one chain is latency-bound), combined as sum_s acc_s * x^(s*m)
+                fn horner_seg<F: p3_field::Field, V: ExtensionField<F>>(c: &[V], x: P<F>) -> Vec<P<F>> {
+                    const S: usize = 8;
+                    let m = c.len().div_ceil(S);
+                    if m < 64 {
