+                fn horner<F: p3_field::Field, V: ExtensionField<F>, const N: usize>(
+                    c: &[V],
+                    x: P<F>,
+                ) -> Vec<P<F>> {
+                    let mut acc = [P::<F>::ZERO; N];
+                    for v in c.iter().rev() {
+                        let vc = v.as_basis_coefficients_slice();
+                        for j in 0..N {
+                            acc[j] = acc[j] * x + vc[j];
+                        }
+                    }
