+/// [pq-cpu-prover] One Merkle level: `compress(prev[2i], prev[2i+1])`, batched through
+/// `MerkleHasher::compress_pairs` (identical to the pairwise loop).
+pub fn compress_layer<H: crate::hasher::MerkleHasher>(hasher: &H, prev: &[H::Digest]) -> Vec<H::Digest> {
