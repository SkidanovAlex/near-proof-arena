+                    1 => horner_seg::<F, V>(c, x),
+                    4 => horner::<F, V, 4>(c, x),
+                    12 => horner::<F, V, 12>(c, x),
+                    _ => {
+                        let mut acc = vec![P::<F>::ZERO; d];
+                        for v in c.iter().rev() {
+                            let vc = v.as_basis_coefficients_slice();
+                            for j in 0..d {
+                                acc[j] = acc[j] * x + vc[j];
+                            }
+                        }
+                        acc
+                    }
+                }
+            })
+            .collect();
+        let mut out = vec![vec![V::ZERO; ncols]; row_indices.len()];
+        for (task, acc) in vals.iter().enumerate() {
+            let (ch, col) = (task / ncols, task % ncols);
+            for l in 0..wl {
+                let r = ch * wl + l;
+                if r < row_indices.len() {
+                    out[r][col] = V::from_basis_coefficients_fn(|j| acc[j].as_slice()[l]);
+                }
+            }
+        }
+        out
+    }
