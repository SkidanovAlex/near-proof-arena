+                    }
+                    let mut acc = [P::<F>::ZERO; S];
+                    for i in (0..m).rev() {
+                        for s in 0..S {
+                            let v = c.get(s * m + i).map_or(F::ZERO, |v| v.as_basis_coefficients_slice()[0]);
+                            acc[s] = acc[s] * x + v;
+                        }
+                    }
