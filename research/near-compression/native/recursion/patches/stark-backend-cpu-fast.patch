+#[allow(dead_code)]
+fn leaf_batch_rows<F: p3_field::Field, EF: p3_field::ExtensionField<F>>(
+    matrix: &ColMajorMatrix<EF>,
+    leaves: std::ops::Range<usize>,
+    rows_per_query: usize,
+    row_of: impl Fn(usize, usize) -> usize,
+) -> Vec<Vec<Vec<F>>> {
+    let w = matrix.width();
+    let h = matrix.height();
+    let d = EF::DIMENSION;
+    let nl = leaves.len();
+    let mut out: Vec<Vec<Vec<F>>> = vec![vec![vec![F::ZERO; w * d]; rows_per_query]; nl];
+    for c in 0..w {
+        let col = &matrix.values[c * h..(c + 1) * h];
+        for (li, leaf) in leaves.clone().enumerate() {
+            for t in 0..rows_per_query {
+                let r = row_of(leaf, t);
+                if r < h {
+                    out[li][t][c * d..(c + 1) * d].copy_from_slice(col[r].as_basis_coefficients_slice());
+                }
+            }
+        }
+    }
+    out
+}
