+        let b = 2 * crate::hasher::HASH_BATCH;
+        prev.par_chunks(b).flat_map_iter(|ch| hasher.compress_pairs(&ch[..ch.len() / 2 * 2])).collect()
+    } else {
+        prev.par_chunks_exact(2).map(|pair| hasher.compress(pair[0], pair[1])).collect()
+    }
