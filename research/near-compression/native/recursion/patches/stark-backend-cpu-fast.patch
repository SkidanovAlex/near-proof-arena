+        let mut x0s = Vec::with_capacity(ngroups);
+        let mut zeta = None;
+        for grp in row_indices.chunks_exact(g) {
+            let x0 = self.point(grp[0]);
+            let z = self.point(grp[1]) * x0.inverse();
+            if *zeta.get_or_insert(z) != z {
+                return None;
+            }
+            let mut x = x0;
+            for &r in grp {
+                if self.point(r) != x {
