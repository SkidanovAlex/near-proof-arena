+    /// SIMD). Must equal the one-by-one result.
+    fn hash_coset_batch(&self, leaves: &[Vec<Vec<Self::F>>]) -> Vec<Self::Digest> {
+        leaves.iter().map(|rows| self.hash_coset(rows)).collect()
+    }
+
+    /// [pq-cpu-prover] `hash_coset` of `data.len() / (rows_per_leaf * row_len)` leaves stored
+    /// flat (`[leaf][row][col]`); configs may hash straight from the buffer.
+    fn hash_leaves_flat(&self, data: &[Self::F], row_len: usize, rows_per_leaf: usize) -> Vec<Self::Digest> {
+        let per = row_len * rows_per_leaf;
+        let leaves: Vec<Vec<Vec<Self::F>>> = data
+            .chunks_exact(per.max(1))
+            .map(|leaf| leaf.chunks_exact(row_len.max(1)).map(|r| r.to_vec()).collect())
+            .collect();
+        self.hash_coset_batch(&leaves)
+    }
+
+    /// [pq-cpu-prover] `out[i] = compress(inputs[2i], inputs[2i+1])`; configs may batch it.
+    fn compress_pairs(&self, inputs: &[Self::Digest]) -> Vec<Self::Digest> {
+        inputs.chunks_exact(2).map(|p| self.compress(p[0], p[1])).collect()
+    }
