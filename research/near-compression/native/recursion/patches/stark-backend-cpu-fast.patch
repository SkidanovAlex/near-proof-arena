+//! [pq-cpu-prover] Fractional-sum GKR (LogUp) prover, byte-identical to
+//! `fractional_sumcheck_with`.
+//!
+//! Differences from the original, none of which changes a transcript value:
+//! * **No materialised input layer.** The LogUp input (numerators in the base field) is
+//!   generated chunk by chunk from the traces whenever it is needed: to build the first tree
+//!   level, and for the two passes (sums, then fold) of the input layer's first sumcheck round.
+//!   The largest stored tree level (2^(L-1) fractions) is dropped after the next level is built
+//!   and regenerated for its own layer. The original keeps a 2^(L+1)-entry segment tree, a copy
+//!   of the input and per-layer column copies.
+//! * **Gruen eq split.** `s(X) = A · eq(ξ_i, X) · t(X)` with `t(X) = Σ_y eq(ξ_{>i}, y) g(X, y)`
+//!   of degree 2: per pair only `t(1), t(2)` are evaluated; `t(0)` follows from the round claim,
+//!   `t(3)` by quadratic extrapolation (if `ξ_i = 1` or `A = 0`, `t(0)` is evaluated directly).
+//!   No eq column is interpolated or folded; eq tables are sqrt-split.
+//! * **Fused fold and next round:** one pass per sumcheck round.
+//! * Interpolation at X = 2 uses additions; all Ext12 arithmetic runs 16 pairs at a time in
+//!   packed SoA form.
+
+use openvm_stark_backend::{
+    proof::GkrLayerClaims,
+    prover::{error::LogupZerocheckError, fractional_sumcheck_gkr::FracSumcheckProof},
+    FiatShamirTranscript, StarkProtocolConfig,
+};
+use p3_field::{ExtensionField, Field, PackedField, PackedValue, PrimeCharacteristicRing};
+use p3_maybe_rayon::prelude::*;
+
+use super::pext::{coeffs, from_coeffs, PreMul, PE};
+
+/// The LogUp input layer as a generator: `fill(start, p, q)` writes positions
+/// `[start, start + p.len())` (numerators in the base field, `q` including `alpha`).
+pub trait InputSource<F, EF>: Sync {
+    fn n(&self) -> usize;
+    fn fill(&self, start: usize, p: &mut [F], q: &mut [EF]);
+    /// Visit `[0, n)` as disjoint runs `f(start, p, q)`, each of length >= `min_run` and aligned
+    /// to `min_run`, in any order and possibly in parallel; results are combined with `add`.
+    fn visit_runs<R: Send, Fv, Z, A>(&self, min_run: usize, f: Fv, zero: Z, add: A) -> R
+    where
+        F: Field,
+        EF: Field,
+        Fv: Fn(usize, &[F], &[EF]) -> R + Sync,
+        Z: Fn() -> R + Sync,
+        A: Fn(R, R) -> R + Sync,
+    {
+        let n = self.n();
+        let ch = CHUNK.min(n).max(min_run);
+        let mut p = vec![F::ZERO; ch];
+        let mut q = vec![EF::ZERO; ch];
+        let mut acc = zero();
+        for start in (0..n).step_by(ch) {
+            self.fill(start, &mut p, &mut q);
+            acc = add(acc, f(start, &p, &q));
+        }
+        acc
+    }
+}
+
+/// Positions generated per chunk.
+const CHUNK: usize = 1 << 20;
+
+#[derive(Clone, Copy, Default)]
+struct FracE<EF> {
+    p: EF,
+    q: EF,
+}
+
+#[inline(always)]
+fn gather<F: Field, EF: ExtensionField<F>, Q: PackedField<Scalar = F>>(f: impl Fn(usize) -> EF) -> PE<Q> {
+    let mut vals = [EF::ZERO; 16];
+    for (l, v) in vals.iter_mut().enumerate().take(Q::WIDTH) {
+        *v = f(l);
+    }
+    PE(core::array::from_fn(|j| Q::from_fn(|l| coeffs::<F, EF>(&vals[l])[j])))
+}
+
+#[inline(always)]
+fn scatter<F: Field, EF: ExtensionField<F>, Q: PackedField<Scalar = F>>(v: &PE<Q>, mut f: impl FnMut(usize, EF)) {
+    for l in 0..Q::WIDTH {
+        f(l, from_coeffs::<F, EF>(&v.lane(l)));
+    }
+}
+
+#[inline(always)]
+fn lanes<F: Field>() -> usize {
+    <F::Packing as PackedValue>::WIDTH
+}
+
+/// out[x] = in[2x] + in[2x+1] (Frac add: p = a.p b.q + a.q b.p, q = a.q b.q) from input buffers.
+fn level_from_input_chunk<F: Field, EF: ExtensionField<F>>(p: &[F], q: &[EF], out: &mut [FracE<EF>], w: F) {
+    let n = out.len();
+    let wl = lanes::<F>();
+    if n >= wl && n % wl == 0 {
+        out.par_chunks_mut(wl).enumerate().for_each(|(b, o)| {
+            let x0 = b * wl;
+            let q0: PE<F::Packing> = gather(|l| q[2 * (x0 + l)]);
+            let q1: PE<F::Packing> = gather(|l| q[2 * (x0 + l) + 1]);
+            let p0 = F::Packing::from_fn(|l| p[2 * (x0 + l)]);
+            let p1 = F::Packing::from_fn(|l| p[2 * (x0 + l) + 1]);
+            let pp = q1.mul_base(p0).add(&q0.mul_base(p1));
+            let qq = q0.mul(&q1, w);
+            scatter(&pp, |l, v: EF| o[l].p = v);
+            scatter(&qq, |l, v: EF| o[l].q = v);
+        });
+    } else {
+        for x in 0..n {
+            out[x] = FracE { p: q[2 * x + 1] * p[2 * x] + q[2 * x] * p[2 * x + 1], q: q[2 * x] * q[2 * x + 1] };
+        }
+    }
+}
+
+fn level_from_input<F: Field, EF: ExtensionField<F>, S: InputSource<F, EF>>(src: &S, w: F) -> Vec<FracE<EF>> {
+    let n = src.n();
+    let mut out = vec![FracE::<EF>::default(); n / 2];
+    let ch = CHUNK.min(n);
+    let mut p = vec![F::ZERO; ch];
+    let mut q = vec![EF::ZERO; ch];
+    for start in (0..n).step_by(ch) {
+        src.fill(start, &mut p, &mut q);
+        level_from_input_chunk(&p, &q, &mut out[start / 2..(start + ch) / 2], w);
+    }
+    out
+}
+
+fn level_up<F: Field, EF: ExtensionField<F>>(lay: &[FracE<EF>], w: F) -> Vec<FracE<EF>> {
+    let n = lay.len() / 2;
+    let mut out = vec![FracE::<EF>::default(); n];
+    let wl = lanes::<F>();
+    if n >= wl && n % wl == 0 {
+        out.par_chunks_mut(wl).enumerate().for_each(|(b, o)| {
+            let x0 = b * wl;
+            let p0: PE<F::Packing> = gather(|l| lay[2 * (x0 + l)].p);
+            let q0: PE<F::Packing> = gather(|l| lay[2 * (x0 + l)].q);
+            let p1: PE<F::Packing> = gather(|l| lay[2 * (x0 + l) + 1].p);
+            let q1: PE<F::Packing> = gather(|l| lay[2 * (x0 + l) + 1].q);
+            let pp = p0.mul(&q1, w).add(&q0.mul(&p1, w));
+            let qq = q0.mul(&q1, w);
+            scatter(&pp, |l, v: EF| o[l].p = v);
+            scatter(&qq, |l, v: EF| o[l].q = v);
+        });
+    } else {
+        for x in 0..n {
+            let (a, b) = (lay[2 * x], lay[2 * x + 1]);
+            out[x] = FracE { p: a.p * b.q + a.q * b.p, q: a.q * b.q };
+        }
+    }
+    out
+}
+
+/// eq(ξ, y) for y over `xi.len()` bits, bit k <-> xi[k].
+fn eq_table<EF: Field>(xi: &[EF]) -> Vec<EF> {
+    let mut out = vec![EF::ZERO; 1 << xi.len()];
+    out[0] = EF::ONE;
+    for (i, &x) in xi.iter().enumerate() {
+        let (lo, hi) = out[..2 << i].split_at_mut(1 << i);
+        for (l, h) in lo.iter_mut().zip(hi.iter_mut()) {
+            *h = *l * x;
+            *l *= EF::ONE - x;
+        }
+    }
+    out
+}
+
+/// Split eq table: E(y) = lo[y mod 2^h] * hi[y >> h].
+struct SplitEq<EF> {
+    h: usize,
+    lo: Vec<EF>,
+    hi: Vec<EF>,
+}
+
+impl<EF: Field> SplitEq<EF> {
+    fn new(xi: &[EF]) -> Self {
+        let h = xi.len().div_ceil(2);
+        Self { h, lo: eq_table(&xi[..h]), hi: eq_table(&xi[h..]) }
+    }
+    #[inline(always)]
+    fn get(&self, y: usize) -> EF {
+        self.lo[y & ((1 << self.h) - 1)] * self.hi[y >> self.h]
+    }
+}
+
+/// A packed value of a numerator column: base-field (input layer) or extension.
+#[derive(Clone, Copy)]
+enum PVal<Q: PackedField> {
+    B(Q),
+    E(PE<Q>),
+}
+
+impl<Q: PackedField> PVal<Q> {
+    #[inline(always)]
+    fn mul_e(&self, q: &PE<Q>, w: Q::Scalar) -> PE<Q> {
+        match self {
+            PVal::B(b) => q.mul_base(*b),
+            PVal::E(e) => e.mul(q, w),
+        }
+    }
+    /// value at X = 2: 2 hi - lo
+    #[inline(always)]
+    fn at2(lo: &Self, hi: &Self) -> Self {
+        match (lo, hi) {
+            (PVal::B(a), PVal::B(b)) => PVal::B(b.double() - *a),
+            (PVal::E(a), PVal::E(b)) => PVal::E(b.add(b).sub(a)),
+            _ => unreachable!(),
+        }
+    }
+    #[inline(always)]
+    fn to_pe(&self) -> PE<Q> {
+        match self {
+            PVal::B(b) => {
+                let mut r = PE::zero();
+                r.0[0] = *b;
+                r
+            }
+            PVal::E(e) => *e,
+        }
+    }
+}
+
+/// x-entries (p0, q0, p1, q1) of a sumcheck table.
+#[derive(Clone, Copy)]
+enum Tab<'a, F, EF> {
+    /// a chunk of the input layer: x-entry x = positions (2x, 2x+1)
+    Input(&'a [F], &'a [EF]),
+    /// a stored layer: x-entry x = (lay[2x], lay[2x+1])
+    Layer(&'a [FracE<EF>]),
+    /// folded table
+    Folded(&'a [[EF; 4]]),
+}
+
+impl<F: Field, EF: ExtensionField<F>> Tab<'_, F, EF> {
+    fn len(&self) -> usize {
+        match self {
+            Tab::Input(p, _) => p.len() / 2,
+            Tab::Layer(l) => l.len() / 2,
+            Tab::Folded(f) => f.len(),
+        }
+    }
+    #[inline(always)]
+    fn load<Q: PackedField<Scalar = F>>(&self, x_of: impl Fn(usize) -> usize) -> [PVal<Q>; 4] {
+        match self {
+            Tab::Input(p, q) => [
+                PVal::B(Q::from_fn(|l| p[2 * x_of(l)])),
+                PVal::E(gather(|l| q[2 * x_of(l)])),
+                PVal::B(Q::from_fn(|l| p[2 * x_of(l) + 1])),
+                PVal::E(gather(|l| q[2 * x_of(l) + 1])),
+            ],
+            Tab::Layer(lay) => [
+                PVal::E(gather(|l| lay[2 * x_of(l)].p)),
+                PVal::E(gather(|l| lay[2 * x_of(l)].q)),
+                PVal::E(gather(|l| lay[2 * x_of(l) + 1].p)),
+                PVal::E(gather(|l| lay[2 * x_of(l) + 1].q)),
+            ],
+            Tab::Folded(f) => core::array::from_fn(|c| PVal::E(gather(|l| f[x_of(l)][c]))),
+        }
+    }
+}
+
+/// `[x][k]`: Σ_y E(y)·pp(x, y) (k = 0) and Σ_y E(y)·qq(x, y) (k = 1) for x in {0, 1, 2}.
+type Sums<EF> = [[EF; 2]; 3];
+
+#[inline(always)]
+fn pair_terms<Q: PackedField>(lo: &[PVal<Q>; 4], hi: &[PVal<Q>; 4], x: usize, w: Q::Scalar) -> (PE<Q>, PE<Q>) {
+    let v: [PVal<Q>; 4] = match x {
+        0 => *lo,
+        1 => *hi,
+        _ => core::array::from_fn(|c| PVal::at2(&lo[c], &hi[c])),
+    };
+    let q0 = v[1].to_pe();
+    let q1 = v[3].to_pe();
+    let pp = v[0].mul_e(&q1, w).add(&v[2].mul_e(&q0, w));
+    let qq = q0.mul(&q1, w);
+    (pp, qq)
+}
+
+struct SyncPtr<T>(*mut T);
+unsafe impl<T> Send for SyncPtr<T> {}
+unsafe impl<T> Sync for SyncPtr<T> {}
+impl<T> SyncPtr<T> {
+    #[inline(always)]
+    fn get(&self) -> *mut T {
+        self.0
+    }
+}
+
+/// One pass over the table `tab`. With `r = Some(r)` the x-entries are first folded at `r`
+/// (T'[y'] = T[2y'] + r (T[2y'+1] - T[2y']), written to `out[y']`) and the sums run over pairs of
+/// the folded table; with `None` over pairs of `tab`. `eq.get(pair_base + local pair)` is E.
+fn pass<F: Field, EF: ExtensionField<F>>(
+    tab: Tab<'_, F, EF>,
+    r: Option<EF>,
+    out: Option<&mut [[EF; 4]]>,
+    eq: &SplitEq<EF>,
+    pair_base: usize,
+    points: &[usize],
+    w: F,
+) -> Sums<EF> {
+    let len = tab.len();
+    if let (Some(r), 2) = (r, len) {
+        // final fold of a layer: one output entry, no pairs left
+        debug_assert!(points.is_empty());
+        let lo = tab.load::<F>(|_| 0);
+        let hi = tab.load::<F>(|_| 1);
+        let out = out.expect("fold output");
+        for c in 0..4 {
+            let a: EF = from_coeffs::<F, EF>(&lo[c].to_pe().lane(0));
+            let b: EF = from_coeffs::<F, EF>(&hi[c].to_pe().lane(0));
+            out[0][c] = a + (b - a) * r;
+        }
+        return zero_sums();
+    }
+    let (npairs, step) = if r.is_some() { (len / 4, 4) } else { (len / 2, 2) };
+    #[allow(clippy::too_many_arguments)]
+    fn run<F: Field, EF: ExtensionField<F>, Q: PackedField<Scalar = F>>(
+        tab: Tab<'_, F, EF>,
+        r: Option<EF>,
+        out: Option<&mut [[EF; 4]]>,
+        eq: &SplitEq<EF>,
+        pair_base: usize,
+        points: &[usize],
+        w: F,
+        nblk: usize,
+        step: usize,
+    ) -> Sums<EF> {
+        let wl = Q::WIDTH;
+        let rp = r.map(|r| PreMul::<Q>::new(coeffs::<F, EF>(&r), w));
+        let outp = out.map(|o| SyncPtr(o.as_mut_ptr()));
+        let body = |mut acc: [PE<Q>; 6], b: usize| {
+            let y0 = b * wl;
+            let (lo, hi) = match &rp {
+                None => (tab.load::<Q>(|l| step * (y0 + l)), tab.load::<Q>(|l| step * (y0 + l) + 1)),
+                Some(rp) => {
+                    let t: [[PVal<Q>; 4]; 4] = core::array::from_fn(|k| tab.load::<Q>(|l| step * (y0 + l) + k));
+                    let fold = |a: &[PVal<Q>; 4], b: &[PVal<Q>; 4]| -> [PVal<Q>; 4] {
+                        core::array::from_fn(|c| {
+                            let (x, z) = (a[c].to_pe(), b[c].to_pe());
+                            PVal::E(x.add(&rp.mul(&z.sub(&x))))
+                        })
+                    };
+                    let f0 = fold(&t[0], &t[1]);
+                    let f1 = fold(&t[2], &t[3]);
+                    if let Some(op) = &outp {
+                        for c in 0..4 {
+                            let (PVal::E(a), PVal::E(bv)) = (f0[c], f1[c]) else { unreachable!() };
+                            // SAFETY: each block writes its own output entries 2(y0+l), 2(y0+l)+1
+                            scatter(&a, |l, v: EF| unsafe { (*op.get().add(2 * (y0 + l)))[c] = v });
+                            scatter(&bv, |l, v: EF| unsafe { (*op.get().add(2 * (y0 + l) + 1))[c] = v });
+                        }
+                    }
+                    (f0, f1)
+                }
+            };
+            if !points.is_empty() {
+                let ev: PE<Q> = gather(|l| eq.get(pair_base + y0 + l));
+                for &x in points {
+                    let (pp, qq) = pair_terms(&lo, &hi, x, w);
+                    acc[2 * x].add_assign(&ev.mul(&pp, w));
+                    acc[2 * x + 1].add_assign(&ev.mul(&qq, w));
+                }
+            }
+            acc
+        };
+        let acc = (0..nblk)
+            .into_par_iter()
+            .with_min_len(64)
+            .fold(|| [PE::<Q>::zero(); 6], body)
+            .reduce(
+                || [PE::<Q>::zero(); 6],
+                |mut a, b| {
+                    for i in 0..6 {
+                        a[i].add_assign(&b[i]);
+                    }
+                    a
+                },
+            );
+        core::array::from_fn(|x| core::array::from_fn(|k| from_coeffs::<F, EF>(&acc[2 * x + k].hsum())))
+    }
+    let wl = lanes::<F>();
+    if npairs >= wl && npairs % wl == 0 {
+        run::<F, EF, F::Packing>(tab, r, out, eq, pair_base, points, w, npairs / wl, step)
+    } else {
+        run::<F, EF, F>(tab, r, out, eq, pair_base, points, w, npairs, step)
+    }
+}
+
+#[inline(always)]
+fn eq1<EF: Field>(xi: EF, x: EF) -> EF {
+    (EF::ONE - xi) * (EF::ONE - x) + xi * x
+}
+
+/// Cubic through (0, s0), .., (3, s3), evaluated at r.
+fn cubic_at<EF: Field>(s: [EF; 4], r: EF) -> EF {
+    let one = EF::ONE;
+    let two = one.double();
+    let three = two + one;
+    let (r0, r1, r2, r3) = (r, r - one, r - two, r - three);
+    let six_inv = EF::from_u32(6).inverse();
+    let two_inv = two.inverse();
+    let l0 = -(r1 * r2 * r3) * six_inv;
+    let l1 = r0 * r2 * r3 * two_inv;
+    let l2 = -(r0 * r1 * r3) * two_inv;
+    let l3 = r0 * r1 * r2 * six_inv;
+    s[0] * l0 + s[1] * l1 + s[2] * l2 + s[3] * l3
+}
+
+/// Claim and accumulated eq prefix `A = Π eq(ξ_k, r_k)` of the running sumcheck.
+struct Round<EF> {
+    claim: EF,
+    a: EF,
+}
+
+impl<EF: Field> Round<EF> {
+    fn direct(&self, xi: EF) -> bool {
+        xi == EF::ONE || self.a == EF::ZERO
+    }
+    fn points(&self, xi: EF) -> &'static [usize] {
+        if self.direct(xi) || check_mode() {
+            &[0, 1, 2]
+        } else {
+            &[1, 2]
+        }
+    }
+    /// s(0), .., s(3) from the sums.
+    fn evals(&self, sums: &Sums<EF>, lambda: EF, xi: EF) -> [EF; 4] {
+        let t = |x: usize| sums[x][0] + lambda * sums[x][1];
+        let (t1, t2) = (t(1), t(2));
+        let t0 = if self.direct(xi) {
+            t(0)
+        } else {
+            (self.claim * self.a.inverse() - xi * t1) * (EF::ONE - xi).inverse()
+        };
+        if check_mode() && !self.direct(xi) {
+            assert_eq!(t0, t(0), "GKR claim-derived t(0) differs from the direct sum at {:?}", DBG.lock().unwrap());
+        }
+        let t3 = t0 - t1.double() - t1 + t2.double() + t2;
+        let ts = [t0, t1, t2, t3];
+        core::array::from_fn(|k| self.a * eq1(xi, EF::from_usize(k)) * ts[k])
+    }
+}
+
+/// `NEARPROOF_GKR_CHECK=1`: also evaluate t(0) directly and assert it equals the claim-derived one.
+fn check_mode() -> bool {
+    use std::sync::OnceLock;
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("NEARPROOF_GKR_CHECK").map(|v| v == "1").unwrap_or(false))
+}
+
+static DBG: std::sync::Mutex<(usize, usize, usize)> = std::sync::Mutex::new((0, 0, 0));
+
+fn add_sums<EF: Field>(a: &mut Sums<EF>, b: &Sums<EF>) {
+    for x in 0..3 {
+        for k in 0..2 {
+            a[x][k] += b[x][k];
+        }
+    }
+}
+
+fn zero_sums<EF: Field>() -> Sums<EF> {
+    [[EF::ZERO; 2]; 3]
+}
+
+/// Largest stored tree level / materialised fold table, log2 entries (`NEARPROOF_GKR_CAP_LOG`,
+/// default 24): bigger levels are streamed from the input generator.
+fn cap_log() -> usize {
+    std::env::var("NEARPROOF_GKR_CAP_LOG").ok().and_then(|v| v.parse().ok()).unwrap_or(24)
+}
+
+#[allow(dead_code)]
+/// Entries `[e0, e0 + out.len())` of tree level `level` (2^level entries; `total` = the input),
+/// generated from the input. `p`, `q` are scratch buffers of `out.len() << (total - level)`.
+fn gen_level_chunk<F: Field, EF: ExtensionField<F>, S: InputSource<F, EF>>(
+    src: &S,
+    total: usize,
+    level: usize,
+    e0: usize,
+    p: &mut [F],
+    q: &mut [EF],
+    w: F,
+) -> Vec<FracE<EF>> {
+    let sh = total - level;
+    debug_assert!(sh >= 1);
+    src.fill(e0 << sh, p, q);
+    let mut cur = vec![FracE::<EF>::default(); p.len() / 2];
+    level_from_input_chunk(p, q, &mut cur, w);
+    for _ in 1..sh {
+        cur = level_up(&cur, w);
+    }
+    cur
+}
+
+/// Level entries of a run of input positions, combining `sh >= 1` times.
+fn level_of_run<F: Field, EF: ExtensionField<F>>(p: &[F], q: &[EF], sh: usize, w: F) -> Vec<FracE<EF>> {
+    let mut cur = vec![FracE::<EF>::default(); p.len() / 2];
+    level_from_input_chunk(p, q, &mut cur, w);
+    for _ in 1..sh {
+        cur = level_up(&cur, w);
+    }
+    cur
+}
+
+/// Folds of a chunk of x-entries by `rs` in order (the same arithmetic as the stored-table folds).
+fn fold_chunk<F: Field, EF: ExtensionField<F>>(tab: Tab<'_, F, EF>, rs: &[EF], w: F) -> Vec<[EF; 4]> {
+    let mut cur: Option<Vec<[EF; 4]>> = None;
+    for &r in rs {
+        let src = match &cur {
+            None => tab,
+            Some(v) => Tab::Folded(v),
+        };
+        let n = src.len() / 2;
+        let mut out = vec![[EF::ZERO; 4]; n];
+        if n == 1 {
+            pass(src, Some(r), Some(&mut out), &SplitEq::new(&[]), 0, &[], w);
+        } else {
+            // fold only: pairs of the output are not summed (no points)
+            pass(src, Some(r), Some(&mut out), &SplitEq::new(&[]), 0, &[], w);
+        }
+        cur = Some(out);
+    }
+    cur.expect("at least one fold")
+}
+
+/// Byte-identical replacement of `fractional_sumcheck_with` for a LogUp input generator with at
+/// least 8 positions.
+#[tracing::instrument(level = "info", skip_all)]
+pub fn fractional_sumcheck_fast<SC: StarkProtocolConfig, TS: FiatShamirTranscript<SC>, S: InputSource<SC::F, SC::EF>>(
+    transcript: &mut TS,
+    src: &S,
+    assert_zero: bool,
+    gruen: bool,
+    w: SC::F,
+) -> Result<(FracSumcheckProof<SC>, Vec<SC::EF>), LogupZerocheckError> {
+    type EF<SC> = <SC as StarkProtocolConfig>::EF;
+    let n_in = src.n();
+    let total_rounds = p3_util::log2_strict_usize(n_in);
+    assert!(total_rounds >= 3, "tiny GKR handled by the original code");
+    let cap = cap_log().max(2);
+    // stored levels: 2^k entries for k <= top_stored; bigger levels (and the input) are streamed
+    let top_stored = cap.min(total_rounds - 1);
+    let mut layers: Vec<Vec<FracE<EF<SC>>>> = vec![vec![]; total_rounds];
+    {
+        // build level top_stored from runs of the input
+        let sh = total_rounds - top_stored;
+        let mut lev = vec![FracE::<EF<SC>>::default(); 1 << top_stored];
+        let lp = SyncPtr(lev.as_mut_ptr());
+        src.visit_runs(
+            1 << sh,
+            |start, p, q| {
+                let v = level_of_run(p, q, sh, w);
+                // SAFETY: runs are disjoint, so their level entries are
+                unsafe { std::ptr::copy_nonoverlapping(v.as_ptr(), lp.get().add(start >> sh), v.len()) };
+            },
+            || (),
+            |_, _| (),
+        );
+        layers[top_stored] = lev;
+    }
+    for k in (0..top_stored).rev() {
+        layers[k] = level_up(&layers[k + 1], w);
+    }
+    openvm_stark_backend::prover::stream_pcs::memprof("gkr.layers_built");
+    let fill_report = || {
+        if std::env::var("NEARPROOF_MEMPROF").map(|v| v == "1").unwrap_or(false) {
+            println!("GKR_FILL total_wall_s={:.2}", FILL_NS.load(std::sync::atomic::Ordering::Relaxed) as f64 * 1e-9);
+        }
+    };
+    let frac_sum = layers[0][0];
+    if assert_zero {
+        if frac_sum.p != EF::<SC>::ZERO {
+            return Err(LogupZerocheckError::NonZeroRootSum);
+        }
+    } else {
+        transcript.observe_ext(frac_sum.p);
+    }
+    transcript.observe_ext(frac_sum.q);
+
+    let mut claims_per_layer: Vec<GkrLayerClaims<SC>> = Vec::with_capacity(total_rounds);
+    let mut sumcheck_polys: Vec<Vec<[EF<SC>; 3]>> = Vec::with_capacity(total_rounds);
+    let l1 = std::mem::take(&mut layers[1]);
+    claims_per_layer.push(GkrLayerClaims::<SC> { p_xi_0: l1[0].p, q_xi_0: l1[0].q, p_xi_1: l1[1].p, q_xi_1: l1[1].q });
+    drop(l1);
+    layers[0] = vec![];
+    {
+        let c = &claims_per_layer[0];
+        for v in [c.p_xi_0, c.q_xi_0, c.p_xi_1, c.q_xi_1] {
+            transcript.observe_ext(v);
+        }
+    }
+    let mu_1 = transcript.sample_ext();
+    let mut xi_prev = vec![mu_1];
+
+    for round in 1..total_rounds {
+        let lambda = transcript.sample_ext();
+        let n = round;
+        let seg_layer = round + 1;
+        let mu = xi_prev[0];
+        let mut st = {
+            let prev = &claims_per_layer[round - 1];
+            Round {
+                claim: (EF::<SC>::ONE - mu) * (prev.p_xi_0 + lambda * prev.q_xi_0)
+                    + mu * (prev.p_xi_1 + lambda * prev.q_xi_1),
+                a: EF::<SC>::ONE,
+            }
+        };
+        let mut round_polys_eval: Vec<[EF<SC>; 3]> = Vec::with_capacity(n);
+        let mut r_vec: Vec<EF<SC>> = Vec::with_capacity(n);
+        let emit = |st: &mut Round<EF<SC>>,
+                    sums: &Sums<EF<SC>>,
+                    xi: EF<SC>,
+                    transcript: &mut TS,
+                    round_polys_eval: &mut Vec<[EF<SC>; 3]>|
+         -> EF<SC> {
+            if check_mode() {
+                *DBG.lock().unwrap() = (round, round_polys_eval.len(), total_rounds);
+            }
+            let s = st.evals(sums, lambda, xi);
+            let mut s_evals = [s[1], s[2], s[3]];
+            if gruen {
+                s_evals[2] = EF::<SC>::ZERO;
+            }
+            for &eval in &s_evals[..if gruen { 2 } else { 3 }] {
+                transcript.observe_ext(eval);
+            }
+            round_polys_eval.push(s_evals);
+            let r = transcript.sample_ext();
+            st.claim = cubic_at(s, r);
+            st.a *= eq1(xi, r);
+            r
+        };
+        // sums for sumcheck round `sr` (pairs of the table after sr folds) need E and points
+        let round_setup = |st: &Round<EF<SC>>, sr: usize| -> (SplitEq<EF<SC>>, &'static [usize]) {
+            if sr >= n {
+                (SplitEq::new(&[]), &[][..])
+            } else {
+                (SplitEq::new(&xi_prev[sr + 1..]), st.points(xi_prev[sr]))
+            }
+        };
+        let mut cur: Vec<[EF<SC>; 4]>;
+        let mut next_sr: usize; // first round whose sums are not yet emitted; `cur` is folded next_sr times
+        if seg_layer <= top_stored {
+            let lay = std::mem::take(&mut layers[seg_layer]);
+            let (e, pts) = round_setup(&st, 0);
+            let sums = pass(Tab::Layer(&lay), None, None, &e, 0, pts, w);
+            let r0 = emit(&mut st, &sums, xi_prev[0], transcript, &mut round_polys_eval);
+            r_vec.push(r0);
+            let (e, pts) = round_setup(&st, 1);
+            cur = vec![[EF::<SC>::ZERO; 4]; lay.len() / 4];
+            let sums = pass(Tab::Layer(&lay), Some(r0), Some(&mut cur), &e, 0, pts, w);
+            drop(lay);
+            next_sr = 1;
+            if n > 1 {
+                let r = emit(&mut st, &sums, xi_prev[1], transcript, &mut round_polys_eval);
+                r_vec.push(r);
+            }
+        } else {
+            // streamed layer: x-entries of level seg_layer generated run by run from the input
+            let xent_log = seg_layer - 1; // log2 of x-entries (= n)
+            // streamed rounds K: the table after K folds has 2^(n-K) entries <= 2^cap
+            let k_str = n.saturating_sub(cap).max(1).min(n);
+            let sh = total_rounds - seg_layer; // positions per level entry: 2^sh
+            let min_run = 1usize << (sh + k_str + 2).min(total_rounds);
+            let tab_of = |p: &[SC::F], q: &[EF<SC>]| -> Option<Vec<FracE<EF<SC>>>> {
+                if sh == 0 { None } else { Some(level_of_run(p, q, sh, w)) }
+            };
+            // passes 0..k_str: sums of round j from runs folded j times
+            for j in 0..k_str {
+                let (e, pts) = round_setup(&st, j);
+                let rs = &r_vec[..j];
+                let sums = src.visit_runs(
+                    min_run,
+                    |start, p, q| {
+                        let lv = tab_of(p, q);
+                        let tab = match &lv {
+                            None => Tab::Input(p, q),
+                            Some(v) => Tab::Layer(v),
+                        };
+                        let x0 = (start >> sh) / 2;
+                        if j == 0 {
+                            pass(tab, None, None, &e, x0 / 2, pts, w)
+                        } else {
+                            let f = fold_chunk(tab, rs, w);
+                            pass(Tab::Folded(&f), None, None, &e, (x0 >> j) / 2, pts, w)
+                        }
+                    },
+                    zero_sums,
+                    |mut a, b| {
+                        add_sums(&mut a, &b);
+                        a
+                    },
+                );
+                let r = emit(&mut st, &sums, xi_prev[j], transcript, &mut round_polys_eval);
+                r_vec.push(r);
+            }
+            // final pass: fold k_str times, store, and sum round k_str (fused)
+            let (e, pts) = round_setup(&st, k_str);
+            cur = vec![[EF::<SC>::ZERO; 4]; 1usize << (xent_log - k_str)];
+            let cp = SyncPtr(cur.as_mut_ptr());
+            let rs = &r_vec[..k_str];
+            let sums = src.visit_runs(
+                min_run,
+                |start, p, q| {
+                    let lv = tab_of(p, q);
+                    let tab = match &lv {
+                        None => Tab::Input(p, q),
+                        Some(v) => Tab::Layer(v),
+                    };
+                    let x0 = (start >> sh) / 2;
+                    let o0 = x0 >> k_str;
+                    let olen = tab.len() >> k_str;
+                    // SAFETY: runs are disjoint, so their folded entries are
+                    let out = unsafe { std::slice::from_raw_parts_mut(cp.get().add(o0), olen) };
+                    if k_str == 1 {
+                        pass(tab, Some(rs[0]), Some(out), &e, o0 / 2, pts, w)
+                    } else {
+                        let f = fold_chunk(tab, &rs[..k_str - 1], w);
+                        pass(Tab::Folded(&f), Some(rs[k_str - 1]), Some(out), &e, o0 / 2, pts, w)
+                    }
+                },
+                zero_sums,
+                |mut a, b| {
+                    add_sums(&mut a, &b);
+                    a
+                },
+            );
+            next_sr = k_str;
+            if k_str < n {
+                let r = emit(&mut st, &sums, xi_prev[k_str], transcript, &mut round_polys_eval);
+                r_vec.push(r);
+            }
+        }
+        // remaining rounds on the materialised table: fold by r_(sr) fused with round sr+1's sums
+        let mut sr = next_sr;
+        while cur.len() > 1 {
+            let (e, pts) = round_setup(&st, sr + 1);
+            let mut nf = vec![[EF::<SC>::ZERO; 4]; cur.len() / 2];
+            let sums = pass(Tab::Folded(&cur), Some(r_vec[sr]), Some(&mut nf), &e, 0, pts, w);
+            cur = nf;
+            sr += 1;
+            if sr < n {
+                let r = emit(&mut st, &sums, xi_prev[sr], transcript, &mut round_polys_eval);
+                r_vec.push(r);
+            }
+        }
+        debug_assert_eq!(r_vec.len(), n);
+        let c = cur[0];
+        claims_per_layer.push(GkrLayerClaims::<SC> { p_xi_0: c[0], q_xi_0: c[1], p_xi_1: c[2], q_xi_1: c[3] });
+        for v in [c[0], c[1], c[2], c[3]] {
+            transcript.observe_ext(v);
+        }
+        let mu = transcript.sample_ext();
+        xi_prev = [vec![mu], r_vec].concat();
+        sumcheck_polys.push(round_polys_eval);
+    }
+    fill_report();
+    Ok((
+        FracSumcheckProof { fractional_sum: (frac_sum.p, frac_sum.q), claims_per_layer, sumcheck_polys },
+        xi_prev,
+    ))
+}
+
+/// Placement of one interaction's column in the stacked LogUp input: rows `[row_idx, row_idx+len)`
+/// hold the trace's values repeated cyclically (len / height times), numerators scaled by `norm`.
+pub struct Placement<F> {
+    pub interaction: usize,
+    pub row_idx: usize,
+    pub len: usize,
+    pub norm: F,
+}
+
+/// One trace's contribution to the LogUp input: per-interaction programs (functionals
+/// `[raw count, denom]`, see `gkr_input_specs_one`), the trace matrices and placements.
+pub struct TraceInput<'a, F: Field, EF> {
+    /// all interactions at once: functionals `[count_i (raw), denom_i]` (see `gkr_input_specs_all`)
+    pub full: super::zc::Program<F, EF>,
+    pub progs: Vec<super::zc::Program<F, EF>>,
+    pub mats: Vec<(&'a p3_matrix::dense::RowMajorMatrix<F>, bool)>,
+    pub height: usize,
+    pub placements: Vec<Placement<F>>,
+}
+
+/// The LogUp input generated from the traces (`eval_interactions` per row, in stacked order).
+pub struct TraceInputSource<'a, F: Field, EF> {
+    pub n: usize,
+    pub alpha: EF,
+    pub traces: Vec<TraceInput<'a, F, EF>>,
+}
+
+impl<F: Field, EF: ExtensionField<F>> InputSource<F, EF> for TraceInputSource<'_, F, EF> {
+    fn n(&self) -> usize {
+        self.n
+    }
+    fn fill(&self, start: usize, p: &mut [F], q: &mut [EF]) {
+        let t0 = std::time::Instant::now();
+        self.fill_inner(start, p, q);
+        FILL_NS.fetch_add(t0.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+    }
+
+    /// Row-block order: each block of trace rows is evaluated once for all interactions (one
+    /// pass over the trace instead of one per interaction); placements smaller than the block
+    /// size form a tail that is generated by position.
+    fn visit_runs<R: Send, Fv, Z, A>(&self, min_run: usize, f: Fv, zero: Z, add: A) -> R
+    where
+        Fv: Fn(usize, &[F], &[EF]) -> R + Sync,
+        Z: Fn() -> R + Sync,
+        A: Fn(R, R) -> R + Sync,
+    {
+        type P<F> = <F as Field>::Packing;
+        let wl = <P<F> as PackedValue>::WIDTH;
+        let t0 = std::time::Instant::now();
+        let t_min = min_run.max(wl).max(1 << 12);
+        if self.n < t_min {
+            assert!(self.n >= min_run);
+            let mut p = vec![F::ZERO; self.n];
+            let mut q = vec![EF::ZERO; self.n];
+            self.fill(0, &mut p, &mut q);
+            return f(0, &p, &q);
+        }
+        // big traces: height >= t_min; their placements must form the prefix [0, big_end)
+        let mut big_end = 0usize;
+        let mut big_len = 0usize;
+        let mut small_start = usize::MAX;
+        for tr in &self.traces {
+            for pl in &tr.placements {
+                if tr.height >= t_min {
+                    big_end = big_end.max(pl.row_idx + pl.len);
+                    big_len += pl.len;
+                } else {
+                    small_start = small_start.min(pl.row_idx);
+                }
+            }
+        }
+        if big_len != big_end || (small_start != usize::MAX && small_start < big_end) || big_end % t_min != 0 {
+            // layout not as expected: generate by position
+            let ch = CHUNK.min(self.n).max(min_run);
+            let mut p = vec![F::ZERO; ch];
+            let mut q = vec![EF::ZERO; ch];
+            let mut acc = zero();
+            for start in (0..self.n).step_by(ch) {
+                self.fill(start, &mut p, &mut q);
+                acc = add(acc, f(start, &p, &q));
+            }
+            return acc;
+        }
+        // units: (trace, first row) with blocks of rb rows
+        let units: Vec<(usize, usize, usize)> = self
+            .traces
+            .iter()
+            .enumerate()
+            .filter(|(_, tr)| tr.height >= t_min)
+            .flat_map(|(ti, tr)| {
+                let rb = tr.height.min(t_min.max(1 << 12));
+                (0..tr.height).step_by(rb).map(move |r0| (ti, r0, rb))
+            })
+            .collect();
+        let alpha = self.alpha;
+        let big = units
+            .par_iter()
+            .map(|&(ti, r0, rb)| {
+                let tr = &self.traces[ti];
+                let prog = &tr.full;
+                let nint = prog.num_funcs() / 2;
+                let height = tr.height;
+                let mut slots = vec![P::<F>::ZERO; prog.n_slots()];
+                let mut fsum = vec![PE::<P<F>>::zero(); 2 * nint];
+                let mut raw = vec![P::<F>::ZERO; 2 * nint];
+                let konst: Vec<PE<P<F>>> = (0..2 * nint)
+                    .map(|fi| if fi % 2 == 1 { PE::broadcast(coeffs::<F, EF>(&(prog.konst[fi] + alpha))) } else { PE::zero() })
+                    .collect();
+                let mut ps = vec![F::ZERO; nint * rb];
+                let mut qs = vec![EF::ZERO; nint * rb];
+                for sb in (0..rb).step_by(wl) {
+                    let rr = r0 + sb;
+                    for (i, &(t, c)) in prog.inputs().iter().enumerate() {
+                        slots[i] = if t == 0 {
+                            P::<F>::from_fn(|l| {
+                                let row = rr + l;
+                                F::from_bool(match c {
+                                    0 => row == 0,
+                                    1 => row != height - 1,
+                                    _ => row == height - 1,
+                                })
+                            })
+                        } else {
+                            let (m, rot) = tr.mats[t - 1];
+                            let h = m.values.len() / m.width;
+                            let base = rr + usize::from(rot);
+                            if base + wl <= h {
+                                let w = m.width;
+                                P::<F>::from_fn(|l| m.values[(base + l) * w + c])
+                            } else {
+                                P::<F>::from_fn(|l| m.values[((base + l) % h) * m.width + c])
+                            }
+                        };
+                    }
+                    fsum.copy_from_slice(&konst);
+                    prog.run_base(&mut slots, &mut fsum, &mut raw);
+                    for &(fi, v) in &prog.raw_const {
+                        raw[fi] = P::<F>::from(v);
+                    }
+                    for ii in 0..nint {
+                        let pv = raw[2 * ii];
+                        let qv = &fsum[2 * ii + 1];
+                        for l in 0..wl {
+                            ps[ii * rb + sb + l] = pv.as_slice()[l];
+                            qs[ii * rb + sb + l] = from_coeffs::<F, EF>(&qv.lane(l));
+                        }
+                    }
+                }
+                let mut acc = zero();
+                let mut pscaled = vec![F::ZERO; rb];
+                for pl in &tr.placements {
+                    let ii = pl.interaction;
+                    let pr = &ps[ii * rb..(ii + 1) * rb];
+                    let qr = &qs[ii * rb..(ii + 1) * rb];
+                    let pr: &[F] = if pl.norm == F::ONE {
+                        pr
+                    } else {
+                        for (d, &x) in pscaled.iter_mut().zip(pr) {
+                            *d = x * pl.norm;
+                        }
+                        &pscaled
+                    };
+                    for k in 0..pl.len / height {
+                        let start = pl.row_idx + k * height + r0;
+                        acc = add(acc, f(start, pr, qr));
+                    }
+                }
+                acc
+            })
+            .reduce(&zero, &add);
+        // tail: positions [big_end, n) by position, chunks of t_min
+        let tail_chunks: Vec<usize> = (big_end..self.n).step_by(t_min).collect();
+        let tail = tail_chunks
+            .par_iter()
+            .map(|&start| {
+                let mut p = vec![F::ZERO; t_min];
+                let mut q = vec![EF::ZERO; t_min];
+                self.fill_inner(start, &mut p, &mut q);
+                f(start, &p, &q)
+            })
+            .reduce(&zero, &add);
+        FILL_NS.fetch_add(t0.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+        add(big, tail)
+    }
+}
+
+/// Wall time spent generating the LogUp input (reported with `NEARPROOF_MEMPROF=1`).
+pub static FILL_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+impl<F: Field, EF: ExtensionField<F>> TraceInputSource<'_, F, EF> {
+    fn fill_inner(&self, start: usize, p: &mut [F], q: &mut [EF]) {
+        type P<F> = <F as Field>::Packing;
+        let wl = <P<F> as PackedValue>::WIDTH;
+        let end = start + p.len();
+        p.par_iter_mut().for_each(|x| *x = F::ZERO);
+        let alpha = self.alpha;
+        q.par_iter_mut().for_each(|x| *x = alpha);
+        // work items: (trace, placement, block start position) of WIDTH positions
+        let mut items: Vec<(usize, usize, usize)> = vec![];
+        for (ti, tr) in self.traces.iter().enumerate() {
+            for (pi, pl) in tr.placements.iter().enumerate() {
+                let lo = pl.row_idx.max(start);
+                let hi = (pl.row_idx + pl.len).min(end);
+                let mut pos = lo;
+                while pos < hi {
+                    items.push((ti, pi, pos));
+                    pos += wl;
+                }
+            }
+        }
+        let pp = SyncPtr(p.as_mut_ptr());
+        let qp = SyncPtr(q.as_mut_ptr());
+        items.par_iter().with_min_len(16).for_each_init(
+            || (vec![P::<F>::ZERO; 64], vec![PE::<P<F>>::zero(); 2], vec![P::<F>::ZERO; 2]),
+            |(slots, fsum, raw), &(ti, pi, pos)| {
+                let tr = &self.traces[ti];
+                let pl = &tr.placements[pi];
+                let prog = &tr.progs[pl.interaction];
+                if slots.len() < prog.n_slots() {
+                    slots.resize(prog.n_slots(), P::<F>::ZERO);
+                }
+                let height = tr.height;
+                let r0 = (pos - pl.row_idx) % height;
+                debug_assert!(r0 + wl <= height);
+                for (i, &(t, c)) in prog.inputs().iter().enumerate() {
+                    slots[i] = if t == 0 {
+                        P::<F>::from_fn(|l| {
+                            let row = r0 + l;
+                            F::from_bool(match c {
+                                0 => row == 0,
+                                1 => row != height - 1,
+                                _ => row == height - 1,
+                            })
+                        })
+                    } else {
+                        let (m, rot) = tr.mats[t - 1];
+                        let h = m.values.len() / m.width;
+                        let base = r0 + usize::from(rot);
+                        if base + wl <= h {
+                            let w = m.width;
+                            P::<F>::from_fn(|l| m.values[(base + l) * w + c])
+                        } else {
+                            P::<F>::from_fn(|l| m.values[((base + l) % h) * m.width + c])
+                        }
+                    };
+                }
+                // q = alpha + denom: start the functional at konst + alpha
+                fsum[1] = PE::broadcast(coeffs::<F, EF>(&(prog.konst[1] + alpha)));
+                prog.run_base(slots, fsum, raw);
+                for &(f, v) in &prog.raw_const {
+                    raw[f] = P::<F>::from(v);
+                }
+                let pv = raw[0] * pl.norm;
+                for l in 0..wl {
+                    let off = pos + l - start;
+                    // SAFETY: placements are disjoint; each position is written by one item
+                    unsafe {
+                        *pp.get().add(off) = pv.as_slice()[l];
+                        *qp.get().add(off) = from_coeffs::<F, EF>(&fsum[1].lane(l));
+                    }
+                }
+            },
+        );
+    }
+}
+
+/// Functionals of one interaction's LogUp input: `[count (raw), Σ_j β^j msg_j + β^len (bus + 1)]`.
+pub fn gkr_input_specs_one<F: Field, EF: ExtensionField<F>>(
+    int: &openvm_stark_backend::interaction::Interaction<usize>,
+    beta_pows: &[EF],
+) -> Vec<super::zc::FuncSpec<EF>> {
+    let b = F::from_u32(int.bus_index as u32 + 1);
+    vec![
+        super::zc::FuncSpec { terms: vec![(int.count, EF::ONE)], konst: EF::ZERO, raw: true },
+        super::zc::FuncSpec {
+            terms: int.message.iter().enumerate().map(|(j, &m)| (m, beta_pows[j])).collect(),
+            konst: beta_pows[int.message.len()] * b,
+            raw: false,
+        },
+    ]
+}
+
+/// Functionals of all interactions of a trace: `[count_0 (raw), denom_0, count_1, denom_1, ..]`.
+pub fn gkr_input_specs_all<F: Field, EF: ExtensionField<F>>(
+    interactions: &[openvm_stark_backend::interaction::Interaction<usize>],
+    beta_pows: &[EF],
+) -> Vec<super::zc::FuncSpec<EF>> {
+    interactions.iter().flat_map(|int| gkr_input_specs_one::<F, EF>(int, beta_pows)).collect()
+}
