+//! [pq-cpu-prover] Fast CPU prover paths (byte-identical to the original code; see each module).
+pub mod gkr;
+pub mod pext;
+pub mod round0;
+pub mod zc;
+
+pub use pext::{detect_w, fast_enabled};
diff --git a/crates/cpu-backend/src/fast/pext.rs b/crates/cpu-backend/src/fast/pext.rs
new file mode 100644
--- /dev/null
+++ b/crates/cpu-backend/src/fast/pext.rs
@@ -0,0 +1,183 @@
+//! [pq-cpu-prover] Packed degree-12 binomial extension arithmetic, struct-of-arrays.
+//!
+//! `PE<P>` holds `P::WIDTH` independent extension elements: coefficient `j` of all lanes lives in
+//! `self.0[j]`. With `-C target-cpu=native` on AVX-512 hosts `P` is `PackedBabyBearAVX512`
+//! (16 lanes); without SIMD it is the scalar field (1 lane), and the same code still runs.
+//!
+//! Multiplication uses the lazy-reduction dot products of `PrimeCharacteristicRing::dot_product`
+//! (products summed in u64 before one Montgomery reduction), which are exact: every function here
+//! returns the field-exact result, so its output is bit-identical to p3's generic arithmetic.
+
+use p3_field::{BasedVectorSpace, ExtensionField, Field, PackedField};
+
+pub const D: usize = 12;
+
+#[derive(Clone, Copy, Debug)]
+#[repr(transparent)]
+pub struct PE<P>(pub [P; D]);
+
+impl<P: PackedField> Default for PE<P> {
+    fn default() -> Self {
+        Self::zero()
+    }
+}
+
+impl<P: PackedField> PE<P> {
+    #[inline(always)]
+    pub fn zero() -> Self {
+        PE([P::ZERO; D])
+    }
+    #[inline(always)]
+    pub fn add(&self, o: &Self) -> Self {
+        PE(core::array::from_fn(|i| self.0[i] + o.0[i]))
+    }
+    #[inline(always)]
+    pub fn add_assign(&mut self, o: &Self) {
+        for i in 0..D {
+            self.0[i] += o.0[i];
+        }
+    }
+    #[inline(always)]
+    pub fn sub(&self, o: &Self) -> Self {
+        PE(core::array::from_fn(|i| self.0[i] - o.0[i]))
+    }
+    #[inline(always)]
+    pub fn neg(&self) -> Self {
+        PE(core::array::from_fn(|i| -self.0[i]))
+    }
+    /// Multiply every lane by a packed base-field value.
+    #[inline(always)]
+    pub fn mul_base(&self, s: P) -> Self {
+        PE(core::array::from_fn(|i| self.0[i] * s))
+    }
+    /// Multiply every lane by one base-field scalar.
+    #[inline(always)]
+    pub fn mul_scalar(&self, s: P::Scalar) -> Self {
+        PE(core::array::from_fn(|i| self.0[i] * s))
+    }
+    /// Add a base-field scalar (to the constant coefficient).
+    #[inline(always)]
+    pub fn add_scalar(&self, s: P::Scalar) -> Self {
+        let mut r = *self;
+        r.0[0] += s;
+        r
+    }
+    /// `self * o` in F[X]/(X^12 - w).
+    #[inline(always)]
+    pub fn mul(&self, o: &Self, w: P::Scalar) -> Self {
+        // ext[m] = w * o[m + 1] (m < 11), ext[11 + j] = o[j]
+        let mut ext = [P::ZERO; 2 * D - 1];
+        ext[D - 1..].copy_from_slice(&o.0);
+        for m in 0..D - 1 {
+            ext[m] = o.0[m + 1] * w;
+        }
+        self.mul_ext(&ext)
+    }
+    /// `self * b` where `ext` is the precomputed `[w*b_1, .., w*b_11, b_0, .., b_11]`.
+    /// res_k = sum_t a_{11-t} ext_{k+t}.
+    #[inline(always)]
+    pub fn mul_ext(&self, ext: &[P; 2 * D - 1]) -> Self {
+        let mut a_rev = [P::ZERO; D];
+        for t in 0..D {
+            a_rev[t] = self.0[D - 1 - t];
+        }
+        PE(core::array::from_fn(|k| {
+            P::dot_product::<D>(&a_rev, ext[k..k + D].try_into().unwrap())
+        }))
+    }
+    /// Broadcast one extension element (given by its coefficients) to all lanes.
+    #[inline(always)]
+    pub fn broadcast(c: &[P::Scalar]) -> Self {
+        PE(core::array::from_fn(|j| P::from(c[j])))
+    }
+    /// Sum over lanes; coefficients of the resulting extension element.
+    #[inline(always)]
+    pub fn hsum(&self) -> [P::Scalar; D] {
+        core::array::from_fn(|j| self.0[j].as_slice().iter().copied().sum())
+    }
+    #[inline(always)]
+    pub fn lane(&self, l: usize) -> [P::Scalar; D] {
+        core::array::from_fn(|j| self.0[j].as_slice()[l])
+    }
+}
+
+/// A fixed multiplier, precomputed for `PE::mul_ext`.
+#[derive(Clone, Copy, Debug)]
+pub struct PreMul<P>(pub [P; 2 * D - 1]);
+
+impl<P: PackedField> PreMul<P> {
+    pub fn new(b: &[P::Scalar], w: P::Scalar) -> Self {
+        let mut ext = [P::ZERO; 2 * D - 1];
+        for j in 0..D {
+            ext[D - 1 + j] = P::from(b[j]);
+        }
+        for m in 0..D - 1 {
+            ext[m] = P::from(b[m + 1] * w);
+        }
+        PreMul(ext)
+    }
+    #[inline(always)]
+    pub fn mul(&self, a: &PE<P>) -> PE<P> {
+        a.mul_ext(&self.0)
+    }
+}
+
+/// Coefficients of an extension element.
+#[inline(always)]
+pub fn coeffs<F: Field, EF: ExtensionField<F>>(x: &EF) -> &[F] {
+    x.as_basis_coefficients_slice()
+}
+
+#[inline(always)]
+pub fn from_coeffs<F: Field, EF: ExtensionField<F>>(c: &[F]) -> EF {
+    EF::from_basis_coefficients_fn(|i| c[i])
+}
+
+/// `Some(w)` if `EF` is `F[X]/(X^12 - w)` with the power basis (checked on sample products);
+/// the fast paths are used only then.
+pub fn detect_w<F: Field, EF: ExtensionField<F>>() -> Option<F> {
+    if <EF as BasedVectorSpace<F>>::DIMENSION != D {
+        return None;
+    }
+    let x: EF = EF::from_basis_coefficients_fn(|i| if i == 1 { F::ONE } else { F::ZERO });
+    let mut x12 = EF::ONE;
+    for _ in 0..D {
+        x12 *= x;
+    }
+    let c = coeffs::<F, EF>(&x12);
+    if c[1..].iter().any(|v| *v != F::ZERO) {
+        return None;
+    }
+    let w = c[0];
+    // spot-check products against the field's own multiplication (scalar lane path)
+    let mut s = 0x9e3779b9u32;
+    let mut next = || {
+        s ^= s << 13;
+        s ^= s >> 17;
+        s ^= s << 5;
+        F::from_u32(s >> 2)
+    };
+    for _ in 0..8 {
+        let a: EF = EF::from_basis_coefficients_fn(|_| next());
+        let b: EF = EF::from_basis_coefficients_fn(|_| next());
+        let pa: PE<F> = PE::broadcast(coeffs::<F, EF>(&a));
+        let pb: PE<F> = PE::broadcast(coeffs::<F, EF>(&b));
+        let pr = pa.mul(&pb, w);
+        if from_coeffs::<F, EF>(&pr.hsum()) != a * b {
+            return None;
+        }
+        let pm = PreMul::<F::Packing>::new(coeffs::<F, EF>(&b), w);
+        let pa2: PE<F::Packing> = PE::broadcast(coeffs::<F, EF>(&a));
+        if from_coeffs::<F, EF>(&pm.mul(&pa2).lane(0)) != a * b {
+            return None;
+        }
+    }
+    Some(w)
+}
+
+/// Fast path switch: `NEARPROOF_CPU_FAST=0` selects the original code everywhere.
+pub fn fast_enabled() -> bool {
+    use std::sync::OnceLock;
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("NEARPROOF_CPU_FAST").map(|v| v != "0").unwrap_or(true))
+}
diff --git a/crates/cpu-backend/src/fast/round0.rs b/crates/cpu-backend/src/fast/round0.rs
new file mode 100644
--- /dev/null
+++ b/crates/cpu-backend/src/fast/round0.rs
@@ -0,0 +1,170 @@
+//! [pq-cpu-prover] Univariate-skip round 0 of zerocheck + LogUp in packed base-field arithmetic.
+//!
+//! The original code (`sumcheck_uni_round0_zerocheck_packed`, `sumcheck_uni_round0_batch`) walks
+//! the hypercube point by point: per point it extracts and iDFTs a block of `2^l_skip` rows,
+//! coset-DFTs it, evaluates the constraint DAG packed over the `2^l_skip` skip points only, then
+//! re-evaluates every interaction as an expression tree, per point, per coset. Here the lanes run
+//! over hypercube points `x`, the coset values come from one precomputed Lagrange matrix per coset
+//! (`L_z(s ω^z')`, lazy dot products), and a single compiled DAG pass gives the zerocheck and both
+//! LogUp functionals. The evaluations are the same field elements at the same coset points, so
+//! the round-0 polynomials are identical.
+
+use p3_field::{ExtensionField, Field, PackedValue, PrimeCharacteristicRing, TwoAdicField};
+use p3_matrix::dense::RowMajorMatrix;
+use p3_maybe_rayon::prelude::*;
+
+use super::{
+    pext::{coeffs, from_coeffs, PE},
+    zc::{lanes, Program},
+};
+
+type P<F> = <F as Field>::Packing;
+
+pub struct Round0Out<EF> {
+    /// `[z * d_zc + ci]`, Σ_x eq(x) Σ λ^i C_i at `g^(ci+1) ω^z` (no zerofier factor)
+    pub zc: Vec<EF>,
+    /// `[z * d_lg + ci]`
+    pub num: Vec<EF>,
+    pub den: Vec<EF>,
+}
+
+/// Number of hypercube points needed for the packed path.
+pub fn min_points<F: Field>() -> usize {
+    lanes::<F>()
+}
+
+/// `tables[0]` is the selector matrix, `tables[1..]` the AIR's row-major matrices (with rotation
+/// flags) in `view_mats_rowmaj` order. `eq_xi[x]` for `x < 2^n_lift`.
+#[tracing::instrument(level = "info", skip_all)]
+pub fn round0<F: TwoAdicField, EF: ExtensionField<F>>(
+    prog: &Program<F, EF>,
+    l_skip: usize,
+    n_lift: usize,
+    tables: &[(&RowMajorMatrix<F>, bool)],
+    eq_xi: &[EF],
+    d_zc: usize,
+    d_lg: usize,
+) -> Round0Out<EF> {
+    let wl = lanes::<F>();
+    let npts = 1usize << n_lift;
+    debug_assert!(npts >= wl);
+    let nb = npts / wl;
+    let sk = 1usize << l_skip;
+    let n_cos = d_zc.max(if prog.used[1] { d_lg } else { 0 });
+    let g = F::GENERATOR;
+    let omega = F::two_adic_generator(l_skip);
+    let om: Vec<F> = omega.powers().take(sk).collect();
+    let n_inv = F::from_usize(sk).inverse();
+    // m[ci][z'][z] = L_z(s ω^z') = ω^z (s^N - 1) / (N (s ω^z' - ω^z))
+    let mut m: Vec<Vec<Vec<P<F>>>> = Vec::with_capacity(n_cos);
+    let mut s = F::ONE;
+    for _ in 0..n_cos {
+        s *= g;
+        let sn1 = s.exp_power_of_2(l_skip) - F::ONE;
+        m.push(
+            (0..sk)
+                .map(|zp| {
+                    (0..sk)
+                        .map(|z| P::<F>::from(om[z] * sn1 * n_inv * (s * om[zp] - om[z]).inverse()))
+                        .collect()
+                })
+                .collect(),
+        );
+    }
+    let inputs = prog.inputs();
+    let n_in = inputs.len();
+    let nf = prog.num_funcs();
+    let heights: Vec<usize> = tables.iter().map(|(t, _)| t.values.len() / t.width).collect();
+    let konst: Vec<PE<P<F>>> = prog.konst.iter().map(|k| PE::broadcast(coeffs::<F, EF>(k))).collect();
+    struct St<Q> {
+        v: Vec<Q>,
+        slots: Vec<Q>,
+        raw: Vec<Q>,
+        fsum: Vec<PE<Q>>,
+        zc: Vec<PE<Q>>,
+        num: Vec<PE<Q>>,
+        den: Vec<PE<Q>>,
+    }
+    let new_st = || St::<P<F>> {
+        v: vec![P::<F>::ZERO; n_in * sk],
+        slots: vec![P::<F>::ZERO; prog.n_slots()],
+        raw: vec![P::<F>::ZERO; nf],
+        fsum: vec![PE::zero(); nf],
+        zc: vec![PE::zero(); sk * d_zc],
+        num: vec![PE::zero(); sk * d_lg],
+        den: vec![PE::zero(); sk * d_lg],
+    };
+    let used = prog.used.clone();
+    let fold_blk = |mut st: St<P<F>>, b: usize| -> St<P<F>> {
+        for (i, &(t, c)) in inputs.iter().enumerate() {
+            let (mat, rot) = tables[t];
+            let h = heights[t];
+            let w = mat.width;
+            let off = usize::from(rot);
+            for z in 0..sk {
+                let r_first = ((b * wl) << l_skip) + z + off;
+                let r_last = r_first + ((wl - 1) << l_skip);
+                st.v[i * sk + z] = if r_last < h {
+                    P::<F>::from_fn(|l| mat.values[(r_first + (l << l_skip)) * w + c])
+                } else {
+                    P::<F>::from_fn(|l| {
+                        let x = b * wl + l;
+                        mat.values[(((x << l_skip) + z + off) % h) * w + c]
+                    })
+                };
+            }
+        }
+        let eq: PE<P<F>> = PE(core::array::from_fn(|j| {
+            P::<F>::from_fn(|l| coeffs::<F, EF>(&eq_xi[b * wl + l])[j])
+        }));
+        for ci in 0..n_cos {
+            for zp in 0..sk {
+                let row = &m[ci][zp];
+                for i in 0..n_in {
+                    let vi = &st.v[i * sk..i * sk + sk];
+                    st.slots[i] = if sk == 4 {
+                        P::<F>::dot_product::<4>(vi.try_into().unwrap(), row[..4].try_into().unwrap())
+                    } else {
+                        let mut a = P::<F>::ZERO;
+                        for z in 0..sk {
+                            a += vi[z] * row[z];
+                        }
+                        a
+                    };
+                }
+                st.fsum.copy_from_slice(&konst);
+                prog.run_base(&mut st.slots, &mut st.fsum, &mut st.raw);
+                if ci < d_zc && used[0] {
+                    let v = eq.mul(&st.fsum[0], prog.w());
+                    st.zc[zp * d_zc + ci].add_assign(&v);
+                }
+                if ci < d_lg && used[1] {
+                    let v = eq.mul(&st.fsum[1], prog.w());
+                    st.num[zp * d_lg + ci].add_assign(&v);
+                    let v = eq.mul(&st.fsum[2], prog.w());
+                    st.den[zp * d_lg + ci].add_assign(&v);
+                }
+            }
+        }
+        st
+    };
+    let st = (0..nb)
+        .into_par_iter()
+        .with_min_len(2)
+        .fold(new_st, fold_blk)
+        .reduce(new_st, |mut a, b| {
+            for (x, y) in a.zc.iter_mut().zip(&b.zc) {
+                x.add_assign(y);
+            }
+            for (x, y) in a.num.iter_mut().zip(&b.num) {
+                x.add_assign(y);
+            }
+            for (x, y) in a.den.iter_mut().zip(&b.den) {
+                x.add_assign(y);
+            }
+            a
+        });
+    let h = |v: &[PE<P<F>>]| v.iter().map(|x| from_coeffs::<F, EF>(&x.hsum())).collect::<Vec<EF>>();
+    Round0Out { zc: h(&st.zc), num: h(&st.num), den: h(&st.den) }
+}
+
diff --git a/crates/cpu-backend/src/fast/zc.rs b/crates/cpu-backend/src/fast/zc.rs
new file mode 100644
--- /dev/null
+++ b/crates/cpu-backend/src/fast/zc.rs
@@ -0,0 +1,1062 @@
+//! [pq-cpu-prover] Zerocheck + LogUp MLE rounds on struct-of-arrays Ext12 tables.
+//!
+//! After the univariate round the trace tables are Ext12. The original code evaluates the
+//! constraint DAG once per (y, x) on scalar Ext12 values (allocating a node vector each time) and
+//! evaluates every interaction expression a second time as an expression tree. Here:
+//!
+//! * the tables are stored lane-strided (`SoaTable`): lane `l` of block `b` holds row
+//!   `l * B + b` (B = height / WIDTH). Row pairs `(2y, 2y+1)` then sit in blocks `(2b', 2b'+1)` of
+//!   the same lane, so the round evaluation and the fold are pure vector code, and folding keeps
+//!   the layout;
+//! * the DAG (constraints and interaction expressions together) is compiled once per round set
+//!   into a register program with liveness-based slot reuse, constants folded, and Ext×base
+//!   multiplications where one side is constant;
+//! * the three outputs (Σ λ^i C_i, Σ eq3b_i count_i, Σ eq3b_i denom_i) are linear functionals of
+//!   node values; their coefficients are precomputed (duplicates merged, constant terms folded).
+//!
+//! Every quantity is the same field element the original code computes, so round polynomials,
+//! openings and proofs are byte-identical.
+
+use std::collections::HashMap;
+
+use openvm_stark_backend::{
+    air_builders::symbolic::{symbolic_variable::Entry, SymbolicExpressionDag, SymbolicExpressionNode},
+    interaction::Interaction,
+};
+use p3_field::{ExtensionField, Field, PackedValue, PrimeCharacteristicRing};
+use p3_matrix::dense::RowMajorMatrix;
+use p3_maybe_rayon::prelude::*;
+
+use super::pext::{coeffs, from_coeffs, PreMul, D, PE};
+
+type P<F> = <F as Field>::Packing;
+
+/// Lane-strided SoA Ext12 table: element (row `l*B + b`, col `c`) coefficient `j` is lane `l` of
+/// `data[(b * width + c) * D + j]`.
+pub struct SoaTable<F: Field> {
+    pub width: usize,
+    pub height: usize,
+    pub data: Vec<P<F>>,
+}
+
+#[inline(always)]
+pub fn lanes<F: Field>() -> usize {
+    <P<F> as PackedValue>::WIDTH
+}
+
+/// Tables with fewer rows than this use the row-major scalar code.
+#[inline(always)]
+pub fn min_height<F: Field>() -> usize {
+    2 * lanes::<F>()
+}
+
+impl<F: Field> SoaTable<F> {
+    #[inline(always)]
+    pub fn blocks(&self) -> usize {
+        self.height / lanes::<F>()
+    }
+    #[inline(always)]
+    pub fn get(&self, b: usize, c: usize) -> PE<P<F>> {
+        let o = (b * self.width + c) * D;
+        PE(self.data[o..o + D].try_into().unwrap())
+    }
+
+    /// Univariate-skip fold of a base-field row-major matrix (`fold_ple_evals_rowmajor`), written
+    /// directly in SoA layout. `cs[z] = scaling * omega^z / (r - omega^z)`.
+    pub fn from_ple<EF: ExtensionField<F>>(
+        l_skip: usize,
+        rm: &RowMajorMatrix<F>,
+        is_rot: bool,
+        cs: &[EF],
+    ) -> Self {
+        let width = rm.width;
+        let height = rm.values.len() / width;
+        let skip = 1usize << l_skip;
+        let new_height = height.max(skip) >> l_skip;
+        let w = lanes::<F>();
+        let nb = new_height / w;
+        let off = usize::from(is_rot);
+        let csb: Vec<Vec<P<F>>> = (0..D)
+            .map(|j| cs.iter().map(|c| P::<F>::from(coeffs::<F, EF>(c)[j])).collect())
+            .collect();
+        let mut data = vec![P::<F>::ZERO; nb * width * D];
+        data.par_chunks_mut(width * D).enumerate().for_each(|(b, out)| {
+            let mut vz = vec![P::<F>::ZERO; skip];
+            for c in 0..width {
+                for z in 0..skip {
+                    vz[z] = P::<F>::from_fn(|l| {
+                        let x = l * nb + b;
+                        let row = ((x << l_skip) + z + off) % height;
+                        rm.values[row * width + c]
+                    });
+                }
+                for j in 0..D {
+                    out[c * D + j] = if skip == 4 {
+                        P::<F>::dot_product::<4>(
+                            vz[..4].try_into().unwrap(),
+                            csb[j][..4].try_into().unwrap(),
+                        )
+                    } else {
+                        let mut acc = P::<F>::ZERO;
+                        for z in 0..skip {
+                            acc += vz[z] * csb[j][z];
+                        }
+                        acc
+                    };
+                }
+            }
+        });
+        Self { width, height: new_height, data }
+    }
+
+    /// `out[x] = Σ_k weights[k] * rm[(x << log_step) + k + rot]` (rows mod the height, lifted
+    /// to at least 2^log_step rows): the univariate-skip fold (`log_step = l_skip`) or the skip
+    /// fold followed by the first multilinear fold (`log_step = l_skip + 1`) in one pass.
+    pub fn from_ple_weights<EF: ExtensionField<F>>(
+        log_step: usize,
+        rm: &RowMajorMatrix<F>,
+        is_rot: bool,
+        weights: &[EF],
+    ) -> Self {
+        let width = rm.width;
+        let height = rm.values.len() / width;
+        let step = 1usize << log_step;
+        debug_assert_eq!(weights.len(), step);
+        let new_height = height.max(step) >> log_step;
+        let w = lanes::<F>();
+        let nb = new_height / w;
+        let off = usize::from(is_rot);
+        let wb: Vec<Vec<P<F>>> = (0..D)
+            .map(|j| weights.iter().map(|c| P::<F>::from(coeffs::<F, EF>(c)[j])).collect())
+            .collect();
+        let mut data = vec![P::<F>::ZERO; nb * width * D];
+        data.par_chunks_mut(width * D).enumerate().for_each(|(b, out)| {
+            let mut vz = vec![P::<F>::ZERO; step];
+            for c in 0..width {
+                for z in 0..step {
+                    vz[z] = P::<F>::from_fn(|l| {
+                        let x = l * nb + b;
+                        let row = ((x << log_step) + z + off) % height;
+                        rm.values[row * width + c]
+                    });
+                }
+                for j in 0..D {
+                    out[c * D + j] = match step {
+                        4 => P::<F>::dot_product::<4>(vz[..4].try_into().unwrap(), wb[j][..4].try_into().unwrap()),
+                        8 => P::<F>::dot_product::<8>(vz[..8].try_into().unwrap(), wb[j][..8].try_into().unwrap()),
+                        _ => {
+                            let mut acc = P::<F>::ZERO;
+                            for z in 0..step {
+                                acc += vz[z] * wb[j][z];
+                            }
+                            acc
+                        }
+                    };
+                }
+            }
+        });
+        Self { width, height: new_height, data }
+    }
+
+    /// Multilinear fold of row pairs at `r`: row' y = row 2y + r (row 2y+1 - row 2y).
+    pub fn fold(&self, r: &PreMul<P<F>>) -> Self {
+        let nb = self.blocks() / 2;
+        let width = self.width;
+        let mut data = vec![P::<F>::ZERO; nb * width * D];
+        data.par_chunks_mut(width * D).enumerate().for_each(|(b, out)| {
+            for c in 0..width {
+                let lo = self.get(2 * b, c);
+                let hi = self.get(2 * b + 1, c);
+                let v = lo.add(&r.mul(&hi.sub(&lo)));
+                out[c * D..c * D + D].copy_from_slice(&v.0);
+            }
+        });
+        Self { width, height: self.height / 2, data }
+    }
+
+    pub fn to_rowmajor<EF: ExtensionField<F>>(&self) -> RowMajorMatrix<EF> {
+        let w = lanes::<F>();
+        let nb = self.blocks();
+        let mut values = vec![EF::ZERO; self.height * self.width];
+        for b in 0..nb {
+            for c in 0..self.width {
+                let v = self.get(b, c);
+                for l in 0..w {
+                    values[(l * nb + b) * self.width + c] = from_coeffs::<F, EF>(&v.lane(l));
+                }
+            }
+        }
+        RowMajorMatrix::new(values, self.width)
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Ins<F> {
+    Mul { d: u32, a: u32, b: u32 },
+    Add { d: u32, a: u32, b: u32 },
+    Sub { d: u32, a: u32, b: u32 },
+    Neg { d: u32, a: u32 },
+    MulC { d: u32, a: u32, c: F },
+    AddC { d: u32, a: u32, c: F },
+    /// a - c
+    SubC { d: u32, a: u32, c: F },
+    /// c - a
+    CSub { d: u32, a: u32, c: F },
+    /// F[f] += coef[k] * slot[a]
+    Acc { f: u32, a: u32, k: u32 },
+    /// raw[f] = slot[a] (base-field evaluation only)
+    Raw { f: u32, a: u32 },
+}
+
+/// A linear functional of DAG node values: `konst + Σ coef * node`. With `raw`, the functional is
+/// the single node's value itself (base-field evaluation; the node must be non-constant or the
+/// constant is reported through `konst`).
+#[derive(Clone, Debug)]
+pub struct FuncSpec<EF> {
+    pub terms: Vec<(usize, EF)>,
+    pub konst: EF,
+    pub raw: bool,
+}
+
+/// Degree-aware instruction: every slot holds its node at x = 1..=m points (m = degree + 1,
+/// capped at the round degree `d`), and is extended to all `d` points by finite differences
+/// only when a consumer needs more points.
+#[derive(Clone, Copy, Debug)]
+enum DIns<F> {
+    Mul { d: u32, a: u32, b: u32, m: u8 },
+    Add { d: u32, a: u32, b: u32, m: u8 },
+    Sub { d: u32, a: u32, b: u32, m: u8 },
+    Neg { d: u32, a: u32, m: u8 },
+    MulC { d: u32, a: u32, c: F, m: u8 },
+    AddC { d: u32, a: u32, c: F, m: u8 },
+    SubC { d: u32, a: u32, c: F, m: u8 },
+    CSub { d: u32, a: u32, c: F, m: u8 },
+    /// extend slot `s` from its first `b` points (a polynomial of degree < b) to all d points
+    Ext { s: u32, b: u8 },
+    /// group[f][m] += coef[k] * slot[a][..m]
+    Acc { f: u32, a: u32, k: u32, m: u8 },
+}
+
+/// Degree-aware program for round degree `d`.
+pub struct DaProgram<F> {
+    d: usize,
+    ins: Vec<DIns<F>>,
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Val<F> {
+    C(F),
+    S(u32),
+}
+
+/// One AIR's compiled evaluation program for the MLE rounds.
+pub struct Program<F: Field, EF> {
+    /// (table index into [sels, mats..], column) of each input slot
+    inputs: Vec<(usize, usize)>,
+    n_slots: usize,
+    ins: Vec<Ins<F>>,
+    coefs: Vec<PreMul<P<F>>>,
+    coef_scalars: Vec<[F; D]>,
+    /// constant term of each functional
+    pub konst: Vec<EF>,
+    pub used: Vec<bool>,
+    /// raw functional whose node folded to a constant: (functional, value)
+    pub raw_const: Vec<(usize, F)>,
+    w: F,
+    pub stats: String,
+}
+
+pub struct Layout {
+    pub has_pre: bool,
+    pub needs_next: bool,
+}
+
+impl Layout {
+    fn table(&self, entry: Entry, index: usize) -> (usize, usize) {
+        let (mat, off) = match entry {
+            Entry::Preprocessed { offset } => (0, offset),
+            Entry::Main { part_index, offset } => (usize::from(self.has_pre) + part_index, offset),
+            _ => unreachable!(),
+        };
+        let t = if self.needs_next { 1 + 2 * mat + off } else {
+            debug_assert_eq!(off, 0);
+            1 + mat
+        };
+        (t, index)
+    }
+}
+
+/// The three functionals of a zerocheck/LogUp round: Σ λ^i C_i, Σ eq3b_i count_i, Σ eq3b_i denom_i.
+pub fn zc_logup_specs<F: Field, EF: ExtensionField<F>>(
+    dag: &SymbolicExpressionDag<F>,
+    interactions: &[Interaction<usize>],
+    lambda_pows: &[EF],
+    eq3b: &[EF],
+    beta_pows: &[EF],
+) -> Vec<FuncSpec<EF>> {
+    let zc = FuncSpec {
+        terms: dag.constraint_idx.iter().enumerate().map(|(i, &n)| (n, lambda_pows[i])).collect(),
+        konst: EF::ZERO,
+        raw: false,
+    };
+    let mut num = FuncSpec { terms: vec![], konst: EF::ZERO, raw: false };
+    let mut den = FuncSpec { terms: vec![], konst: EF::ZERO, raw: false };
+    if !eq3b.is_empty() {
+        for (i, int) in interactions.iter().enumerate() {
+            num.terms.push((int.count, eq3b[i]));
+            let b = F::from_u32(int.bus_index as u32 + 1);
+            den.konst += eq3b[i] * beta_pows[int.message.len()] * b;
+            for (j, &m) in int.message.iter().enumerate() {
+                den.terms.push((m, eq3b[i] * beta_pows[j]));
+            }
+        }
+    }
+    vec![zc, num, den]
+}
+
+impl<F: Field, EF: ExtensionField<F>> Program<F, EF> {
+    /// Zerocheck + LogUp program (`zc_logup_specs`).
+    pub fn compile(
+        dag: &SymbolicExpressionDag<F>,
+        interactions: &[Interaction<usize>],
+        public_values: &[F],
+        layout: &Layout,
+        lambda_pows: &[EF],
+        eq3b: &[EF],
+        beta_pows: &[EF],
+        w: F,
+    ) -> Self {
+        let specs = zc_logup_specs(dag, interactions, lambda_pows, eq3b, beta_pows);
+        let mut p = Self::compile_specs(dag, public_values, layout, &specs, w);
+        p.used = vec![!dag.constraint_idx.is_empty(), !eq3b.is_empty(), !eq3b.is_empty()];
+        p
+    }
+
+    pub fn compile_specs(
+        dag: &SymbolicExpressionDag<F>,
+        public_values: &[F],
+        layout: &Layout,
+        specs: &[FuncSpec<EF>],
+        w: F,
+    ) -> Self {
+        let nodes = &dag.nodes;
+        let n = nodes.len();
+        let nf = specs.len();
+        // output coefficients per node: (functional, coef), duplicates merged
+        let mut outc: Vec<Vec<(usize, EF)>> = vec![vec![]; n];
+        let mut konst: Vec<EF> = specs.iter().map(|s| s.konst).collect();
+        let mut raw_of: Vec<Vec<usize>> = vec![vec![]; n];
+        for (f, sp) in specs.iter().enumerate() {
+            if sp.raw {
+                assert_eq!(sp.terms.len(), 1);
+                raw_of[sp.terms[0].0].push(f);
+                continue;
+            }
+            for &(node, c) in &sp.terms {
+                if let Some(e) = outc[node].iter_mut().find(|(g, _)| *g == f) {
+                    e.1 += c;
+                } else {
+                    outc[node].push((f, c));
+                }
+            }
+        }
+        let used: Vec<bool> = specs.iter().map(|s| !s.terms.is_empty()).collect();
+        let mut raw_const = vec![];
+        // reachability
+        let mut need = vec![false; n];
+        for i in 0..n {
+            if !outc[i].is_empty() || !raw_of[i].is_empty() {
+                need[i] = true;
+            }
+        }
+        for i in (0..n).rev() {
+            if !need[i] {
+                continue;
+            }
+            match nodes[i] {
+                SymbolicExpressionNode::Add { left_idx, right_idx, .. }
+                | SymbolicExpressionNode::Sub { left_idx, right_idx, .. }
+                | SymbolicExpressionNode::Mul { left_idx, right_idx, .. } => {
+                    need[left_idx] = true;
+                    need[right_idx] = true;
+                }
+                SymbolicExpressionNode::Neg { idx, .. } => need[idx] = true,
+                _ => {}
+            }
+        }
+        // inputs
+        let mut input_map: HashMap<(usize, usize), u32> = HashMap::new();
+        let mut inputs = vec![];
+        let mut input_of = |key: (usize, usize), inputs: &mut Vec<(usize, usize)>| -> u32 {
+            *input_map.entry(key).or_insert_with(|| {
+                inputs.push(key);
+                (inputs.len() - 1) as u32
+            })
+        };
+        // first pass: values and last use
+        let mut val: Vec<Option<Val<F>>> = vec![None; n];
+        let mut last_use = vec![0usize; n];
+        for i in 0..n {
+            if !need[i] {
+                continue;
+            }
+            match nodes[i] {
+                SymbolicExpressionNode::Add { left_idx, right_idx, .. }
+                | SymbolicExpressionNode::Sub { left_idx, right_idx, .. }
+                | SymbolicExpressionNode::Mul { left_idx, right_idx, .. } => {
+                    last_use[left_idx] = i;
+                    last_use[right_idx] = i;
+                }
+                SymbolicExpressionNode::Neg { idx, .. } => last_use[idx] = i,
+                _ => {}
+            }
+        }
+        for i in 0..n {
+            if !need[i] {
+                continue;
+            }
+            match nodes[i] {
+                SymbolicExpressionNode::Variable(v) => match v.entry {
+                    Entry::Public => val[i] = Some(Val::C(public_values[v.index])),
+                    Entry::Challenge => unreachable!(),
+                    e => {
+                        let k = layout.table(e, v.index);
+                        val[i] = Some(Val::S(input_of(k, &mut inputs)));
+                    }
+                },
+                SymbolicExpressionNode::IsFirstRow => val[i] = Some(Val::S(input_of((0, 0), &mut inputs))),
+                SymbolicExpressionNode::IsTransition => val[i] = Some(Val::S(input_of((0, 1), &mut inputs))),
+                SymbolicExpressionNode::IsLastRow => val[i] = Some(Val::S(input_of((0, 2), &mut inputs))),
+                SymbolicExpressionNode::Constant(c) => val[i] = Some(Val::C(c)),
+                _ => {}
+            }
+        }
+        let n_in = inputs.len();
+        // second pass: instructions with slot allocation
+        let mut free: Vec<u32> = vec![];
+        let mut n_slots = n_in;
+        let mut ins = vec![];
+        let mut coefs = vec![];
+        let mut coef_scalars = vec![];
+        let (mut n_mul, mut n_mulc, mut n_lin) = (0usize, 0usize, 0usize);
+        let alloc = |free: &mut Vec<u32>, n_slots: &mut usize| -> u32 {
+            free.pop().unwrap_or_else(|| {
+                *n_slots += 1;
+                (*n_slots - 1) as u32
+            })
+        };
+        let is_tmp = |s: u32| (s as usize) >= n_in;
+        for i in 0..n {
+            if !need[i] {
+                continue;
+            }
+            let bin = |l: usize, r: usize| (val[l].unwrap(), val[r].unwrap());
+            let new_val: Option<Val<F>> = match nodes[i] {
+                SymbolicExpressionNode::Add { left_idx, right_idx, .. } => Some(match bin(left_idx, right_idx) {
+                    (Val::C(a), Val::C(b)) => Val::C(a + b),
+                    (Val::S(a), Val::C(c)) | (Val::C(c), Val::S(a)) => {
+                        let d = alloc(&mut free, &mut n_slots);
+                        ins.push(Ins::AddC { d, a, c });
+                        n_lin += 1;
+                        Val::S(d)
+                    }
+                    (Val::S(a), Val::S(b)) => {
+                        let d = alloc(&mut free, &mut n_slots);
+                        ins.push(Ins::Add { d, a, b });
+                        n_lin += 1;
+                        Val::S(d)
+                    }
+                }),
+                SymbolicExpressionNode::Sub { left_idx, right_idx, .. } => Some(match bin(left_idx, right_idx) {
+                    (Val::C(a), Val::C(b)) => Val::C(a - b),
+                    (Val::S(a), Val::C(c)) => {
+                        let d = alloc(&mut free, &mut n_slots);
+                        ins.push(Ins::SubC { d, a, c });
+                        n_lin += 1;
+                        Val::S(d)
+                    }
+                    (Val::C(c), Val::S(a)) => {
+                        let d = alloc(&mut free, &mut n_slots);
+                        ins.push(Ins::CSub { d, a, c });
+                        n_lin += 1;
+                        Val::S(d)
+                    }
+                    (Val::S(a), Val::S(b)) => {
+                        let d = alloc(&mut free, &mut n_slots);
+                        ins.push(Ins::Sub { d, a, b });
+                        n_lin += 1;
+                        Val::S(d)
+                    }
+                }),
+                SymbolicExpressionNode::Mul { left_idx, right_idx, .. } => Some(match bin(left_idx, right_idx) {
+                    (Val::C(a), Val::C(b)) => Val::C(a * b),
+                    (Val::S(a), Val::C(c)) | (Val::C(c), Val::S(a)) => {
+                        let d = alloc(&mut free, &mut n_slots);
+                        ins.push(Ins::MulC { d, a, c });
+                        n_mulc += 1;
+                        Val::S(d)
+                    }
+                    (Val::S(a), Val::S(b)) => {
+                        let d = alloc(&mut free, &mut n_slots);
+                        ins.push(Ins::Mul { d, a, b });
+                        n_mul += 1;
+                        Val::S(d)
+                    }
+                }),
+                SymbolicExpressionNode::Neg { idx, .. } => Some(match val[idx].unwrap() {
+                    Val::C(a) => Val::C(-a),
+                    Val::S(a) => {
+                        let d = alloc(&mut free, &mut n_slots);
+                        ins.push(Ins::Neg { d, a });
+                        n_lin += 1;
+                        Val::S(d)
+                    }
+                }),
+                _ => None,
+            };
+            if let Some(v) = new_val {
+                val[i] = Some(v);
+            }
+            // free operands whose last use is this node (after allocating the destination, so the
+            // destination never aliases an operand; harmless either way)
+            let ops: &[usize] = &match nodes[i] {
+                SymbolicExpressionNode::Add { left_idx, right_idx, .. }
+                | SymbolicExpressionNode::Sub { left_idx, right_idx, .. }
+                | SymbolicExpressionNode::Mul { left_idx, right_idx, .. } => [left_idx, right_idx],
+                SymbolicExpressionNode::Neg { idx, .. } => [idx, idx],
+                _ => [usize::MAX, usize::MAX],
+            };
+            // outputs of this node
+            for &(f, c) in &outc[i] {
+                match val[i].unwrap() {
+                    Val::C(v) => konst[f] += c * v,
+                    Val::S(a) => {
+                        coefs.push(PreMul::new(coeffs::<F, EF>(&c), w));
+                        coef_scalars.push(coeffs::<F, EF>(&c).try_into().unwrap());
+                        ins.push(Ins::Acc { f: f as u32, a, k: (coefs.len() - 1) as u32 });
+                    }
+                }
+            }
+            for &f in &raw_of[i] {
+                match val[i].unwrap() {
+                    Val::C(v) => raw_const.push((f, v)),
+                    Val::S(a) => ins.push(Ins::Raw { f: f as u32, a }),
+                }
+            }
+            let mut freed = [u32::MAX; 2];
+            for (q, &o) in ops.iter().enumerate() {
+                if o != usize::MAX && last_use[o] == i {
+                    if let Some(Val::S(s)) = val[o] {
+                        if is_tmp(s) && !freed.contains(&s) {
+                            free.push(s);
+                            freed[q] = s;
+                        }
+                    }
+                }
+            }
+            // a computed node nobody reads (pure output) dies here
+            if let Some(Val::S(s)) = val[i] {
+                if is_tmp(s) && last_use[i] <= i && !matches!(nodes[i], SymbolicExpressionNode::Variable(_)) {
+                    if !free.contains(&s) {
+                        free.push(s);
+                    }
+                }
+            }
+        }
+        // degree in x of each node (variables and selectors are linear in x)
+        let mut deg = vec![0usize; n];
+        for i in 0..n {
+            deg[i] = match nodes[i] {
+                SymbolicExpressionNode::Variable(v) => usize::from(!matches!(v.entry, Entry::Public)),
+                SymbolicExpressionNode::IsFirstRow | SymbolicExpressionNode::IsLastRow | SymbolicExpressionNode::IsTransition => 1,
+                SymbolicExpressionNode::Constant(_) => 0,
+                SymbolicExpressionNode::Add { left_idx, right_idx, .. } | SymbolicExpressionNode::Sub { left_idx, right_idx, .. } => deg[left_idx].max(deg[right_idx]),
+                SymbolicExpressionNode::Mul { left_idx, right_idx, .. } => deg[left_idx] + deg[right_idx],
+                SymbolicExpressionNode::Neg { idx, .. } => deg[idx],
+            };
+        }
+        let (mut mul_pts, mut out_pts, mut mul_deg_hist) = (0usize, 0usize, [0usize; 12]);
+        for i in 0..n {
+            if !need[i] {
+                continue;
+            }
+            if let (SymbolicExpressionNode::Mul { left_idx, right_idx, .. }, Some(Val::S(_))) = (&nodes[i], val[i]) {
+                if !matches!(val[*left_idx], Some(Val::C(_))) && !matches!(val[*right_idx], Some(Val::C(_))) {
+                    mul_pts += (deg[i] + 1).min(9);
+                    mul_deg_hist[deg[i].min(11)] += 1;
+                }
+            }
+            if !outc[i].is_empty() {
+                if let Some(Val::S(_)) = val[i] {
+                    out_pts += ((deg[i] + 1).min(9)) * outc[i].len();
+                }
+            }
+        }
+        let stats = format!(
+            "nodes={n} inputs={n_in} slots={n_slots} mulEE={n_mul} mulEC={n_mulc} lin={n_lin} outputs={} | degree-aware (d=9): mul_points={mul_pts} (vs {}) out_points={out_pts} (vs {}) mul_deg_hist={:?}",
+            coefs.len(), 9 * n_mul, 9 * coefs.len(), mul_deg_hist
+        );
+        let _ = nf;
+        Self { inputs, n_slots, ins, coefs, coef_scalars, konst, used, raw_const, w, stats }
+    }
+
+    pub fn w(&self) -> F {
+        self.w
+    }
+
+    pub fn num_funcs(&self) -> usize {
+        self.konst.len()
+    }
+
+    /// Base-field evaluation (packed over lanes): `fsum[f] += Σ coef * node`, `raw[f] = node`.
+    #[inline(always)]
+    pub fn run_base(&self, slots: &mut [P<F>], fsum: &mut [PE<P<F>>], raw: &mut [P<F>]) {
+        for ins in &self.ins {
+            match *ins {
+                Ins::Mul { d, a, b } => slots[d as usize] = slots[a as usize] * slots[b as usize],
+                Ins::Add { d, a, b } => slots[d as usize] = slots[a as usize] + slots[b as usize],
+                Ins::Sub { d, a, b } => slots[d as usize] = slots[a as usize] - slots[b as usize],
+                Ins::Neg { d, a } => slots[d as usize] = -slots[a as usize],
+                Ins::MulC { d, a, c } => slots[d as usize] = slots[a as usize] * c,
+                Ins::AddC { d, a, c } => slots[d as usize] = slots[a as usize] + c,
+                Ins::SubC { d, a, c } => slots[d as usize] = slots[a as usize] - c,
+                Ins::CSub { d, a, c } => slots[d as usize] = P::<F>::from(c) - slots[a as usize],
+                Ins::Acc { f, a, k } => {
+                    let v = slots[a as usize];
+                    let c = &self.coef_scalars[k as usize];
+                    let acc = &mut fsum[f as usize];
+                    for j in 0..D {
+                        acc.0[j] += v * c[j];
+                    }
+                }
+                Ins::Raw { f, a } => raw[f as usize] = slots[a as usize],
+            }
+        }
+    }
+
+    pub fn inputs(&self) -> &[(usize, usize)] {
+        &self.inputs
+    }
+    pub fn n_slots(&self) -> usize {
+        self.n_slots
+    }
+
+    #[inline(always)]
+    fn run(&self, slots: &mut [PE<P<F>>], fsum: &mut [PE<P<F>>]) {
+        let w = self.w;
+        for ins in &self.ins {
+            match *ins {
+                Ins::Mul { d, a, b } => {
+                    let v = slots[a as usize].mul(&slots[b as usize], w);
+                    slots[d as usize] = v;
+                }
+                Ins::Add { d, a, b } => {
+                    let v = slots[a as usize].add(&slots[b as usize]);
+                    slots[d as usize] = v;
+                }
+                Ins::Sub { d, a, b } => {
+                    let v = slots[a as usize].sub(&slots[b as usize]);
+                    slots[d as usize] = v;
+                }
+                Ins::Neg { d, a } => {
+                    let v = slots[a as usize].neg();
+                    slots[d as usize] = v;
+                }
+                Ins::MulC { d, a, c } => {
+                    let v = slots[a as usize].mul_scalar(c);
+                    slots[d as usize] = v;
+                }
+                Ins::AddC { d, a, c } => {
+                    let v = slots[a as usize].add_scalar(c);
+                    slots[d as usize] = v;
+                }
+                Ins::SubC { d, a, c } => {
+                    let v = slots[a as usize].add_scalar(-c);
+                    slots[d as usize] = v;
+                }
+                Ins::CSub { d, a, c } => {
+                    let v = slots[a as usize].neg().add_scalar(c);
+                    slots[d as usize] = v;
+                }
+                Ins::Acc { f, a, k } => {
+                    let v = self.coefs[k as usize].mul(&slots[a as usize]);
+                    fsum[f as usize].add_assign(&v);
+                }
+                Ins::Raw { .. } => unreachable!("raw outputs are base-field only"),
+            }
+        }
+    }
+
+    /// The degree-aware form of this program for round degree `d` (see [`DIns`]).
+    pub fn degree_aware(&self, d: usize) -> DaProgram<F> {
+        let n_in = self.inputs.len();
+        let mut deg = vec![0usize; self.n_slots];
+        let mut ext = vec![false; self.n_slots];
+        for i in 0..n_in {
+            deg[i] = 1;
+        }
+        let base = |deg: usize| (deg + 1).min(d);
+        let mut out = Vec::with_capacity(self.ins.len() * 2);
+        // make slot `a` available at m points
+        let need = |out: &mut Vec<DIns<F>>, ext: &mut Vec<bool>, deg: &Vec<usize>, a: u32, m: usize| {
+            let a_ = a as usize;
+            if base(deg[a_]) < m && !ext[a_] {
+                out.push(DIns::Ext { s: a, b: base(deg[a_]) as u8 });
+                ext[a_] = true;
+            }
+        };
+        for ins in &self.ins {
+            match *ins {
+                Ins::Mul { d: dd, a, b } => {
+                    let dg = deg[a as usize] + deg[b as usize];
+                    let m = base(dg);
+                    need(&mut out, &mut ext, &deg, a, m);
+                    need(&mut out, &mut ext, &deg, b, m);
+                    out.push(DIns::Mul { d: dd, a, b, m: m as u8 });
+                    deg[dd as usize] = dg;
+                    ext[dd as usize] = m == d;
+                }
+                Ins::Add { d: dd, a, b } | Ins::Sub { d: dd, a, b } => {
+                    let dg = deg[a as usize].max(deg[b as usize]);
+                    let m = base(dg);
+                    need(&mut out, &mut ext, &deg, a, m);
+                    need(&mut out, &mut ext, &deg, b, m);
+                    out.push(if matches!(ins, Ins::Add { .. }) {
+                        DIns::Add { d: dd, a, b, m: m as u8 }
+                    } else {
+                        DIns::Sub { d: dd, a, b, m: m as u8 }
+                    });
+                    deg[dd as usize] = dg;
+                    ext[dd as usize] = m == d;
+                }
+                Ins::Neg { d: dd, a } | Ins::MulC { d: dd, a, .. } | Ins::AddC { d: dd, a, .. } | Ins::SubC { d: dd, a, .. } | Ins::CSub { d: dd, a, .. } => {
+                    let dg = deg[a as usize];
+                    // operate on all valid points of a (extended or not)
+                    let m = if ext[a as usize] { d } else { base(dg) };
+                    let mu = m as u8;
+                    out.push(match *ins {
+                        Ins::Neg { .. } => DIns::Neg { d: dd, a, m: mu },
+                        Ins::MulC { c, .. } => DIns::MulC { d: dd, a, c, m: mu },
+                        Ins::AddC { c, .. } => DIns::AddC { d: dd, a, c, m: mu },
+                        Ins::SubC { c, .. } => DIns::SubC { d: dd, a, c, m: mu },
+                        Ins::CSub { c, .. } => DIns::CSub { d: dd, a, c, m: mu },
+                        _ => unreachable!(),
+                    });
+                    deg[dd as usize] = dg;
+                    ext[dd as usize] = m == d;
+                }
+                Ins::Acc { f, a, k } => {
+                    out.push(DIns::Acc { f, a, k, m: base(deg[a as usize]) as u8 });
+                }
+                Ins::Raw { .. } => unreachable!("raw outputs are base-field only"),
+            }
+        }
+        DaProgram { d, ins: out }
+    }
+
+    /// `round_evals` through the degree-aware program (identical values).
+    pub fn round_evals_da(&self, da: &DaProgram<F>, tables: &[&SoaTable<F>], eq_xi: &[EF]) -> [Vec<EF>; 3] {
+        let h = tables[0].height;
+        self.round_evals_da_with(da, h, eq_xi, |t, c, bb| (tables[t].get(2 * bb, c), tables[t].get(2 * bb + 1, c)))
+    }
+
+    /// [`Self::round_evals_da`] for the first multilinear round straight from the base-field
+    /// trace (the univariate-skip fold is applied on the fly, so its Ext12 table is never
+    /// stored). `mats[t]` is input table t (selectors first), `cs` the skip-fold weights.
+    pub fn round_evals_da_ple(
+        &self,
+        da: &DaProgram<F>,
+        l_skip: usize,
+        mats: &[(&RowMajorMatrix<F>, bool)],
+        cs: &[EF],
+        eq_xi: &[EF],
+    ) -> [Vec<EF>; 3] {
+        let sk = 1usize << l_skip;
+        let h0 = {
+            let (m, _) = mats[0];
+            (m.values.len() / m.width).max(sk) >> l_skip
+        };
+        let wl = lanes::<F>();
+        let nb0 = h0 / wl;
+        let csb: Vec<Vec<P<F>>> = (0..D)
+            .map(|j| cs.iter().map(|c| P::<F>::from(coeffs::<F, EF>(c)[j])).collect())
+            .collect();
+        let val = |t: usize, c: usize, x_of: &dyn Fn(usize) -> usize| -> PE<P<F>> {
+            let (m, rot) = mats[t];
+            let height = m.values.len() / m.width;
+            let off = usize::from(rot);
+            let vz: Vec<P<F>> = (0..sk)
+                .map(|z| P::<F>::from_fn(|l| m.values[(((x_of(l) << l_skip) + z + off) % height) * m.width + c]))
+                .collect();
+            PE(core::array::from_fn(|j| {
+                if sk == 4 {
+                    P::<F>::dot_product::<4>(vz[..4].try_into().unwrap(), csb[j][..4].try_into().unwrap())
+                } else {
+                    let mut acc = P::<F>::ZERO;
+                    for z in 0..sk {
+                        acc += vz[z] * csb[j][z];
+                    }
+                    acc
+                }
+            }))
+        };
+        self.round_evals_da_with(da, h0, eq_xi, |t, c, bb| {
+            (val(t, c, &|l| l * nb0 + 2 * bb), val(t, c, &|l| l * nb0 + 2 * bb + 1))
+        })
+    }
+
+    fn round_evals_da_with(
+        &self,
+        da: &DaProgram<F>,
+        h: usize,
+        eq_xi: &[EF],
+        load: impl Fn(usize, usize, usize) -> (PE<P<F>>, PE<P<F>>) + Sync,
+    ) -> [Vec<EF>; 3] {
+        let d = da.d;
+        let wl = lanes::<F>();
+        let nb = h / wl;
+        let ny_blk = nb / 2;
+        let w = self.w;
+        struct St<Q> {
+            slots: Vec<PE<Q>>,
+            groups: Vec<PE<Q>>,
+            acc: Vec<PE<Q>>,
+            eqsum: PE<Q>,
+        }
+        let new_st = || St::<P<F>> {
+            slots: vec![PE::zero(); self.n_slots * d],
+            groups: vec![PE::zero(); 3 * (d + 1) * d],
+            acc: vec![PE::zero(); 3 * d],
+            eqsum: PE::zero(),
+        };
+        // extend v[0..b] (degree < b) to v[0..d] by finite differences (additions only)
+        fn extend<Q: p3_field::PackedField>(v: &mut [PE<Q>], b: usize, d: usize) {
+            if b >= d {
+                return;
+            }
+            if b == 1 {
+                for x in 1..d {
+                    v[x] = v[0];
+                }
+                return;
+            }
+            // difference table at the last base point: dt[j] = Δ^j v(b-1)
+            let mut dt: [PE<Q>; 10] = [PE::zero(); 10];
+            let mut row: [PE<Q>; 10] = [PE::zero(); 10];
+            row[..b].copy_from_slice(&v[..b]);
+            // dt[j] = backward difference of order j at the last point
+            for j in 0..b {
+                dt[j] = row[b - 1];
+                for i in (j + 1..b).rev() {
+                    row[i] = row[i].sub(&row[i - 1]);
+                }
+            }
+            // dt[j] now holds Δ^j at the last point (Δ^0 = v(b-1)); advance
+            for x in b..d {
+                for j in (0..b - 1).rev() {
+                    let t = dt[j].add(&dt[j + 1]);
+                    dt[j] = t;
+                }
+                v[x] = dt[0];
+            }
+        }
+        let fold_blk = |mut st: St<P<F>>, bb: usize| -> St<P<F>> {
+            for (i, &(t, c)) in self.inputs.iter().enumerate() {
+                let (lo, hi) = load(t, c, bb);
+                st.slots[i * d] = hi;
+                if d > 1 {
+                    st.slots[i * d + 1] = hi.add(&hi.sub(&lo));
+                }
+            }
+            let eq: PE<P<F>> = PE(core::array::from_fn(|j| {
+                P::<F>::from_fn(|l| coeffs::<F, EF>(&eq_xi[l * ny_blk + bb])[j])
+            }));
+            st.eqsum.add_assign(&eq);
+            for g in st.groups.iter_mut() {
+                *g = PE::zero();
+            }
+            let mut used_m = [[false; 11]; 3];
+            for ins in &da.ins {
+                match *ins {
+                    DIns::Mul { d: dd, a, b, m } => {
+                        for p in 0..m as usize {
+                            let v = st.slots[a as usize * d + p].mul(&st.slots[b as usize * d + p], w);
+                            st.slots[dd as usize * d + p] = v;
+                        }
+                    }
+                    DIns::Add { d: dd, a, b, m } => {
+                        for p in 0..m as usize {
+                            let v = st.slots[a as usize * d + p].add(&st.slots[b as usize * d + p]);
+                            st.slots[dd as usize * d + p] = v;
+                        }
+                    }
+                    DIns::Sub { d: dd, a, b, m } => {
+                        for p in 0..m as usize {
+                            let v = st.slots[a as usize * d + p].sub(&st.slots[b as usize * d + p]);
+                            st.slots[dd as usize * d + p] = v;
+                        }
+                    }
+                    DIns::Neg { d: dd, a, m } => {
+                        for p in 0..m as usize {
+                            let v = st.slots[a as usize * d + p].neg();
+                            st.slots[dd as usize * d + p] = v;
+                        }
+                    }
+                    DIns::MulC { d: dd, a, c, m } => {
+                        for p in 0..m as usize {
+                            let v = st.slots[a as usize * d + p].mul_scalar(c);
+                            st.slots[dd as usize * d + p] = v;
+                        }
+                    }
+                    DIns::AddC { d: dd, a, c, m } => {
+                        for p in 0..m as usize {
+                            let v = st.slots[a as usize * d + p].add_scalar(c);
+                            st.slots[dd as usize * d + p] = v;
+                        }
+                    }
+                    DIns::SubC { d: dd, a, c, m } => {
+                        for p in 0..m as usize {
+                            let v = st.slots[a as usize * d + p].add_scalar(-c);
+                            st.slots[dd as usize * d + p] = v;
+                        }
+                    }
+                    DIns::CSub { d: dd, a, c, m } => {
+                        for p in 0..m as usize {
+                            let v = st.slots[a as usize * d + p].neg().add_scalar(c);
+                            st.slots[dd as usize * d + p] = v;
+                        }
+                    }
+                    DIns::Ext { s, b } => {
+                        let o = s as usize * d;
+                        extend(&mut st.slots[o..o + d], b as usize, d);
+                    }
+                    DIns::Acc { f, a, k, m } => {
+                        let (f, m) = (f as usize, m as usize);
+                        used_m[f][m] = true;
+                        let g0 = (f * (d + 1) + m) * d;
+                        for p in 0..m {
+                            let v = self.coefs[k as usize].mul(&st.slots[a as usize * d + p]);
+                            st.groups[g0 + p].add_assign(&v);
+                        }
+                    }
+                }
+            }
+            for f in 0..3 {
+                if !self.used[f] {
+                    continue;
+                }
+                let mut tot = [PE::<P<F>>::zero(); 10];
+                for m in 1..=d {
+                    if !used_m[f][m] {
+                        continue;
+                    }
+                    let g0 = (f * (d + 1) + m) * d;
+                    extend(&mut st.groups[g0..g0 + d], m, d);
+                    for x in 0..d {
+                        tot[x].add_assign(&st.groups[g0 + x]);
+                    }
+                }
+                for x in 0..d {
+                    let v = eq.mul(&tot[x], w);
+                    st.acc[x * 3 + f].add_assign(&v);
+                }
+            }
+            st
+        };
+        let st = (0..ny_blk)
+            .into_par_iter()
+            .with_min_len(4)
+            .fold(new_st, fold_blk)
+            .reduce(new_st, |mut a, b| {
+                for (x, y) in a.acc.iter_mut().zip(&b.acc) {
+                    x.add_assign(y);
+                }
+                a.eqsum.add_assign(&b.eqsum);
+                a
+            });
+        let eqsum: EF = from_coeffs::<F, EF>(&st.eqsum.hsum());
+        let mut out: [Vec<EF>; 3] = [vec![EF::ZERO; d], vec![EF::ZERO; d], vec![EF::ZERO; d]];
+        for x in 0..d {
+            for f in 0..3 {
+                if self.used[f] {
+                    out[f][x] = from_coeffs::<F, EF>(&st.acc[x * 3 + f].hsum()) + self.konst[f] * eqsum;
+                }
+            }
+        }
+        out
+    }
+
+    /// Round polynomial evaluations at x = 1..=d: `[Σ_y eq(y) zc(x,y), Σ_y eq(y) numer, Σ_y eq(y) denom]`
+    /// (the latter two without the lifting normalisation), as `sumcheck_round_poly_evals_rm` with
+    /// the `acc_constraints` / `acc_interactions` closures.
+    pub fn round_evals(&self, tables: &[&SoaTable<F>], eq_xi: &[EF], d: usize) -> [Vec<EF>; 3] {
+        let h = tables[0].height;
+        debug_assert!(tables.iter().all(|t| t.height == h));
+        let wl = lanes::<F>();
+        let nb = h / wl;
+        let ny_blk = nb / 2;
+        let n_in = self.inputs.len();
+        struct St<Q> {
+            slots: Vec<PE<Q>>,
+            diff: Vec<PE<Q>>,
+            acc: Vec<PE<Q>>,
+            eqsum: PE<Q>,
+        }
+        let new_st = || St::<P<F>> {
+            slots: vec![PE::zero(); self.n_slots],
+            diff: vec![PE::zero(); n_in],
+            acc: vec![PE::zero(); 3 * d],
+            eqsum: PE::zero(),
+        };
+        let fold_blk = |mut st: St<P<F>>, bb: usize| -> St<P<F>> {
+            for (i, &(t, c)) in self.inputs.iter().enumerate() {
+                let lo = tables[t].get(2 * bb, c);
+                let hi = tables[t].get(2 * bb + 1, c);
+                st.diff[i] = hi.sub(&lo);
+                st.slots[i] = hi;
+            }
+            let eq: PE<P<F>> = PE(core::array::from_fn(|j| {
+                P::<F>::from_fn(|l| coeffs::<F, EF>(&eq_xi[l * ny_blk + bb])[j])
+            }));
+            st.eqsum.add_assign(&eq);
+            for x in 1..=d {
+                if x > 1 {
+                    for i in 0..n_in {
+                        let v = st.slots[i].add(&st.diff[i]);
+                        st.slots[i] = v;
+                    }
+                }
+                let mut fsum = [PE::zero(); 3];
+                self.run(&mut st.slots, &mut fsum);
+                for f in 0..3 {
+                    if self.used[f] {
+                        let v = eq.mul(&fsum[f], self.w);
+                        st.acc[(x - 1) * 3 + f].add_assign(&v);
+                    }
+                }
+            }
+            st
+        };
+        let st = (0..ny_blk)
+            .into_par_iter()
+            .with_min_len(4)
+            .fold(new_st, fold_blk)
+            .reduce(new_st, |mut a, b| {
+                for (x, y) in a.acc.iter_mut().zip(&b.acc) {
+                    x.add_assign(y);
+                }
+                a.eqsum.add_assign(&b.eqsum);
+                a
+            });
+        let eqsum: EF = from_coeffs::<F, EF>(&st.eqsum.hsum());
+        let mut out: [Vec<EF>; 3] = [vec![EF::ZERO; d], vec![EF::ZERO; d], vec![EF::ZERO; d]];
+        for x in 0..d {
+            for f in 0..3 {
+                if self.used[f] {
+                    out[f][x] = from_coeffs::<F, EF>(&st.acc[x * 3 + f].hsum()) + self.konst[f] * eqsum;
+                }
+            }
+        }
+        out
+    }
+}
