+//! [pq-cpu-prover] Fractional-sum GKR (LogUp) prover, byte-identical to
+//! `fractional_sumcheck_with`.
+//!
+//! Differences from the original, none of which changes a transcript value:
+//! * the input layer keeps the numerators in the base field (`p` are trace counts), so its tree
+//!   level and its first sumcheck use Ext12 × base products;
+//! * layers are stored separately (no 2N segment tree plus a copy of the input, no per-layer
+//!   column copy): a layer's first sumcheck round reads the stored layer directly and writes the
+//!   folded table at half size;
+//! * the eq factor is split off (Gruen): `s(X) = A · eq(ξ_i, X) · t(X)` with
+//!   `t(X) = Σ_y eq(ξ_{>i}, y) g(X, y)` of degree 2, so per pair only `t(0), t(1), t(2)` are
+//!   evaluated, no eq column is interpolated or folded, and `s(1..3)` follow exactly;
+//! * interpolation at X = 1, 2 uses additions only;
+//! * all Ext12 arithmetic runs 16 pairs at a time in packed SoA form.
+
+use openvm_stark_backend::{
+    proof::GkrLayerClaims,
+    prover::{
+        error::LogupZerocheckError,
+        fractional_sumcheck_gkr::FracSumcheckProof,
+    },
+    FiatShamirTranscript, StarkProtocolConfig,
+};
+use p3_field::{ExtensionField, Field, PackedField, PackedValue, PrimeCharacteristicRing};
+use p3_maybe_rayon::prelude::*;
+
+use super::pext::{coeffs, from_coeffs, PreMul, PE};
+
+/// Base-field-numerator input layer: `(p[i], q[i])`, `q` already includes `alpha`.
+pub struct InputLayer<F, EF> {
+    pub p: Vec<F>,
+    pub q: Vec<EF>,
+}
+
+#[derive(Clone, Copy, Default)]
+struct FracE<EF> {
+    p: EF,
+    q: EF,
+}
+
+#[inline(always)]
+fn gather<F: Field, EF: ExtensionField<F>, Q: PackedField<Scalar = F>>(f: impl Fn(usize) -> EF) -> PE<Q> {
+    let vals: Vec<EF> = (0..Q::WIDTH).map(&f).collect();
+    PE(core::array::from_fn(|j| Q::from_fn(|l| coeffs::<F, EF>(&vals[l])[j])))
+}
+
+#[inline(always)]
+fn scatter<F: Field, EF: ExtensionField<F>, Q: PackedField<Scalar = F>>(v: &PE<Q>, mut f: impl FnMut(usize, EF)) {
+    for l in 0..Q::WIDTH {
+        f(l, from_coeffs::<F, EF>(&v.lane(l)));
+    }
+}
+
+/// One tree level above the input: out[x] = in[2x] + in[2x+1].
+fn level_from_input<F: Field, EF: ExtensionField<F>>(inp: &InputLayer<F, EF>, w: F) -> Vec<FracE<EF>> {
+    let n = inp.p.len() / 2;
+    let mut out = vec![FracE::<EF>::default(); n];
+    let lanes = <F::Packing as PackedValue>::WIDTH;
+    if n >= lanes && n % lanes == 0 {
+        out.par_chunks_mut(lanes).enumerate().for_each(|(b, o)| {
+            let x0 = b * lanes;
+            let q0: PE<F::Packing> = gather(|l| inp.q[2 * (x0 + l)]);
+            let q1: PE<F::Packing> = gather(|l| inp.q[2 * (x0 + l) + 1]);
+            let p0 = F::Packing::from_fn(|l| inp.p[2 * (x0 + l)]);
+            let p1 = F::Packing::from_fn(|l| inp.p[2 * (x0 + l) + 1]);
+            let p = q1.mul_base(p0).add(&q0.mul_base(p1));
+            let q = q0.mul(&q1, w);
+            scatter(&p, |l, v: EF| o[l].p = v);
+            scatter(&q, |l, v: EF| o[l].q = v);
+        });
+    } else {
+        for x in 0..n {
+            let (p0, p1, q0, q1) = (inp.p[2 * x], inp.p[2 * x + 1], inp.q[2 * x], inp.q[2 * x + 1]);
+            out[x] = FracE { p: q1 * p0 + q0 * p1, q: q0 * q1 };
+        }
+    }
+    out
+}
+
+fn level_up<F: Field, EF: ExtensionField<F>>(lay: &[FracE<EF>], w: F) -> Vec<FracE<EF>> {
+    let n = lay.len() / 2;
+    let mut out = vec![FracE::<EF>::default(); n];
+    let lanes = <F::Packing as PackedValue>::WIDTH;
+    if n >= lanes && n % lanes == 0 {
+        out.par_chunks_mut(lanes).enumerate().for_each(|(b, o)| {
+            let x0 = b * lanes;
+            let p0: PE<F::Packing> = gather(|l| lay[2 * (x0 + l)].p);
+            let q0: PE<F::Packing> = gather(|l| lay[2 * (x0 + l)].q);
+            let p1: PE<F::Packing> = gather(|l| lay[2 * (x0 + l) + 1].p);
+            let q1: PE<F::Packing> = gather(|l| lay[2 * (x0 + l) + 1].q);
+            let p = p0.mul(&q1, w).add(&q0.mul(&p1, w));
+            let q = q0.mul(&q1, w);
+            scatter(&p, |l, v: EF| o[l].p = v);
+            scatter(&q, |l, v: EF| o[l].q = v);
+        });
+    } else {
+        for x in 0..n {
+            let (a, b) = (lay[2 * x], lay[2 * x + 1]);
+            // Frac add: p = a.p * b.q + a.q * b.p
+            out[x] = FracE { p: a.p * b.q + a.q * b.p, q: a.q * b.q };
+        }
+    }
+    out
+}
+
+/// eq(ξ_{lo..}, y) for y over `xi.len()` bits, bit k <-> xi[k].
+fn eq_table<EF: Field>(xi: &[EF]) -> Vec<EF> {
+    let mut out = vec![EF::ZERO; 1 << xi.len()];
+    out[0] = EF::ONE;
+    for (i, &x) in xi.iter().enumerate() {
+        let (lo, hi) = out[..2 << i].split_at_mut(1 << i);
+        lo.par_iter_mut().zip(hi.par_iter_mut()).for_each(|(l, h)| {
+            *h = *l * x;
+            *l *= EF::ONE - x;
+        });
+    }
+    out
+}
+
+/// Values of the four columns (p0, q0, p1, q1) at the pair (2y, 2y+1) for 16 (or 1) y's, as
+/// packed values. `p` may be base-field (input layer).
+enum PVal<Q: PackedField> {
+    B(Q),
+    E(PE<Q>),
+}
+
+impl<Q: PackedField> PVal<Q> {
+    #[inline(always)]
+    fn mul_e(&self, q: &PE<Q>, w: Q::Scalar) -> PE<Q> {
+        match self {
+            PVal::B(b) => q.mul_base(*b),
+            PVal::E(e) => e.mul(q, w),
+        }
+    }
+    #[inline(always)]
+    fn interp2(lo: &Self, hi: &Self) -> Self {
+        // value at X = 2: 2 hi - lo
+        match (lo, hi) {
+            (PVal::B(a), PVal::B(b)) => PVal::B(b.double() - *a),
+            (PVal::E(a), PVal::E(b)) => PVal::E(b.add(b).sub(a)),
+            _ => unreachable!(),
+        }
+    }
+    #[inline(always)]
+    fn to_pe(&self) -> PE<Q> {
+        match self {
+            PVal::B(b) => {
+                let mut r = PE::zero();
+                r.0[0] = *b;
+                r
+            }
+            PVal::E(e) => *e,
+        }
+    }
+}
+
+/// Table source of a sumcheck round.
+enum Tab<'a, F, EF> {
+    /// first round of the input layer
+    Input(&'a InputLayer<F, EF>),
+    /// first round of a stored layer
+    Layer(&'a [FracE<EF>]),
+    /// folded table, entries (p0, q0, p1, q1) per x
+    Folded(&'a [[EF; 4]]),
+}
+
+impl<F: Field, EF: ExtensionField<F>> Tab<'_, F, EF> {
+    fn len(&self) -> usize {
+        match self {
+            Tab::Input(i) => i.p.len() / 2,
+            Tab::Layer(l) => l.len() / 2,
+            Tab::Folded(f) => f.len(),
+        }
+    }
+    /// (p0, q0, p1, q1) at x for lanes x = x_of(l)
+    #[inline(always)]
+    fn load<Q: PackedField<Scalar = F>>(&self, x_of: impl Fn(usize) -> usize) -> [PVal<Q>; 4] {
+        match self {
+            Tab::Input(i) => [
+                PVal::B(Q::from_fn(|l| i.p[2 * x_of(l)])),
+                PVal::E(gather(|l| i.q[2 * x_of(l)])),
+                PVal::B(Q::from_fn(|l| i.p[2 * x_of(l) + 1])),
+                PVal::E(gather(|l| i.q[2 * x_of(l) + 1])),
+            ],
+            Tab::Layer(lay) => [
+                PVal::E(gather(|l| lay[2 * x_of(l)].p)),
+                PVal::E(gather(|l| lay[2 * x_of(l)].q)),
+                PVal::E(gather(|l| lay[2 * x_of(l) + 1].p)),
+                PVal::E(gather(|l| lay[2 * x_of(l) + 1].q)),
+            ],
+            Tab::Folded(f) => core::array::from_fn(|c| PVal::E(gather(|l| f[x_of(l)][c]))),
+        }
+    }
+}
+
+/// One sumcheck round over the table: returns (Σ_y E(y) pp(X,y), Σ_y E(y) qq(X,y)) for X = 0,1,2
+/// and the folded table at `r` (computed in a second pass once `r` is known).
+fn round_sums<F: Field, EF: ExtensionField<F>>(tab: &Tab<'_, F, EF>, e: &[EF], w: F) -> [[EF; 2]; 3] {
+    let npairs = tab.len() / 2;
+    debug_assert_eq!(e.len(), npairs);
+    fn run<F: Field, EF: ExtensionField<F>, Q: PackedField<Scalar = F>>(
+        tab: &Tab<'_, F, EF>,
+        e: &[EF],
+        w: F,
+        nblk: usize,
+    ) -> [[EF; 2]; 3] {
+        let wl = Q::WIDTH;
+        let acc = (0..nblk)
+            .into_par_iter()
+            .with_min_len(16)
+            .fold(
+                || [PE::<Q>::zero(); 6],
+                |mut acc, b| {
+                    let y0 = b * wl;
+                    let lo = tab.load::<Q>(|l| 2 * (y0 + l));
+                    let hi = tab.load::<Q>(|l| 2 * (y0 + l) + 1);
+                    let ev: PE<Q> = gather(|l| e[y0 + l]);
+                    for xx in 0..3 {
+                        let v: [PVal<Q>; 4] = match xx {
+                            0 => lo.each_ref().map(|v| match v {
+                                PVal::B(b) => PVal::B(*b),
+                                PVal::E(x) => PVal::E(*x),
+                            }),
+                            1 => hi.each_ref().map(|v| match v {
+                                PVal::B(b) => PVal::B(*b),
+                                PVal::E(x) => PVal::E(*x),
+                            }),
+                            _ => core::array::from_fn(|c| PVal::interp2(&lo[c], &hi[c])),
+                        };
+                        let q0 = v[1].to_pe();
+                        let q1 = v[3].to_pe();
+                        let pp = v[0].mul_e(&q1, w).add(&v[2].mul_e(&q0, w));
+                        let qq = q0.mul(&q1, w);
+                        acc[2 * xx].add_assign(&ev.mul(&pp, w));
+                        acc[2 * xx + 1].add_assign(&ev.mul(&qq, w));
+                    }
+                    acc
+                },
+            )
+            .reduce(
+                || [PE::<Q>::zero(); 6],
+                |mut a, b| {
+                    for i in 0..6 {
+                        a[i].add_assign(&b[i]);
+                    }
+                    a
+                },
+            );
+        core::array::from_fn(|xx| core::array::from_fn(|k| from_coeffs::<F, EF>(&acc[2 * xx + k].hsum())))
+    }
+    let lanes = <F::Packing as PackedValue>::WIDTH;
+    if npairs >= lanes && npairs % lanes == 0 {
+        run::<F, EF, F::Packing>(tab, e, w, npairs / lanes)
+    } else {
+        run::<F, EF, F>(tab, e, w, npairs)
+    }
+}
+
+fn fold_tab<F: Field, EF: ExtensionField<F>>(tab: &Tab<'_, F, EF>, r: EF, w: F) -> Vec<[EF; 4]> {
+    let nout = tab.len() / 2;
+    let mut out = vec![[EF::ZERO; 4]; nout];
+    let lanes = <F::Packing as PackedValue>::WIDTH;
+    if nout >= lanes && nout % lanes == 0 {
+        let rp = PreMul::<F::Packing>::new(coeffs::<F, EF>(&r), w);
+        out.par_chunks_mut(lanes).enumerate().for_each(|(b, o)| {
+            let y0 = b * lanes;
+            let lo = tab.load::<F::Packing>(|l| 2 * (y0 + l));
+            let hi = tab.load::<F::Packing>(|l| 2 * (y0 + l) + 1);
+            for c in 0..4 {
+                let (a, bb) = (lo[c].to_pe(), hi[c].to_pe());
+                let v = a.add(&rp.mul(&bb.sub(&a)));
+                scatter(&v, |l, x: EF| o[l][c] = x);
+            }
+        });
+    } else {
+        for y in 0..nout {
+            let lo = tab.load::<F>(|_| 2 * y);
+            let hi = tab.load::<F>(|_| 2 * y + 1);
+            for c in 0..4 {
+                let a: EF = from_coeffs::<F, EF>(&lo[c].to_pe().lane(0));
+                let b: EF = from_coeffs::<F, EF>(&hi[c].to_pe().lane(0));
+                out[y][c] = a + (b - a) * r;
+            }
+        }
+    }
+    out
+}
+
+#[inline(always)]
+fn eq1<EF: Field>(xi: EF, x: EF) -> EF {
+    // eq(xi, x) = (1 - xi)(1 - x) + xi x
+    (EF::ONE - xi) * (EF::ONE - x) + xi * x
+}
+
+/// Byte-identical replacement of `fractional_sumcheck_with` for a base-numerator input layer.
+#[tracing::instrument(level = "info", skip_all)]
+pub fn fractional_sumcheck_fast<SC: StarkProtocolConfig, TS: FiatShamirTranscript<SC>>(
+    transcript: &mut TS,
+    input: InputLayer<SC::F, SC::EF>,
+    assert_zero: bool,
+    gruen: bool,
+    w: SC::F,
+) -> Result<(FracSumcheckProof<SC>, Vec<SC::EF>), LogupZerocheckError> {
+    type EF<SC> = <SC as StarkProtocolConfig>::EF;
+    let n_in = input.p.len();
+    let total_rounds = p3_util::log2_strict_usize(n_in);
+    assert!(total_rounds >= 1);
+    // layers[k] has 2^k entries, k = 0..total_rounds-1 (the input is layer total_rounds)
+    let mut layers: Vec<Vec<FracE<EF<SC>>>> = vec![vec![]; total_rounds];
+    layers[total_rounds - 1] = level_from_input(&input, w);
+    for k in (0..total_rounds - 1).rev() {
+        layers[k] = level_up(&layers[k + 1], w);
+    }
+    openvm_stark_backend::prover::stream_pcs::memprof("gkr.layers_built");
+    let frac_sum = layers[0][0];
+    if assert_zero {
+        if frac_sum.p != EF::<SC>::ZERO {
+            return Err(LogupZerocheckError::NonZeroRootSum);
+        }
+    } else {
+        transcript.observe_ext(frac_sum.p);
+    }
+    transcript.observe_ext(frac_sum.q);
+
+    let mut claims_per_layer: Vec<GkrLayerClaims<SC>> = Vec::with_capacity(total_rounds);
+    let mut sumcheck_polys: Vec<Vec<[EF<SC>; 3]>> = Vec::with_capacity(total_rounds);
+    let l1 = if total_rounds == 1 {
+        // layer 1 is the input itself
+        let e = |i: usize| FracE { p: EF::<SC>::from(input.p[i]), q: input.q[i] };
+        vec![e(0), e(1)]
+    } else {
+        layers[1].clone()
+    };
+    claims_per_layer.push(GkrLayerClaims::<SC> {
+        p_xi_0: l1[0].p,
+        q_xi_0: l1[0].q,
+        p_xi_1: l1[1].p,
+        q_xi_1: l1[1].q,
+    });
+    transcript.observe_ext(claims_per_layer[0].p_xi_0);
+    transcript.observe_ext(claims_per_layer[0].q_xi_0);
+    transcript.observe_ext(claims_per_layer[0].p_xi_1);
+    transcript.observe_ext(claims_per_layer[0].q_xi_1);
+    let mu_1 = transcript.sample_ext();
+    let mut xi_prev = vec![mu_1];
+    // layers 0 and 1 are no longer needed
+    layers[0] = vec![];
+    if total_rounds > 1 {
+        layers[1] = vec![];
+    }
+
+    for round in 1..total_rounds {
+        let lambda = transcript.sample_ext();
+        let n = round;
+        let seg_layer = round + 1;
+        let mut round_polys_eval = Vec::with_capacity(n);
+        let mut r_vec = Vec::with_capacity(n);
+        let mut folded: Vec<[EF<SC>; 4]> = vec![];
+        let seg = if seg_layer < total_rounds { std::mem::take(&mut layers[seg_layer]) } else { vec![] };
+        let mut a_acc = EF::<SC>::ONE;
+        for sr in 0..n {
+            let tab: Tab<'_, SC::F, EF<SC>> = if sr == 0 {
+                if seg_layer == total_rounds {
+                    Tab::Input(&input)
+                } else {
+                    Tab::Layer(&seg)
+                }
+            } else {
+                Tab::Folded(&folded)
+            };
+            let xi = xi_prev[sr];
+            let e = eq_table(&xi_prev[sr + 1..]);
+            let sums = round_sums(&tab, &e, w);
+            drop(e);
+            let t: [EF<SC>; 3] = core::array::from_fn(|k| sums[k][0] + lambda * sums[k][1]);
+            let t3 = t[0] - t[1].double() - t[1] + t[2].double() + t[2];
+            let tv = [t[1], t[2], t3];
+            let mut s_evals: [EF<SC>; 3] =
+                core::array::from_fn(|k| a_acc * eq1(xi, EF::<SC>::from_usize(k + 1)) * tv[k]);
+            if gruen {
+                s_evals[2] = EF::<SC>::ZERO;
+            }
+            for &eval in &s_evals[..if gruen { 2 } else { 3 }] {
+                transcript.observe_ext(eval);
+            }
+            round_polys_eval.push(s_evals);
+            let r_round = transcript.sample_ext();
+            let new_folded = fold_tab(&tab, r_round, w);
+            drop(tab);
+            folded = new_folded;
+            a_acc *= eq1(xi, r_round);
+            r_vec.push(r_round);
+        }
+        drop(seg);
+        debug_assert_eq!(folded.len(), 1);
+        let c = folded[0];
+        claims_per_layer.push(GkrLayerClaims::<SC> { p_xi_0: c[0], q_xi_0: c[1], p_xi_1: c[2], q_xi_1: c[3] });
+        transcript.observe_ext(claims_per_layer[round].p_xi_0);
+        transcript.observe_ext(claims_per_layer[round].q_xi_0);
+        transcript.observe_ext(claims_per_layer[round].p_xi_1);
+        transcript.observe_ext(claims_per_layer[round].q_xi_1);
+        let mu = transcript.sample_ext();
+        xi_prev = [vec![mu], r_vec].concat();
+        sumcheck_polys.push(round_polys_eval);
+    }
+    drop(input);
+    Ok((
+        FracSumcheckProof { fractional_sum: (frac_sum.p, frac_sum.q), claims_per_layer, sumcheck_polys },
+        xi_prev,
+    ))
+}
+
+/// Placement of one interaction's column in the stacked LogUp input: rows `[row_idx, row_idx+len)`
+/// hold the trace's values repeated cyclically (len / height times), numerators scaled by `norm`.
+pub struct Placement<F> {
+    pub interaction: usize,
+    pub row_idx: usize,
+    pub len: usize,
+    pub norm: F,
+}
+
+struct SyncPtr<T>(*mut T);
+unsafe impl<T> Send for SyncPtr<T> {}
+unsafe impl<T> Sync for SyncPtr<T> {}
+impl<T> SyncPtr<T> {
+    #[inline(always)]
+    fn get(&self) -> *mut T {
+        self.0
+    }
+}
+
+/// The LogUp input layer from the traces (`eval_interactions` per row, written in stacked order),
+/// `q += alpha` everywhere, packed over rows. `prog` has functionals `[raw count_i, denom_i]` per
+/// interaction i (see `gkr_input_specs`).
+#[tracing::instrument(level = "info", skip_all)]
+pub fn fill_input_layer<F: Field, EF: ExtensionField<F>>(
+    layer: &mut InputLayer<F, EF>,
+    prog: &super::zc::Program<F, EF>,
+    mats: &[(&p3_matrix::dense::RowMajorMatrix<F>, bool)],
+    height: usize,
+    placements: &[Placement<F>],
+) {
+    type P<F> = <F as Field>::Packing;
+    let wl = <P<F> as PackedValue>::WIDTH;
+    assert!(height % wl == 0);
+    let nb = height / wl;
+    let inputs = prog.inputs();
+    let nf = prog.num_funcs();
+    let pp = SyncPtr(layer.p.as_mut_ptr());
+    let qp = SyncPtr(layer.q.as_mut_ptr());
+    let konst: Vec<PE<P<F>>> = prog.konst.iter().map(|k| PE::broadcast(coeffs::<F, EF>(k))).collect();
+    let heights: Vec<usize> = mats.iter().map(|(m, _)| m.values.len() / m.width).collect();
+    (0..nb).into_par_iter().for_each_init(
+        || (vec![P::<F>::ZERO; prog.n_slots()], vec![PE::<P<F>>::zero(); nf], vec![P::<F>::ZERO; nf]),
+        |(slots, fsum, raw), b| {
+            let r0 = b * wl;
+            for (i, &(t, c)) in inputs.iter().enumerate() {
+                slots[i] = if t == 0 {
+                    P::<F>::from_fn(|l| {
+                        let row = r0 + l;
+                        F::from_bool(match c {
+                            0 => row == 0,
+                            1 => row != height - 1,
+                            _ => row == height - 1,
+                        })
+                    })
+                } else {
+                    let (m, rot) = mats[t - 1];
+                    let h = heights[t - 1];
+                    let off = usize::from(rot);
+                    P::<F>::from_fn(|l| m.values[((r0 + l + off) % h) * m.width + c])
+                };
+            }
+            fsum.copy_from_slice(&konst);
+            prog.run_base(slots, fsum, raw);
+            for &(f, v) in &prog.raw_const {
+                raw[f] = P::<F>::from(v);
+            }
+            for pl in placements {
+                let pv = raw[2 * pl.interaction] * pl.norm;
+                let dv = &fsum[2 * pl.interaction + 1];
+                for l in 0..wl {
+                    let pval = pv.as_slice()[l];
+                    let qval: EF = from_coeffs::<F, EF>(&dv.lane(l));
+                    let mut pos = pl.row_idx + r0 + l;
+                    while pos < pl.row_idx + pl.len {
+                        // SAFETY: placements are disjoint row ranges; each position is written by
+                        // exactly one (block, lane, repetition).
+                        unsafe {
+                            *pp.get().add(pos) = pval;
+                            let q = &mut *qp.get().add(pos);
+                            *q += qval;
+                        }
+                        pos += height;
+                    }
+                }
+            }
+        },
+    );
+}
+
+/// Functionals of the LogUp input: `[count_i (raw), Σ_j β^j msg_ij + β^len (bus_i + 1)]`.
+pub fn gkr_input_specs<F: Field, EF: ExtensionField<F>>(
+    interactions: &[openvm_stark_backend::interaction::Interaction<usize>],
+    beta_pows: &[EF],
+) -> Vec<super::zc::FuncSpec<EF>> {
+    let mut v = vec![];
+    for int in interactions {
+        v.push(super::zc::FuncSpec { terms: vec![(int.count, EF::ONE)], konst: EF::ZERO, raw: true });
+        let b = F::from_u32(int.bus_index as u32 + 1);
+        v.push(super::zc::FuncSpec {
+            terms: int.message.iter().enumerate().map(|(j, &m)| (m, beta_pows[j])).collect(),
+            konst: beta_pows[int.message.len()] * b,
+            raw: false,
+        });
+    }
+    v
+}
