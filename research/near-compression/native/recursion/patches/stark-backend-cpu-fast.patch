+//! [pq-cpu-prover] Cache-blocked ("four-step") coset DFT of a wide row-major matrix.
+//!
+//! For n = n1 * n2 rows, j = j1 + n1 j2 and k = k2 + n2 k1:
+//!   X[k] = sum_j s^j x[j] w^(jk)
+//!        = sum_j1 w_n1^(j1 k1) * w^(j1 k2) * [ sum_j2 w_n2^(j2 k2) * s^j x[j1 + n1 j2] ].
+//! Step 1 runs n1 DFTs of size n2 on gathered, twisted rows (each block fits in L2), applies the
+//! twiddles w^(j1 k2) and stores the results transposed; step 2 runs n2 DFTs of size n1 on
+//! contiguous blocks and scatters to natural order. The small DFTs are radix-2
+//! decimation-in-frequency on whole rows (SIMD across columns) with precomputed twiddles; their
+//! bit-reversed outputs are absorbed into the transposed store and the final scatter, so there
+//! is no bit-reversal pass. Two passes over memory instead of log2(n).
+//! A DFT is a fixed linear map, so the output equals any other exact implementation's.
+
+use p3_dft::{Radix2Dit, TwoAdicSubgroupDft};
+use p3_field::{Field, PackedValue, TwoAdicField};
+use p3_matrix::dense::RowMajorMatrix;
+use p3_maybe_rayon::prelude::*;
+use p3_util::{log2_strict_usize, reverse_bits_len};
+
+struct SyncPtr<T>(*mut T);
+unsafe impl<T> Send for SyncPtr<T> {}
+unsafe impl<T> Sync for SyncPtr<T> {}
+impl<T> SyncPtr<T> {
+    #[inline(always)]
+    fn get(&self) -> *mut T {
+        self.0
+    }
+}
+
+/// tw[l][i] = w_(2^(l+1))^i for i < 2^l (twiddles of the DIF stage with half size 2^l).
+fn twiddles<F: TwoAdicField>(log_n: usize) -> Vec<Vec<F>> {
+    (0..log_n)
+        .map(|l| F::two_adic_generator(l + 1).powers().take(1 << l).collect())
+        .collect()
+}
+
+#[inline(always)]
+fn scale_row<F: Field>(row: &mut [F], t: F) {
+    let (p, s) = F::Packing::pack_slice_with_suffix_mut(row);
+    let tp = F::Packing::from(t);
+    for x in p.iter_mut() {
+        *x *= tp;
+    }
+    for x in s.iter_mut() {
+        *x *= t;
+    }
+}
+
+/// In-place radix-2 DIF DFT of the 2^log_n rows of `buf` (row-major, `width` columns); the
+/// result is in bit-reversed row order.
+fn dif_rows<F: Field>(buf: &mut [F], width: usize, log_n: usize, tw: &[Vec<F>]) {
+    for l in (0..log_n).rev() {
+        let h = 1usize << l;
+        let t = &tw[l];
+        for block in buf.chunks_exact_mut(2 * h * width) {
+            let (top, bot) = block.split_at_mut(h * width);
+            for i in 0..h {
+                let ru = &mut top[i * width..(i + 1) * width];
+                let rv = &mut bot[i * width..(i + 1) * width];
+                let (pu, su) = F::Packing::pack_slice_with_suffix_mut(ru);
+                let (pv, sv) = F::Packing::pack_slice_with_suffix_mut(rv);
+                if i == 0 {
+                    for (a, b) in pu.iter_mut().zip(pv.iter_mut()) {
+                        let (x, y) = (*a, *b);
+                        *a = x + y;
+                        *b = x - y;
+                    }
+                    for (a, b) in su.iter_mut().zip(sv.iter_mut()) {
+                        let (x, y) = (*a, *b);
+                        *a = x + y;
+                        *b = x - y;
+                    }
+                } else {
+                    let w = t[i];
+                    let wp = F::Packing::from(w);
+                    for (a, b) in pu.iter_mut().zip(pv.iter_mut()) {
+                        let (x, y) = (*a, *b);
+                        *a = x + y;
+                        *b = (x - y) * wp;
+                    }
+                    for (a, b) in su.iter_mut().zip(sv.iter_mut()) {
+                        let (x, y) = (*a, *b);
+                        *a = x + y;
+                        *b = (x - y) * w;
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Coset DFT (evaluations at `shift * w_n^k`, natural order) of each column of the row-major
+/// `n x width` matrix `coeffs`.
+pub fn coset_dft_rows<F: TwoAdicField>(coeffs: &[F], width: usize, shift: F) -> Vec<F> {
+    let n = coeffs.len() / width;
+    let log_n = log2_strict_usize(n);
+    if log_n < 12 {
+        let m = RowMajorMatrix::new(coeffs.to_vec(), width);
+        return Radix2Dit::<F>::default().coset_dft_batch(m, shift).values;
+    }
+    let l1 = log_n / 2;
+    let l2 = log_n - l1;
+    let (n1, n2) = (1usize << l1, 1usize << l2);
+    let tw1 = twiddles::<F>(l1);
+    let tw2 = twiddles::<F>(l2);
+    let w_n = F::two_adic_generator(log_n);
+    let s_n1 = shift.exp_u64(n1 as u64);
+    // y[k2 * n1 + j1] (rows), the transposed intermediate
+    let mut y = F::zero_vec(n * width);
+    let yp = SyncPtr(y.as_mut_ptr());
+    (0..n1).into_par_iter().for_each_init(
+        || F::zero_vec(n2 * width),
+        |buf, j1| {
+            // gather rows j1 + n1 j2, twisted by s^(j1 + n1 j2) = s^j1 (s^n1)^j2
+            let mut tw = shift.exp_u64(j1 as u64);
+            for j2 in 0..n2 {
+                let src = &coeffs[(j1 + n1 * j2) * width..(j1 + n1 * j2 + 1) * width];
+                let dst = &mut buf[j2 * width..(j2 + 1) * width];
+                dst.copy_from_slice(src);
+                scale_row(dst, tw);
+                tw *= s_n1;
+            }
+            dif_rows(buf, width, l2, &tw2);
+            // position p holds k2 = bitrev(p): twiddle w^(j1 k2), store transposed
+            let wj = w_n.exp_u64(j1 as u64);
+            let pw: Vec<F> = wj.powers().take(n2).collect();
+            for p in 0..n2 {
+                let k2 = reverse_bits_len(p, l2);
+                let row = &mut buf[p * width..(p + 1) * width];
+                if k2 > 0 && j1 > 0 {
+                    scale_row(row, pw[k2]);
+                }
+                // SAFETY: (k2, j1) cells are written by exactly one task (j1)
+                unsafe {
+                    std::ptr::copy_nonoverlapping(row.as_ptr(), yp.get().add((k2 * n1 + j1) * width), width);
+                }
+            }
+        },
+    );
+    let mut x = F::zero_vec(n * width);
+    let xp = SyncPtr(x.as_mut_ptr());
+    let y = &y;
+    (0..n2).into_par_iter().for_each_init(
+        || F::zero_vec(n1 * width),
+        |buf, k2| {
+            buf.copy_from_slice(&y[k2 * n1 * width..(k2 + 1) * n1 * width]);
+            dif_rows(buf, width, l1, &tw1);
+            for p in 0..n1 {
+                let k1 = reverse_bits_len(p, l1);
+                // SAFETY: output row k2 + n2 k1 is written by exactly one task (k2)
+                unsafe {
+                    std::ptr::copy_nonoverlapping(
+                        buf[p * width..(p + 1) * width].as_ptr(),
+                        xp.get().add((k2 + n2 * k1) * width),
+                        width,
+                    );
+                }
+            }
+        },
+    );
+    x
+}
