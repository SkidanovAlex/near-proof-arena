+/// [pq-cpu-prover] Like `leaf_batch_rows`, flat `[leaf][row][base coordinate]`; returns the row length.
+fn leaf_batch_flat<F: p3_field::Field, EF: p3_field::ExtensionField<F>>(
+    matrix: &ColMajorMatrix<EF>,
+    leaves: std::ops::Range<usize>,
+    rows_per_query: usize,
+    row_of: impl Fn(usize, usize) -> usize,
+) -> (Vec<F>, usize) {
+    let w = matrix.width();
+    let h = matrix.height();
+    let d = EF::DIMENSION;
+    let rl = w * d;
+    let mut out = vec![F::ZERO; leaves.len() * rows_per_query * rl];
+    for c in 0..w {
+        let col = &matrix.values[c * h..(c + 1) * h];
+        for (li, leaf) in leaves.clone().enumerate() {
+            for t in 0..rows_per_query {
+                let r = row_of(leaf, t);
+                if r < h {
+                    let o = (li * rows_per_query + t) * rl + c * d;
+                    out[o..o + d].copy_from_slice(col[r].as_basis_coefficients_slice());
+                }
+            }
+        }
+    }
+    (out, rl)
+}
