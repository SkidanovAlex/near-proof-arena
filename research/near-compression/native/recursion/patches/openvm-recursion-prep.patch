+            let (mut n, mut both_reject, mut both_accept) = (0, 0, 0);
+            for k in 0.. {
+                let mut bad = proof.clone();
+                let Some(label) = mutate_elem(&mut bad, k) else { break };
+                n += 1;
+                let mut t = ShaTranscript::default();
