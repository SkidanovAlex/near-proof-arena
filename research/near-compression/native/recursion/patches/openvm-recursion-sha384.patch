+
+pub fn limbs3(x: u64) -> [u64; 3] {
+    std::array::from_fn(|i| (x >> LIMB_OFF[i]) & ((1u64 << (LIMB_OFF[i + 1] - LIMB_OFF[i])) - 1))
+}
+
+/// Control-table entry for table index i in [0, 64): (r, flags..., K0 limbs, K1 limbs).
+/// Indices >= 44 all describe the padding row (r = 44, every flag 0).
+pub fn ctl_entry(i: usize) -> [u64; CTL_FIELDS] {
+    let mut e = [0u64; CTL_FIELDS];
+    if i >= ROWS {
+        e[0] = PAD_R as u64;
+        return e;
+    }
+    let f = |lo: usize, hi: usize| (lo..=hi).contains(&i) as u64;
+    e[0] = i as u64;
+    e[1] = f(0, 1); // f_iv
+    e[2] = f(2, 41); // f_round
+    e[3] = f(10, 41); // f_sched
+    e[4] = f(42, 43); // f_out
+    e[5] = f(40, 41); // f_fin: rows whose words feed the feed-forward
+    e[6] = f(2, 33); // f_s01: senders of V0/V1 (received 8 rows later)
+    e[7] = f(6, 37); // f_s2: senders of W[t-7] for slot 0 (4 rows later)
+    e[8] = f(7, 38); // f_s3: senders of W[t-7] for slot 1 (3 rows later)
+    if e[2] == 1 {
+        e[9..12].copy_from_slice(&limbs3(K[2 * i - 4]));
+        e[12..15].copy_from_slice(&limbs3(K[2 * i - 3]));
+    }
+    e
+}
+
+fn xor2<E: PrimeCharacteristicRing + Clone>(x: &E, y: &E) -> E {
+    x.clone() + y.clone() - (x.clone() * y.clone()).double()
+}
+fn xor3<E: PrimeCharacteristicRing + Clone>(x: &E, y: &E, z: &E) -> E {
+    let xy = x.clone() * y.clone();
+    x.clone() + y.clone() + z.clone()
+        - (xy.clone() + x.clone() * z.clone() + y.clone() * z.clone()).double()
+        + (xy * z.clone()) * E::from_u32(4)
+}
+/// Bitwise rotate-xor family: bit i = x[i+r1] ^ x[i+r2] ^ (x[i+r3] or shr bit).
+fn rx<E: PrimeCharacteristicRing + Clone>(
+    x: &[E],
+    r1: usize,
+    r2: usize,
+    r3: usize,
+    shr: bool,
+) -> Vec<E> {
+    (0..64)
+        .map(|i| {
+            let a = &x[(i + r1) % 64];
+            let b = &x[(i + r2) % 64];
+            if shr {
+                if i + r3 < 64 {
+                    xor3(a, b, &x[i + r3])
+                } else {
+                    xor2(a, b)
+                }
+            } else {
+                xor3(a, b, &x[(i + r3) % 64])
+            }
+        })
+        .collect()
+}
+pub fn big_sigma0<E: PrimeCharacteristicRing + Clone>(a: &[E]) -> Vec<E> {
+    rx(a, 28, 34, 39, false)
+}
+pub fn big_sigma1<E: PrimeCharacteristicRing + Clone>(e: &[E]) -> Vec<E> {
+    rx(e, 14, 18, 41, false)
+}
+pub fn small_sigma0<E: PrimeCharacteristicRing + Clone>(w: &[E]) -> Vec<E> {
+    rx(w, 1, 8, 7, true)
+}
+pub fn small_sigma1<E: PrimeCharacteristicRing + Clone>(w: &[E]) -> Vec<E> {
+    rx(w, 19, 61, 6, true)
+}
+pub fn ch<E: PrimeCharacteristicRing + Clone>(e: &[E], f: &[E], g: &[E]) -> Vec<E> {
+    (0..64)
+        .map(|i| g[i].clone() + e[i].clone() * (f[i].clone() - g[i].clone()))
+        .collect()
+}
+pub fn maj<E: PrimeCharacteristicRing + Clone>(a: &[E], b: &[E], c: &[E]) -> Vec<E> {
+    (0..64)
+        .map(|i| {
+            let ab = a[i].clone() * b[i].clone();
+            ab.clone() + a[i].clone() * c[i].clone() + b[i].clone() * c[i].clone()
+                - (ab * c[i].clone()).double()
+        })
+        .collect()
+}
+pub fn pack3<E: PrimeCharacteristicRing + Clone>(bits: &[E]) -> [E; 3] {
+    std::array::from_fn(|l| {
+        (LIMB_OFF[l]..LIMB_OFF[l + 1]).fold(E::ZERO, |acc, b| {
+            acc + bits[b].clone() * E::from_u64(1u64 << (b - LIMB_OFF[l]))
+        })
+    })
+}
+pub fn pack16<E: PrimeCharacteristicRing + Clone>(bits: &[E]) -> [E; 4] {
+    std::array::from_fn(|l| {
+        (0..16).fold(E::ZERO, |acc, b| {
+            acc + bits[16 * l + b].clone() * E::from_u32(1 << b)
+        })
+    })
+}
+fn add3<E: PrimeCharacteristicRing + Clone>(x: &[E; 3], y: &[E; 3]) -> [E; 3] {
+    std::array::from_fn(|i| x[i].clone() + y[i].clone())
+}
+fn cols3<E: Clone>(row: &[E], c: usize) -> [E; 3] {
+    std::array::from_fn(|i| row[c + i].clone())
+}
+
+/// Limb-wise addition constraint: out + 2^{s_i} c_i - c_{i-1} == rhs_i (times gate).
+fn add_constraint<AB: AirBuilder>(
+    b: &mut AB,
+    gate: &AB::Expr,
+    out: &[AB::Expr; 3],
+    carry: &[AB::Expr; 3],
+    rhs: &[AB::Expr; 3],
+) {
+    for i in 0..3 {
+        let w = LIMB_OFF[i + 1] - LIMB_OFF[i];
+        let mut lhs = out[i].clone() + carry[i].clone() * AB::Expr::from_u64(1u64 << w);
+        if i > 0 {
+            lhs -= carry[i - 1].clone();
+        }
+        b.assert_zero(gate.clone() * (lhs - rhs[i].clone()));
+    }
+}
+
+/// Bus indices: control table, carry range, lookback (permutation), interface.
+#[derive(Clone, Copy, Debug)]
+pub struct ShaBuses {
+    pub ctl: BusIndex,
+    pub rng: BusIndex,
+    pub lb: BusIndex,
+    pub iface: BusIndex,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Sha512Air {
+    pub buses: ShaBuses,
+}
+impl<F> BaseAir<F> for Sha512Air {
+    fn width(&self) -> usize {
+        WIDTH
+    }
+}
+impl<F> PartitionedBaseAir<F> for Sha512Air {}
+impl<F> BaseAirWithPublicValues<F> for Sha512Air {}
+
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for Sha512Air {
+    fn eval(&self, b: &mut AB) {
+        let main = b.main();
+        let l: Vec<AB::Expr> = main
+            .row_slice(0)
+            .unwrap()
+            .iter()
+            .map(|&v| v.into())
+            .collect();
+        let n: Vec<AB::Expr> = main
+            .row_slice(1)
+            .unwrap()
+            .iter()
+            .map(|&v| v.into())
+            .collect();
+        let one = AB::Expr::ONE;
+        let c = |v: u64| AB::Expr::from_u64(v);
+        let f_pad = |x: &[AB::Expr]| {
+            AB::Expr::ONE - x[F_IV].clone() - x[F_ROUND].clone() - x[F_OUT].clone()
+        };
+        let s = |x: &[AB::Expr], base: usize| x[base..base + 64].to_vec();
+
+        // Bits, and zero cells wherever a column has no role, so that every cell
+        // of an accepted trace is determined by (input state, block).
+        for col in 0..NBITS {
+            b.assert_bool(l[col].clone());
+        }
+        let not_round = one.clone() - l[F_ROUND].clone();
+        for col in W0..NBITS {
+            b.assert_zero(not_round.clone() * l[col].clone());
+        }
+        let pad = f_pad(&l);
+        for col in 0..W0 {
+            b.assert_zero(pad.clone() * l[col].clone());
+        }
+        let no_rc = one.clone() - l[F_ROUND].clone() - l[F_OUT].clone();
+        for col in C1A..CW0 {
+            b.assert_zero(no_rc.clone() * l[col].clone());
+        }
+        for col in CW0..RV0 {
+            b.assert_zero((one.clone() - l[F_SCHED].clone()) * l[col].clone());
+        }
+        let no_recv = one.clone() - l[F_SCHED].clone() - l[F_OUT].clone();
+        for col in RV0..K0 {
+            b.assert_zero(no_recv.clone() * l[col].clone());
+        }
+
+        // Row sequencing: segments 0..43 back to back, then padding (r = 44) to the end.
+        b.when_first_row().assert_zero(l[R].clone());
+        b.when_first_row().assert_zero(l[G].clone());
+        b.when_last_row()
+            .assert_zero((l[R].clone() - c(43)) * (one.clone() - f_pad(&l)));
+        {
+            let mut t = b.when_transition();
+            t.assert_zero(n[G].clone() - l[G].clone() - one.clone());
+            t.assert_zero(
+                (n[R].clone() - l[R].clone() - one.clone())
+                    * (one.clone() - f_pad(&n))
+                    * n[R].clone(),
+            );
+            t.assert_zero(f_pad(&n) * (one.clone() - f_pad(&l)) * (l[R].clone() - c(43)));
+            t.assert_zero((one.clone() - n[R].clone()) * n[F_IV].clone() * (l[R].clone() - c(43)));
+            t.assert_zero(f_pad(&l) * (one.clone() - f_pad(&n)));
+        }
+
+        let (a0l, a1l, e0l, e1l, w0l, w1l) = (
+            s(&l, A0),
+            s(&l, A1),
+            s(&l, E0),
+            s(&l, E1),
+            s(&l, W0),
+            s(&l, W1),
+        );
+        let (a0n, a1n, e0n, e1n, w0n, w1n) = (
+            s(&n, A0),
+            s(&n, A1),
+            s(&n, E0),
+            s(&n, E1),
+            s(&n, W0),
+            s(&n, W1),
+        );
+
+        // S (next row) = partial sums for slot 0 of the row after next, from (local, next);
+        // D (next row) = packed slot-1 words of local.  Cyclic, disabled on OUT rows.
+        let keep = one.clone() - n[F_OUT].clone();
+        {
+            let sig1 = pack3(&big_sigma1(&e1n));
+            let chv = pack3(&ch(&e1n, &e0n, &e1l));
+            let sig0 = pack3(&big_sigma0(&a1n));
+            let mj = pack3(&maj(&a1n, &a0n, &a1l));
+            let h = pack3(&e0l);
+            let d = pack3(&a0l);
+            for i in 0..3 {
+                let t1 = h[i].clone() + sig1[i].clone() + chv[i].clone();
+                b.assert_zero(
+                    keep.clone()
+                        * (n[SA + i].clone() - (t1.clone() + sig0[i].clone() + mj[i].clone())),
+                );
+                b.assert_zero(keep.clone() * (n[SE + i].clone() - (t1 + d[i].clone())));
+            }
+            let pa = pack3(&a1l);
+            let pe = pack3(&e1l);
+            for i in 0..3 {
+                b.assert_zero(keep.clone() * (n[DA + i].clone() - pa[i].clone()));
+                b.assert_zero(keep.clone() * (n[DE + i].clone() - pe[i].clone()));
+            }
+        }
+
+        // Round, slot 1 of next row: j-1 = next slot 0, j-2/j-3 = local slots 1/0, j-4 from D(local).
+        let g_round = n[F_ROUND].clone();
+        {
+            let sig1 = pack3(&big_sigma1(&e0n));
+            let chv = pack3(&ch(&e0n, &e1l, &e0l));
+            let sig0 = pack3(&big_sigma0(&a0n));
+            let mj = pack3(&maj(&a0n, &a1l, &a0l));
+            let w = pack3(&w1n);
+            let t1: [AB::Expr; 3] = std::array::from_fn(|i| {
+                l[DE + i].clone()
+                    + sig1[i].clone()
+                    + chv[i].clone()
+                    + n[K1 + i].clone()
+                    + w[i].clone()
+            });
+            let ra: [AB::Expr; 3] =
+                std::array::from_fn(|i| t1[i].clone() + sig0[i].clone() + mj[i].clone());
+            let re: [AB::Expr; 3] = std::array::from_fn(|i| t1[i].clone() + l[DA + i].clone());
+            add_constraint(b, &g_round, &pack3(&a1n), &cols3(&n, C1A), &ra);
+            add_constraint(b, &g_round, &pack3(&e1n), &cols3(&n, C1E), &re);
+        }
+        // Round, slot 0 of next row: partial sum S(local) + W + K.
+        {
+            let w = pack3(&w0n);
+            let ra: [AB::Expr; 3] =
+                std::array::from_fn(|i| l[SA + i].clone() + w[i].clone() + n[K0 + i].clone());
+            let re: [AB::Expr; 3] =
+                std::array::from_fn(|i| l[SE + i].clone() + w[i].clone() + n[K0 + i].clone());
+            add_constraint(b, &g_round, &pack3(&a0n), &cols3(&n, C0A), &ra);
+            add_constraint(b, &g_round, &pack3(&e0n), &cols3(&n, C0E), &re);
+        }
+        // Message schedule for the next row's W slots: σ1(W[t-2]) (local) + W[t-7] + V (received).
+        {
+            let g_sched = n[F_SCHED].clone();
+            for (wl, wn, cw, r7, rv) in [(&w0l, &w0n, CW0, R7A, RV0), (&w1l, &w1n, CW1, R7B, RV1)] {
+                let s1 = pack3(&small_sigma1(wl));
+                let rhs: [AB::Expr; 3] =
+                    std::array::from_fn(|i| s1[i].clone() + n[r7 + i].clone() + n[rv + i].clone());
+                add_constraint(b, &g_sched, &pack3(wn), &cols3(&n, cw), &rhs);
+            }
+        }
+        // Feed-forward on OUT rows: slot q = IV word q + final word q (both received).
+        for (q, &base) in SLOTS.iter().enumerate() {
+            let rhs = add3(&cols3(&l, OUT_IV + 3 * q), &cols3(&l, OUT_FIN + 3 * q));
+            add_constraint(
+                b,
+                &l[F_OUT],
+                &pack3(&l[base..base + 64]),
+                &cols3(&l, OUT_C + 3 * q),
+                &rhs,
+            );
+        }
+
+        // ---- interactions ----
+        let mut ctl = vec![l[R].clone()];
+        ctl.extend((F_IV..=F_S3).map(|col| l[col].clone()));
+        ctl.extend((K0..K0 + 6).map(|col| l[col].clone()));
+        b.push_interaction(self.buses.ctl, ctl, one.clone(), 1);
+        for col in C1A..C1A + NCARRY {
+            b.push_interaction(self.buses.rng, [l[col].clone()], one.clone(), 1);
+        }
+        // Interface bus: (compression id, word index 0..31, four 16-bit limbs).
+        // 0..7 input state, 8..23 block, 24..31 output state.
+        let cid = l[G].clone() - l[R].clone();
+        let two_r = l[R].clone().double();
+        for (q, &base) in SLOTS.iter().enumerate() {
+            let civ = [3u64, 2, 7, 6][q];
+            let cout = [59u64, 60, 55, 56][q];
+            let idx = l[F_IV].clone() * (c(civ) - two_r.clone())
+                + l[F_OUT].clone() * (two_r.clone() - c(cout));
+            let mut msg = vec![cid.clone(), idx];
+            msg.extend(pack16(&l[base..base + 64]));
+            b.push_interaction(self.buses.iface, msg, l[F_IV].clone() + l[F_OUT].clone(), 1);
+        }
+        for (k, base) in [W0, W1].into_iter().enumerate() {
+            let mut msg = vec![cid.clone(), two_r.clone() + c(4 + k as u64)];
+            msg.extend(pack16(&l[base..base + 64]));
+            b.push_interaction(self.buses.iface, msg, l[F_ROUND].clone() - l[F_SCHED].clone(), 1);
+        }
+        // Lookback bus (permutation), keyed by the sender's global row g.
+        for (q, &base) in SLOTS.iter().enumerate() {
+            let mut msg = vec![l[G].clone(), c(10 + q as u64)];
+            msg.extend(pack3(&l[base..base + 64]));
+            b.push_interaction(self.buses.lb, msg, l[F_IV].clone() + l[F_FIN].clone(), 1);
+        }
+        {
+            let v0 = add3(&pack3(&w0l), &pack3(&small_sigma0(&w1l)));
+            let v1 = add3(&pack3(&w1l), &pack3(&small_sigma0(&w0n)));
+            let mut msg = vec![l[G].clone(), c(0)];
+            msg.extend(v0);
+            msg.extend(v1);
+            b.push_interaction(self.buses.lb, msg, l[F_S01].clone(), 1);
+            let mut msg = vec![l[G].clone(), c(1)];
+            msg.extend(pack3(&w1l));
+            b.push_interaction(self.buses.lb, msg, l[F_S2].clone(), 1);
+            let mut msg = vec![l[G].clone(), c(2)];
+            msg.extend(pack3(&w0l));
+            b.push_interaction(self.buses.lb, msg, l[F_S3].clone(), 1);
+        }
+        {
+            let neg = -l[F_SCHED].clone();
+            let mut msg = vec![l[G].clone() - c(8), c(0)];
+            msg.extend((RV0..RV0 + 6).map(|col| l[col].clone()));
+            b.push_interaction(self.buses.lb, msg, neg.clone(), 1);
+            let mut msg = vec![l[G].clone() - c(4), c(1)];
+            msg.extend(cols3(&l, R7A));
+            b.push_interaction(self.buses.lb, msg, neg.clone(), 1);
+            let mut msg = vec![l[G].clone() - c(3), c(2)];
+            msg.extend(cols3(&l, R7B));
+            b.push_interaction(self.buses.lb, msg, neg, 1);
+        }
+        let neg_out = -l[F_OUT].clone();
+        for q in 0..4 {
+            let mut msg = vec![l[G].clone() - two_r.clone() + c(43), c(10 + q as u64)];
+            msg.extend(cols3(&l, OUT_IV + 3 * q));
+            b.push_interaction(self.buses.lb, msg, neg_out.clone(), 1);
+            let mut msg = vec![l[G].clone() - two_r.clone() + c(83), c(10 + q as u64)];
+            msg.extend(cols3(&l, OUT_FIN + 3 * q));
+            b.push_interaction(self.buses.lb, msg, neg_out.clone(), 1);
+        }
+    }
+}
+
+/// Fixed control + range table: 64 rows, row index i = 8*v + u with one-hot u, v
+/// rotated by transition constraints, so its content is pinned without a
+/// preprocessed commitment.  Columns: u[8], v[8], mult_ctl, mult_rng.
+#[derive(Clone, Copy, Debug)]
+pub struct TableAir {
+    pub buses: ShaBuses,
+}
+pub const T_U: usize = 0;
+pub const T_V: usize = 8;
+pub const T_MC: usize = 16;
+pub const T_MR: usize = 17;
+pub const T_WIDTH: usize = 18;
+impl<F> BaseAir<F> for TableAir {
+    fn width(&self) -> usize {
+        T_WIDTH
+    }
+}
+impl<F> PartitionedBaseAir<F> for TableAir {}
+impl<F> BaseAirWithPublicValues<F> for TableAir {}
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for TableAir {
+    fn eval(&self, b: &mut AB) {
+        let main = b.main();
+        let l: Vec<AB::Expr> = main
+            .row_slice(0)
+            .unwrap()
+            .iter()
+            .map(|&v| v.into())
+            .collect();
+        let n: Vec<AB::Expr> = main
+            .row_slice(1)
+            .unwrap()
+            .iter()
+            .map(|&v| v.into())
+            .collect();
+        let one = AB::Expr::ONE;
+        for k in 0..16 {
+            b.assert_bool(l[k].clone());
+        }
+        b.assert_one((0..8).fold(AB::Expr::ZERO, |a, k| a + l[T_U + k].clone()));
+        b.assert_one((0..8).fold(AB::Expr::ZERO, |a, k| a + l[T_V + k].clone()));
+        b.when_first_row().assert_one(l[T_U].clone());
+        b.when_first_row().assert_one(l[T_V].clone());
+        {
+            let mut t = b.when_transition();
+            for k in 0..8 {
+                t.assert_zero(n[T_U + k].clone() - l[T_U + (k + 7) % 8].clone());
+                t.assert_zero(
+                    n[T_V + k].clone()
+                        - l[T_V + k].clone()
+                        - l[T_U + 7].clone() * (l[T_V + (k + 7) % 8].clone() - l[T_V + k].clone()),
+                );
+            }
+        }
+        let _ = one;
+        let field = |vals: &dyn Fn(usize) -> u64| -> AB::Expr {
+            let mut acc = AB::Expr::ZERO;
+            for i in 0..64 {
+                let v = vals(i);
+                if v != 0 {
+                    acc += l[T_U + i % 8].clone() * l[T_V + i / 8].clone() * AB::Expr::from_u64(v);
+                }
+            }
+            acc
+        };
+        let entries: Vec<[u64; CTL_FIELDS]> = (0..64).map(ctl_entry).collect();
+        let msg: Vec<AB::Expr> = (0..CTL_FIELDS).map(|f| field(&|i| entries[i][f])).collect();
+        b.push_interaction(self.buses.ctl, msg, -l[T_MC].clone(), 0);
+        let idx = (0..8).fold(AB::Expr::ZERO, |a, k| {
+            a + l[T_U + k].clone() * AB::Expr::from_u64(k as u64)
+                + l[T_V + k].clone() * AB::Expr::from_u64(8 * k as u64)
+        });
+        b.push_interaction(self.buses.rng, [idx], -l[T_MR].clone(), 0);
+    }
+}
+
+/// Test consumer of the interface bus: one row per (compression, word).
+/// Columns: cid, idx, four 16-bit limbs, multiplicity.
+#[derive(Clone, Copy, Debug)]
+pub struct HarnessAir {
+    pub buses: ShaBuses,
+}
+pub const H_WIDTH: usize = 7;
+impl<F> BaseAir<F> for HarnessAir {
+    fn width(&self) -> usize {
+        H_WIDTH
+    }
+}
+impl<F> PartitionedBaseAir<F> for HarnessAir {}
+impl<F> BaseAirWithPublicValues<F> for HarnessAir {}
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for HarnessAir {
+    fn eval(&self, b: &mut AB) {
+        let main = b.main();
+        let l: Vec<AB::Expr> = main
+            .row_slice(0)
+            .unwrap()
+            .iter()
+            .map(|&v| v.into())
+            .collect();
+        b.assert_bool(l[6].clone());
+        b.push_interaction(self.buses.iface, l[0..6].to_vec(), -l[6].clone(), 1);
+    }
+}
diff --git a/crates/recursion/src/sha384/compress_trace.rs b/crates/recursion/src/sha384/compress_trace.rs
new file mode 100644
index 0000000..5244be5
--- /dev/null
+++ b/crates/recursion/src/sha384/compress_trace.rs
@@ -0,0 +1,398 @@
+//! (Copied from research/near-compression/native/sha384-air/src/trace.rs.)
+//! Trace generation for the narrow SHA-512 compression AIR, plus a native
+//! reference round function checked against `sha2::compress512`.
+use super::compress_air::*;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Comp {
+    pub h: [u64; 8],
+    pub block: [u64; 16],
+}
+
+pub const SHA384_IV: [u64; 8] = [
+    0xcbbb9d5dc1059ed8,
+    0x629a292a367cd507,
+    0x9159015a3070dd17,
+    0x152fecd8f70e5939,
+    0x67332667ffc00b31,
+    0x8eb44a8768581511,
+    0xdb0c2e0d64f98fa7,
+    0x47b5481dbefa4fa4,
+];
+pub const SHA512_IV: [u64; 8] = [
+    0x6a09e667f3bcc908,
+    0xbb67ae8584caa73b,
+    0x3c6ef372fe94f82b,
+    0xa54ff53a5f1d36f1,
+    0x510e527fade682d1,
+    0x9b05688c2b3e6c1f,
+    0x1f83d9abfb41bd6b,
+    0x5be0cd19137e2179,
+];
+
+/// Reference: sha2 crate compression.
+pub fn sha2_compress(c: &Comp) -> [u64; 8] {
+    let mut st = c.h;
+    let bytes: Vec<u8> = c.block.iter().flat_map(|w| w.to_be_bytes()).collect();
+    let blk = sha2::digest::generic_array::GenericArray::clone_from_slice(&bytes);
+    sha2::compress512(&mut st, &[blk]);
+    st
+}
+
+/// Message padding (FIPS 180-4 §5.1.2) into 1024-bit blocks.
+pub fn pad_message(msg: &[u8]) -> Vec<[u64; 16]> {
+    let mut m = msg.to_vec();
+    m.push(0x80);
+    while m.len() % 128 != 112 {
+        m.push(0);
+    }
+    m.extend_from_slice(&(0u64).to_be_bytes());
+    m.extend_from_slice(&((msg.len() as u64) * 8).to_be_bytes());
+    m.chunks(128)
+        .map(|ch| {
+            std::array::from_fn(|i| u64::from_be_bytes(ch[8 * i..8 * i + 8].try_into().unwrap()))
+        })
+        .collect()
+}
+
+fn bsig0(x: u64) -> u64 {
+    x.rotate_right(28) ^ x.rotate_right(34) ^ x.rotate_right(39)
+}
+fn bsig1(x: u64) -> u64 {
+    x.rotate_right(14) ^ x.rotate_right(18) ^ x.rotate_right(41)
+}
+fn ssig0(x: u64) -> u64 {
+    x.rotate_right(1) ^ x.rotate_right(8) ^ (x >> 7)
+}
+fn ssig1(x: u64) -> u64 {
+    x.rotate_right(19) ^ x.rotate_right(61) ^ (x >> 6)
+}
+fn chf(e: u64, f: u64, g: u64) -> u64 {
+    (e & f) ^ (!e & g)
+}
+fn majf(a: u64, b: u64, c: u64) -> u64 {
+    (a & b) ^ (a & c) ^ (b & c)
+}
+
+/// Words of one compression: a[-4..80), e[-4..80) (index +4), W[0..80), output.
+pub struct Words {
+    pub a: [u64; 84],
+    pub e: [u64; 84],
+    pub w: [u64; 80],
+    pub out: [u64; 8],
+}
+pub fn round_words(c: &Comp) -> Words {
+    let mut w = [0u64; 80];
+    w[..16].copy_from_slice(&c.block);
+    for t in 16..80 {
+        w[t] = ssig1(w[t - 2])
+            .wrapping_add(w[t - 7])
+            .wrapping_add(ssig0(w[t - 15]))
+            .wrapping_add(w[t - 16]);
+    }
+    let mut a = [0u64; 84];
+    let mut e = [0u64; 84];
+    for k in 0..4 {
+        a[3 - k] = c.h[k]; // a[-1] = H0 ... a[-4] = H3
+        e[3 - k] = c.h[4 + k];
+    }
+    for t in 0..80 {
+        let i = t + 4;
+        let t1 = e[i - 4]
+            .wrapping_add(bsig1(e[i - 1]))
+            .wrapping_add(chf(e[i - 1], e[i - 2], e[i - 3]))
+            .wrapping_add(K[t])
+            .wrapping_add(w[t]);
+        let t2 = bsig0(a[i - 1]).wrapping_add(majf(a[i - 1], a[i - 2], a[i - 3]));
+        a[i] = t1.wrapping_add(t2);
+        e[i] = a[i - 4].wrapping_add(t1);
+    }
+    let mut out = [0u64; 8];
+    for k in 0..4 {
+        out[k] = c.h[k].wrapping_add(a[83 - k]);
+        out[4 + k] = c.h[4 + k].wrapping_add(e[83 - k]);
+    }
+    Words { a, e, w, out }
+}
+
+fn put(row: &mut [u32], base: usize, x: u64) {
+    for i in 0..64 {
+        row[base + i] = ((x >> i) & 1) as u32;
+    }
+}
+pub fn get(row: &[u32], base: usize) -> u64 {
+    (0..64).fold(0u64, |acc, i| acc | ((row[base + i] as u64 & 1) << i))
+}
+fn put3(row: &mut [u32], base: usize, v: [u64; 3]) {
+    for i in 0..3 {
+        assert!(v[i] < (1 << 31));
+        row[base + i] = v[i] as u32;
+    }
+}
+fn l3(x: u64) -> [u64; 3] {
+    limbs3(x)
+}
+fn sum3(xs: &[[u64; 3]]) -> [u64; 3] {
+    std::array::from_fn(|i| xs.iter().map(|x| x[i]).sum())
+}
+/// Carries for out + 2^{s_i} c_i - c_{i-1} = rhs_i; checks the output limbs.
+fn carries(out: u64, rhs: [u64; 3]) -> [u64; 3] {
+    let ol = l3(out);
+    let mut c = [0u64; 3];
+    let mut prev = 0u64;
+    for i in 0..3 {
+        let w = LIMB_OFF[i + 1] - LIMB_OFF[i];
+        let v = rhs[i] + prev;
+        assert_eq!(v & ((1 << w) - 1), ol[i], "limb mismatch");
+        c[i] = v >> w;
+        assert!(c[i] < RANGE as u64);
+        prev = c[i];
+    }
+    c
+}
+
+pub struct Traces {
+    pub main: Vec<u32>,
+    pub main_height: usize,
+    pub table: Vec<u32>,
+    pub harness: Vec<u32>,
+    pub harness_height: usize,
+}
+
+pub fn main_height(n: usize) -> usize {
+    (n * ROWS).next_power_of_two().max(4)
+}
+
+/// Main trace (row-major, WIDTH).  `height` >= n*ROWS, a power of two.
+pub fn gen_main(comps: &[Comp], height: usize) -> Vec<u32> {
+    assert!(height >= comps.len() * ROWS && height.is_power_of_two());
+    let mut t = vec![0u32; height * WIDTH];
+    // Pass 1: bits, control, round constants.
+    for gi in 0..height {
+        let row = &mut t[gi * WIDTH..(gi + 1) * WIDTH];
+        let s = gi / ROWS;
+        let r = if s < comps.len() {
+            gi % ROWS
+        } else {
+            PAD_R as usize
+        };
+        let e = ctl_entry(r);
+        row[R] = r as u32;
+        row[G] = gi as u32;
+        for (k, col) in (F_IV..=F_S3).enumerate() {
+            row[col] = e[1 + k] as u32;
+        }
+        for k in 0..6 {
+            row[K0 + k] = e[9 + k] as u32;
+        }
+    }
+    for (s, c) in comps.iter().enumerate() {
+        let wd = round_words(c);
+        let base = s * ROWS;
+        for r in 0..ROWS {
+            let row = &mut t[(base + r) * WIDTH..(base + r + 1) * WIDTH];
+            let (sa, se): ([u64; 2], [u64; 2]) = if r < 42 {
+                // a index (j+4) for slots j = 2r-4, 2r-3
+                (
+                    [wd.a[2 * r], wd.a[2 * r + 1]],
+                    [wd.e[2 * r], wd.e[2 * r + 1]],
+                )
+            } else if r == 42 {
+                ([wd.out[1], wd.out[0]], [wd.out[5], wd.out[4]])
+            } else {
+                ([wd.out[3], wd.out[2]], [wd.out[7], wd.out[6]])
+            };
+            put(row, A0, sa[0]);
+            put(row, A1, sa[1]);
+            put(row, E0, se[0]);
+            put(row, E1, se[1]);
+            if (2..42).contains(&r) {
+                put(row, W0, wd.w[2 * r - 4]);
+                put(row, W1, wd.w[2 * r - 3]);
+            }
+        }
+    }
+    // Pass 2: S and D for every non-OUT row, from the (cyclic) previous row.
+    let gs = |t: &[u32], gi: usize, base: usize| get(&t[gi * WIDTH..(gi + 1) * WIDTH], base);
+    for gi in 0..height {
+        if t[gi * WIDTH + F_OUT] == 1 {
+            continue;
+        }
+        let p = (gi + height - 1) % height;
+        let (a0l, a1l, e0l, e1l) = (gs(&t, p, A0), gs(&t, p, A1), gs(&t, p, E0), gs(&t, p, E1));
+        let (a0n, a1n, e0n, e1n) = (
+            gs(&t, gi, A0),
+            gs(&t, gi, A1),
+            gs(&t, gi, E0),
+            gs(&t, gi, E1),
+        );
+        let t1 = sum3(&[l3(e0l), l3(bsig1(e1n)), l3(chf(e1n, e0n, e1l))]);
+        let sa = sum3(&[t1, l3(bsig0(a1n)), l3(majf(a1n, a0n, a1l))]);
+        let se = sum3(&[t1, l3(a0l)]);
+        let row = &mut t[gi * WIDTH..(gi + 1) * WIDTH];
+        put3(row, SA, sa);
+        put3(row, SE, se);
+        put3(row, DA, l3(a1l));
+        put3(row, DE, l3(e1l));
+    }
+    // Pass 3: received values and carries (needs S/D of the previous row).
+    for s in 0..comps.len() {
+        let base = s * ROWS;
+        for r in 0..ROWS {
+            let gi = base + r;
+            let prev: Vec<u32> = t[(gi - if gi > 0 { 1 } else { 0 }) * WIDTH..][..WIDTH].to_vec();
+            let at = |rr: usize, col: usize| gs(&t, base + rr, col);
+            let mut row: Vec<u32> = t[gi * WIDTH..(gi + 1) * WIDTH].to_vec();
+            if (2..42).contains(&r) {
+                let (a0l, a1l, e0l, e1l) = (
+                    get(&prev, A0),
+                    get(&prev, A1),
+                    get(&prev, E0),
+                    get(&prev, E1),
+                );
+                let (a0n, a1n, e0n, e1n) =
+                    (get(&row, A0), get(&row, A1), get(&row, E0), get(&row, E1));
+                let (w0n, w1n) = (get(&row, W0), get(&row, W1));
+                let pv = |c: usize| -> [u64; 3] { std::array::from_fn(|i| prev[c + i] as u64) };
+                let k0: [u64; 3] = std::array::from_fn(|i| row[K0 + i] as u64);
+                let k1: [u64; 3] = std::array::from_fn(|i| row[K1 + i] as u64);
+                // slot 1
+                let t1 = sum3(&[pv(DE), l3(bsig1(e0n)), l3(chf(e0n, e1l, e0l)), k1, l3(w1n)]);
+                let ra = sum3(&[t1, l3(bsig0(a0n)), l3(majf(a0n, a1l, a0l))]);
+                let re = sum3(&[t1, pv(DA)]);
+                put3(&mut row, C1A, carries(a1n, ra));
+                put3(&mut row, C1E, carries(e1n, re));
+                // slot 0
+                put3(&mut row, C0A, carries(a0n, sum3(&[pv(SA), l3(w0n), k0])));
+                put3(&mut row, C0E, carries(e0n, sum3(&[pv(SE), l3(w0n), k0])));
+                if r >= 10 {
+                    let v0 = sum3(&[l3(at(r - 8, W0)), l3(ssig0(at(r - 8, W1)))]);
+                    let v1 = sum3(&[l3(at(r - 8, W1)), l3(ssig0(at(r - 7, W0)))]);
+                    put3(&mut row, RV0, v0);
+                    put3(&mut row, RV1, v1);
+                    put3(&mut row, R7A, l3(at(r - 4, W1)));
+                    put3(&mut row, R7B, l3(at(r - 3, W0)));
+                    let (w0l, w1l) = (get(&prev, W0), get(&prev, W1));
+                    put3(
+                        &mut row,
+                        CW0,
+                        carries(w0n, sum3(&[l3(ssig1(w0l)), l3(at(r - 4, W1)), v0])),
+                    );
+                    put3(
+                        &mut row,
+                        CW1,
+                        carries(w1n, sum3(&[l3(ssig1(w1l)), l3(at(r - 3, W0)), v1])),
+                    );
+                }
+            } else if r >= 42 {
+                let (ivr, finr) = if r == 42 { (1, 41) } else { (0, 40) };
+                for (q, &slot) in SLOTS.iter().enumerate() {
+                    let iv = at(ivr, slot);
+                    let fin = at(finr, slot);
+                    put3(&mut row, OUT_IV + 3 * q, l3(iv));
+                    put3(&mut row, OUT_FIN + 3 * q, l3(fin));
+                    let outw = get(&row, slot);
+                    assert_eq!(outw, iv.wrapping_add(fin));
+                    put3(
+                        &mut row,
+                        OUT_C + 3 * q,
+                        carries(outw, sum3(&[l3(iv), l3(fin)])),
+                    );
+                }
+            }
+            t[gi * WIDTH..(gi + 1) * WIDTH].copy_from_slice(&row);
+        }
+    }
+    t
+}
+
+/// Table trace (64 rows) with multiplicities counted from the main trace.
+pub fn gen_table(main: &[u32], height: usize) -> Vec<u32> {
+    let mut t = vec![0u32; 64 * T_WIDTH];
+    for i in 0..64 {
+        t[i * T_WIDTH + T_U + i % 8] = 1;
+        t[i * T_WIDTH + T_V + i / 8] = 1;
+    }
+    for gi in 0..height {
+        let row = &main[gi * WIDTH..(gi + 1) * WIDTH];
+        t[row[R] as usize * T_WIDTH + T_MC] += 1;
+        for col in C1A..C1A + NCARRY {
+            t[row[col] as usize * T_WIDTH + T_MR] += 1;
+        }
+    }
+    t
+}
+
+/// Interface consumer rows from the reference compression (independent of the AIR trace).
+pub fn gen_harness(comps: &[Comp]) -> (Vec<u32>, usize) {
+    let height = (comps.len() * 32).next_power_of_two().max(4);
+    let mut t = vec![0u32; height * H_WIDTH];
+    for (s, c) in comps.iter().enumerate() {
+        let out = sha2_compress(c);
+        let ws: Vec<u64> =
+            c.h.iter()
+                .chain(c.block.iter())
+                .chain(out.iter())
+                .copied()
+                .collect();
+        for (idx, w) in ws.into_iter().enumerate() {
+            let row = &mut t[(s * 32 + idx) * H_WIDTH..][..H_WIDTH];
+            row[0] = (s * ROWS) as u32;
+            row[1] = idx as u32;
+            for k in 0..4 {
+                row[2 + k] = ((w >> (16 * k)) & 0xffff) as u32;
+            }
+            row[6] = 1;
+        }
+    }
+    (t, height)
+}
+
+pub fn gen_all(comps: &[Comp]) -> Traces {
+    let h = main_height(comps.len());
+    let main = gen_main(comps, h);
+    let table = gen_table(&main, h);
+    let (harness, hh) = gen_harness(comps);
+    Traces {
+        main,
+        main_height: h,
+        table,
+        harness,
+        harness_height: hh,
+    }
+}
+
+/// Output state read back from the trace's OUT rows of compression s.
+pub fn trace_output(main: &[u32], s: usize) -> [u64; 8] {
+    let row = |r: usize| &main[(s * ROWS + r) * WIDTH..][..WIDTH];
+    let (r42, r43) = (row(42), row(43));
+    [
+        get(r42, A1),
+        get(r42, A0),
+        get(r43, A1),
+        get(r43, A0),
+        get(r42, E1),
+        get(r42, E0),
+        get(r43, E1),
+        get(r43, E0),
+    ]
+}
+
+/// Deterministic xorshift for test inputs (no extra dependency).
+pub struct Rng(pub u64);
+impl Rng {
+    pub fn next(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x << 13;
+        x ^= x >> 7;
+        x ^= x << 17;
+        self.0 = x;
+        x
+    }
+    pub fn comp(&mut self) -> Comp {
+        Comp {
+            h: std::array::from_fn(|_| self.next()),
+            block: std::array::from_fn(|_| self.next()),
+        }
+    }
+}
