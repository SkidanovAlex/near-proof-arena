--- /dev/null
+++ b/crates/recursion/src/sha384/airs.rs
@@ -0,0 +1,516 @@
+//! Generic in-circuit SHA-384 hashing of framed messages, on top of the narrow SHA-512
+//! compression AIR (`compress_air.rs`).
+//!
+//! A *job* hashes `PREFIX ‖ tag ‖ u_0 ‖ u_1 ‖ … ‖ u_{U-1}` (SHA-384, standard padding),
+//! where every *unit* u_i is 4 bytes: a canonical BabyBear element in little-endian
+//! (`kind = 0`, as `observe`/`hash_slice` serialise field elements) or two 16-bit limbs
+//! in big-endian (`kind = 1`, as digest/state bytes appear in `observe_commit` and the
+//! transcript state).  Every message of the native config (`hash_parts`) has this form:
+//! the 8-byte length prefixes are the unit pair (len, 0).  Units start at byte 33, so
+//! message word w ≥ 4 is `[c, u_{2(w-4)} (4 bytes), first 3 bytes of u_{2(w-4)+1}]`
+//! with `c` = tag (w = 4) or the last byte of the previous unit.
+//!
+//! * `ShaMsgAir`: one row per 64-bit message word of every job.  Receives the job start
+//!   `(job, tag)` and the units `(job, i, kind, v0, v1)` from producers, places the 0x80
+//!   padding unit and the 128-bit length, and sends the words `(job, w, limbs)`.  Job ids
+//!   are 0, 1, 2, … in row order, so each id belongs to exactly one job.
+//! * `ShaBlockAir`: one row per compression of a job; chains the state from the SHA-384
+//!   IV, talks to the compression AIR's interface bus, and sends `(job, H0..H5 limbs)`.
+//! * `ShaByteAir`: the [0, 256) lookup table used for every byte.
+//!
+//! Producers own the framing they know (lengths of their parts); the packer owns the
+//! SHA padding and bit length, computed from the number of units it consumed.
+use core::borrow::Borrow;
+
+use openvm_recursion_circuit_derive::AlignedBorrow;
+use openvm_stark_backend::{
+    interaction::{BusIndex, InteractionBuilder, LookupBus, PermutationCheckBus},
+    BaseAirWithPublicValues, PartitionedBaseAir,
+};
+use p3_air::{Air, AirBuilder, BaseAir};
+use p3_field::PrimeCharacteristicRing;
+use p3_matrix::Matrix;
+
+use super::{compress_air::ShaBuses, compress_trace::SHA384_IV, config::PREFIX};
+
+/// All buses of the SHA subsystem.
+#[derive(Clone, Copy, Debug)]
+pub struct ShaBusInventory {
+    pub compress: ShaBuses,
+    /// (job, word index, l0, l1, l2, l3): packer -> block AIR.
+    pub word: BusIndex,
+    /// (job, unit index, kind, v0, v1): producers -> packer.
+    pub unit: BusIndex,
+    /// (job, tag): producers -> packer.
+    pub job: BusIndex,
+    /// (job, 24 digest limbs): block AIR -> producers.
+    pub digest: BusIndex,
+    /// byte lookup table.
+    pub byte: BusIndex,
+}
+
+impl ShaBusInventory {
+    pub fn word_bus(&self) -> PermutationCheckBus {
+        PermutationCheckBus::new(self.word)
+    }
+    pub fn unit_bus(&self) -> PermutationCheckBus {
+        PermutationCheckBus::new(self.unit)
+    }
+    pub fn job_bus(&self) -> PermutationCheckBus {
+        PermutationCheckBus::new(self.job)
+    }
+    pub fn digest_bus(&self) -> PermutationCheckBus {
+        PermutationCheckBus::new(self.digest)
+    }
+    pub fn iface_bus(&self) -> PermutationCheckBus {
+        PermutationCheckBus::new(self.compress.iface)
+    }
+    pub fn byte_bus(&self) -> LookupBus {
+        LookupBus::new(self.byte)
+    }
+
+    /// Producer side: send one unit of `job`.
+    pub fn send_unit<AB: InteractionBuilder>(
+        &self,
+        builder: &mut AB,
+        job: impl Into<AB::Expr>,
+        idx: impl Into<AB::Expr>,
+        kind: u32,
+        v0: impl Into<AB::Expr>,
+        v1: impl Into<AB::Expr>,
+        enabled: impl Into<AB::Expr>,
+    ) {
+        self.unit_bus().send(
+            builder,
+            [
+                job.into(),
+                idx.into(),
+                AB::Expr::from_u32(kind),
+                v0.into(),
+                v1.into(),
+            ],
+            enabled,
+        );
+    }
+    /// Producer side: send the units of a digest/state given as 24 limbs (H0 limb 0 first).
+    #[allow(clippy::too_many_arguments)]
+    pub fn send_digest_units<AB: InteractionBuilder>(
+        &self,
+        builder: &mut AB,
+        job: impl Into<AB::Expr>,
+        first_idx: usize,
+        limbs: &[AB::Expr],
+        enabled: impl Into<AB::Expr>,
+    ) {
+        let job = job.into();
+        let enabled = enabled.into();
+        for i in 0..6 {
+            let l = &limbs[4 * i..4 * i + 4];
+            self.send_unit(
+                builder,
+                job.clone(),
+                AB::Expr::from_usize(first_idx + 2 * i),
+                1,
+                l[3].clone(),
+                l[2].clone(),
+                enabled.clone(),
+            );
+            self.send_unit(
+                builder,
+                job.clone(),
+                AB::Expr::from_usize(first_idx + 2 * i + 1),
+                1,
+                l[1].clone(),
+                l[0].clone(),
+                enabled.clone(),
+            );
+        }
+    }
+    pub fn send_job<AB: InteractionBuilder>(
+        &self,
+        builder: &mut AB,
+        job: impl Into<AB::Expr>,
+        tag: impl Into<AB::Expr>,
+        enabled: impl Into<AB::Expr>,
+    ) {
+        self.job_bus()
+            .send(builder, [job.into(), tag.into()], enabled);
+    }
+    pub fn receive_digest<AB: InteractionBuilder>(
+        &self,
+        builder: &mut AB,
+        job: impl Into<AB::Expr>,
+        limbs: &[AB::Expr],
+        enabled: impl Into<AB::Expr>,
+    ) {
+        let msg: Vec<AB::Expr> = core::iter::once(job.into())
+            .chain(limbs.iter().cloned())
+            .collect();
+        self.digest_bus().receive(builder, msg, enabled);
+    }
+}
+
+pub fn iv_limbs() -> [u32; 32] {
+    std::array::from_fn(|i| ((SHA384_IV[i / 4] >> (16 * (i % 4))) & 0xffff) as u32)
+}
+
+// ---------------------------------------------------------------------------------------
+// Packer
+// ---------------------------------------------------------------------------------------
+
+#[repr(C)]
+#[derive(AlignedBorrow, Debug)]
+pub struct ShaMsgCols<T> {
+    pub valid: T,
+    pub start: T,
+    pub job: T,
+    /// word index within the job
+    pub w: T,
+    pub tag: T,
+    /// one-hot position of the word in its block
+    pub oh: [T; 16],
+    pub blk0: T,
+    pub last_blk: T,
+    /// = oh[15] * last_blk: last word of the job
+    pub is_end: T,
+    /// big-endian bytes of the word
+    pub b: [T; 8],
+    /// first byte of the next word (4th byte of slot B)
+    pub carry: T,
+    /// 1 once the padding unit has been placed (before this row's slots)
+    pub phase: T,
+    /// number of data units consumed before this row
+    pub uidx: T,
+    /// per slot (A = bytes 1..4, B = bytes 5..7 + carry): data / padding / unit kind
+    pub d: [T; 2],
+    pub p: [T; 2],
+    pub kind: [T; 2],
+    /// is-zero gadget for (0x78 - top byte) of a field-element unit
+    pub zmax: [T; 2],
+    pub inv: [T; 2],
+}
+
+pub const MSG_WIDTH: usize = ShaMsgCols::<u8>::width();
+
+#[derive(Clone, Copy, Debug)]
+pub struct ShaMsgAir {
+    pub buses: ShaBusInventory,
+}
+impl<F> BaseAir<F> for ShaMsgAir {
+    fn width(&self) -> usize {
+        MSG_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for ShaMsgAir {}
+impl<F> PartitionedBaseAir<F> for ShaMsgAir {}
+
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for ShaMsgAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (local, next) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &ShaMsgCols<AB::Var> = (*local).borrow();
+        let n: &ShaMsgCols<AB::Var> = (*next).borrow();
+        let c = |v: u64| AB::Expr::from_u64(v);
+        let one = AB::Expr::ONE;
+
+        for x in [l.valid, l.start, l.blk0, l.last_blk, l.phase] {
+            builder.assert_bool(x);
+        }
+        for i in 0..16 {
+            builder.assert_bool(l.oh[i]);
+        }
+        let oh_sum = l.oh.iter().fold(AB::Expr::ZERO, |a, &x| a + x);
+        builder.assert_eq(oh_sum, l.valid);
+        builder.when(l.start).assert_one(l.valid);
+
+        // Word classes.
+        let hdr = l.blk0 * (l.oh[0] + l.oh[1] + l.oh[2] + l.oh[3]);
+        let lenw = l.last_blk * (l.oh[14] + l.oh[15]);
+        let active = l.valid - hdr.clone() - lenw.clone();
+        builder.assert_eq(l.is_end, l.oh[15] * l.last_blk);
+        let end = l.is_end;
+
+        // Job start.
+        {
+            let mut b = builder.when(l.start);
+            b.assert_one(l.oh[0]);
+            b.assert_one(l.blk0);
+            b.assert_zero(l.w);
+            b.assert_zero(l.phase);
+            b.assert_zero(l.uidx);
+        }
+        builder.when_first_row().assert_eq(l.start, l.valid);
+        builder.when_first_row().assert_zero(l.job);
+
+        // Slots.
+        let slots: [[AB::Expr; 4]; 2] = [
+            [l.b[1].into(), l.b[2].into(), l.b[3].into(), l.b[4].into()],
+            [l.b[5].into(), l.b[6].into(), l.b[7].into(), l.carry.into()],
+        ];
+        let mut phase_before: AB::Expr = l.phase.into();
+        let mut uidx: AB::Expr = l.uidx.into();
+        let unit_bus = self.buses.unit_bus();
+        let byte_bus = self.buses.byte_bus();
+        for s in 0..2 {
+            let (d, p, kind) = (l.d[s], l.p[s], l.kind[s]);
+            builder.assert_bool(d);
+            builder.assert_bool(p);
+            builder.assert_bool(kind);
+            builder.assert_bool(d + p);
+            // no unit slot outside active words
+            builder.assert_zero((one.clone() - active.clone()) * (d + p));
+            builder.assert_zero((one.clone() - d) * kind);
+            let z = active.clone() - d - p;
+            builder.assert_zero(d * phase_before.clone());
+            builder.assert_zero(p * phase_before.clone());
+            builder.assert_zero(z.clone() * (one.clone() - phase_before.clone()));
+            let a = &slots[s];
+            // padding unit [0x80, 0, 0, 0]; zero unit
+            builder.assert_zero(p * (a[0].clone() - c(0x80)));
+            for k in 1..4 {
+                builder.assert_zero(p * a[k].clone());
+            }
+            for k in 0..4 {
+                builder.assert_zero(z.clone() * a[k].clone());
+            }
+            // unit value
+            let felt = a[0].clone()
+                + a[1].clone() * c(1 << 8)
+                + a[2].clone() * c(1 << 16)
+                + a[3].clone() * c(1 << 24);
+            let hi = a[0].clone() * c(256) + a[1].clone();
+            let lo = a[2].clone() * c(256) + a[3].clone();
+            let v0 = felt.clone() + kind * (hi - felt);
+            let v1 = lo * kind;
+            unit_bus.receive(
+                builder,
+                [l.job.into(), uidx.clone(), kind.into(), v0, v1],
+                d,
+            );
+            // canonical field element: top byte <= 0x78, and == 0x78 only for p - 1
+            let gap = c(0x78) - a[3].clone();
+            let is_felt = d * (one.clone() - kind);
+            byte_bus.lookup_key(builder, [gap.clone()], is_felt.clone());
+            builder.assert_zero(l.zmax[s] * gap.clone());
+            builder.assert_eq(gap * l.inv[s], one.clone() - l.zmax[s]);
+            builder.assert_zero(
+                is_felt * l.zmax[s] * (a[0].clone() + a[1].clone() + a[2].clone()),
+            );
+            phase_before = phase_before + p;
+            uidx = uidx + d;
+        }
+        let phase_after = phase_before;
+        let uidx_after = uidx;
+
+        // Header and length words.
+        for i in 0..4 {
+            for k in 0..8 {
+                builder
+                    .when(l.blk0 * l.oh[i])
+                    .assert_eq(l.b[k], c(PREFIX[8 * i + k] as u64));
+            }
+        }
+        builder.when(l.blk0 * l.oh[4]).assert_eq(l.b[0], l.tag);
+        for k in 0..8 {
+            builder.when(l.last_blk * l.oh[14]).assert_zero(l.b[k]);
+        }
+        for k in 0..5 {
+            builder.when(l.last_blk * l.oh[15]).assert_zero(l.b[k]);
+        }
+        builder.when(l.last_blk * l.oh[15]).assert_eq(
+            l.b[5] * c(1 << 16) + l.b[6] * c(1 << 8) + l.b[7],
+            (c(33) + l.uidx * c(4)) * c(8),
+        );
+        // The final block is the one whose word 13 ends with the padding placed.
+        builder
+            .when(l.oh[13])
+            .assert_eq(l.last_blk, phase_after.clone());
+
+        // Sequencing.
+        {
+            let mut t = builder.when_transition();
+            t.assert_zero((one.clone() - l.valid) * n.valid);
+            t.when(l.valid).assert_eq(n.start, end * n.valid);
+            t.when(l.valid)
+                .assert_zero((one.clone() - end) * (one.clone() - n.valid));
+            t.when(n.valid).assert_eq(n.job, l.job + n.start);
+            let same = n.valid - n.start;
+            let mut s = t.when(same);
+            s.assert_eq(n.w, l.w + one.clone());
+            s.assert_eq(n.tag, l.tag);
+            for i in 0..16 {
+                s.assert_eq(n.oh[(i + 1) % 16], l.oh[i]);
+            }
+            s.assert_eq(n.blk0, l.blk0 * (one.clone() - l.oh[15]));
+            s.assert_eq(n.phase, phase_after);
+            s.assert_eq(n.uidx, uidx_after);
+            s.assert_eq(n.b[0], l.carry);
+            s.when(one.clone() - l.oh[15]).assert_eq(n.last_blk, l.last_blk);
+        }
+        builder
+            .when_last_row()
+            .assert_zero(l.valid * (one.clone() - end));
+
+        // Bytes.
+        for k in 0..8 {
+            byte_bus.lookup_key(builder, [l.b[k]], l.valid);
+        }
+        // Words and job start.
+        let limb = |hi: AB::Var, lo: AB::Var| hi * c(256) + lo;
+        self.buses.word_bus().send(
+            builder,
+            [
+                l.job.into(),
+                l.w.into(),
+                limb(l.b[6], l.b[7]),
+                limb(l.b[4], l.b[5]),
+                limb(l.b[2], l.b[3]),
+                limb(l.b[0], l.b[1]),
+            ],
+            l.valid,
+        );
+        self.buses
+            .job_bus()
+            .receive(builder, [l.job, l.tag], l.start);
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Block chaining
+// ---------------------------------------------------------------------------------------
+
+#[repr(C)]
+#[derive(AlignedBorrow, Debug)]
+pub struct ShaBlockCols<T> {
+    pub valid: T,
+    pub job: T,
+    pub blk: T,
+    pub first: T,
+    pub last: T,
+    pub cid: T,
+    pub input: [T; 32],
+    pub words: [T; 64],
+    pub output: [T; 32],
+}
+pub const BLOCK_WIDTH: usize = ShaBlockCols::<u8>::width();
+
+#[derive(Clone, Copy, Debug)]
+pub struct ShaBlockAir {
+    pub buses: ShaBusInventory,
+}
+impl<F> BaseAir<F> for ShaBlockAir {
+    fn width(&self) -> usize {
+        BLOCK_WIDTH
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for ShaBlockAir {}
+impl<F> PartitionedBaseAir<F> for ShaBlockAir {}
+
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for ShaBlockAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (local, next) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        let l: &ShaBlockCols<AB::Var> = (*local).borrow();
+        let n: &ShaBlockCols<AB::Var> = (*next).borrow();
+        let one = AB::Expr::ONE;
+        for x in [l.valid, l.first, l.last] {
+            builder.assert_bool(x);
+        }
+        builder.when(l.first).assert_one(l.valid);
+        builder.when(l.last).assert_one(l.valid);
+        builder.when_first_row().assert_eq(l.first, l.valid);
+        let iv = iv_limbs();
+        for i in 0..32 {
+            builder
+                .when(l.first)
+                .assert_eq(l.input[i], AB::Expr::from_u32(iv[i]));
+        }
+        builder.when(l.first).assert_zero(l.blk);
+        {
+            let mut t = builder.when_transition();
+            t.assert_zero((one.clone() - l.valid) * n.valid);
+            t.when(n.valid).assert_eq(n.first, l.last);
+            t.when(l.valid)
+                .assert_zero((one.clone() - l.last) * (one.clone() - n.valid));
+            let mut s = t.when(n.valid - n.first);
+            s.assert_eq(n.job, l.job);
+            s.assert_eq(n.blk, l.blk + one.clone());
+            for i in 0..32 {
+                s.assert_eq(n.input[i], l.output[i]);
+            }
+        }
+        builder
+            .when_last_row()
+            .assert_zero(l.valid * (one.clone() - l.last));
+
+        let iface = self.buses.iface_bus();
+        let groups: [(&[AB::Var], usize); 3] = [(&l.input, 0), (&l.words, 8), (&l.output, 24)];
+        for (vals, base) in groups {
+            for q in 0..vals.len() / 4 {
+                iface.receive(
+                    builder,
+                    [
+                        l.cid.into(),
+                        AB::Expr::from_usize(base + q),
+                        vals[4 * q].into(),
+                        vals[4 * q + 1].into(),
+                        vals[4 * q + 2].into(),
+                        vals[4 * q + 3].into(),
+                    ],
+                    l.valid,
+                );
+            }
+        }
+        let word = self.buses.word_bus();
+        for q in 0..16 {
+            word.receive(
+                builder,
+                [
+                    l.job.into(),
+                    l.blk * AB::Expr::from_usize(16) + AB::Expr::from_usize(q),
+                    l.words[4 * q].into(),
+                    l.words[4 * q + 1].into(),
+                    l.words[4 * q + 2].into(),
+                    l.words[4 * q + 3].into(),
+                ],
+                l.valid,
+            );
+        }
+        let msg: Vec<AB::Expr> = core::iter::once(l.job.into())
+            .chain(l.output[..24].iter().map(|&x| x.into()))
+            .collect();
+        self.buses.digest_bus().send(builder, msg, l.last);
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Byte table
+// ---------------------------------------------------------------------------------------
+
+#[derive(Clone, Copy, Debug)]
+pub struct ShaByteAir {
+    pub buses: ShaBusInventory,
+}
+impl<F> BaseAir<F> for ShaByteAir {
+    fn width(&self) -> usize {
+        2
+    }
+}
+impl<F> BaseAirWithPublicValues<F> for ShaByteAir {}
+impl<F> PartitionedBaseAir<F> for ShaByteAir {}
+impl<AB: AirBuilder + InteractionBuilder> Air<AB> for ShaByteAir {
+    fn eval(&self, builder: &mut AB) {
+        let main = builder.main();
+        let (local, next) = (main.row_slice(0).unwrap(), main.row_slice(1).unwrap());
+        builder.when_first_row().assert_zero(local[0]);
+        builder
+            .when_transition()
+            .assert_eq(next[0], local[0] + AB::Expr::ONE);
+        builder
+            .when_last_row()
+            .assert_eq(local[0], AB::Expr::from_u32(255));
+        self.buses
+            .byte_bus()
+            .add_key_with_lookups(builder, [local[0]], local[1]);
+    }
+}
