@@ -0,0 +1,350 @@
+//! [stream research] Streamed Reed-Solomon commitments: the codeword is never materialised.
+//!
+//! The codeword of a polynomial `f` of length `2^n` on the coset-major `c * 2^L` domain (see
+//! `crate::odd_domain`; `c = 1` is the upstream power-of-two domain) is computed in sub-cosets:
+//! for `s = L - max(n, k)` (`2^k` rows per Merkle leaf), the positions `a * 2^L + r + 2^s v`
+//! (`v < 2^(L-s)`) are the coset `zeta^a omega_L^r <omega_(L-s)>`, i.e. one size-`2^(L-s)` coset
+//! DFT of the zero-padded coefficients. A leaf's rows `u0 + t * 2^(L-k)` share the residue
+//! `u0 mod 2^s` (`s <= L - k`), so every sub-coset holds whole leaves. The leaves of one radix-2
+//! block (one `a`) are hashed into a block-sized digest buffer, reduced by `dropped` levels, and
+//! only the layers from level `dropped` upward are kept.
+//!
+//! Queries recompute what was dropped: an opened row is evaluated directly from the coefficients
+//! (Horner at the domain point), and the dropped lower subtree of a queried leaf is rebuilt from
+//! its `2^dropped` leaves. The tree's digests, roots, opened rows and (multi)proofs are identical
+//! to the in-memory `MerkleTree::new` / `MerkleTree::new_with_cosets`, so proofs are byte-identical.
+//!
+//! Switch: env `NEARPROOF_STREAM_COMMIT=1` (process-global, like the SHA levers) or
+//! [`set_stream_override`]; `NEARPROOF_STREAM_DROP` = dropped levels (default 4).
+//! `NEARPROOF_MEMPROF=1` prints RSS / peak RSS at prover phase boundaries ([`memprof`]).
+
+use std::{
+    collections::BTreeMap,
+    fmt,
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    },
+};
+
+use p3_dft::{Radix2DitParallel, TwoAdicSubgroupDft};
+use p3_field::{ExtensionField, PrimeField64, TwoAdicField};
+use p3_matrix::{bitrev::BitReversibleMatrix, dense::RowMajorMatrix, Matrix};
+use p3_maybe_rayon::prelude::*;
+use p3_util::{log2_ceil_usize, reverse_bits_len};
+
+use crate::{
+    hasher::MerkleHasher,
+    prover::{stacked_pcs::MerkleTree, ColMajorMatrix},
+};
+
+/// 0: follow the env, 1: force off, 2: force on.
+static OVERRIDE: AtomicUsize = AtomicUsize::new(0);
+
+/// Test hook: force streaming on / off (`None` = follow `NEARPROOF_STREAM_COMMIT`).
+pub fn set_stream_override(v: Option<bool>) {
+    OVERRIDE.store(
+        match v {
+            None => 0,
+            Some(false) => 1,
+            Some(true) => 2,
+        },
+        Ordering::SeqCst,
+    );
+}
+
+pub fn stream_enabled() -> bool {
+    match OVERRIDE.load(Ordering::SeqCst) {
+        1 => false,
+        2 => true,
+        _ => std::env::var("NEARPROOF_STREAM_COMMIT").map(|v| v == "1").unwrap_or(false),
+    }
+}
+
+/// Number of bottom tree levels that are not stored (recomputed on query).
+pub fn stream_drop_levels() -> usize {
+    std::env::var("NEARPROOF_STREAM_DROP")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(4)
+}
+
+/// Prints `MEMPROF <label> rss_gb=.. hwm_gb=..` when `NEARPROOF_MEMPROF=1`.
+pub fn memprof(label: &str) {
+    if std::env::var("NEARPROOF_MEMPROF").map(|v| v == "1").unwrap_or(false) {
+        let (mut rss, mut hwm) = (0.0, 0.0);
+        if let Ok(s) = std::fs::read_to_string("/proc/self/status") {
+            for l in s.lines() {
+                let kb = || l.split_whitespace().nth(1).and_then(|x| x.parse::<f64>().ok()).unwrap_or(0.0);
+                if l.starts_with("VmRSS") {
+                    rss = kb() / 1048576.0;
+                } else if l.starts_with("VmHWM") {
+                    hwm = kb() / 1048576.0;
+                }
+            }
+        }
+        println!("MEMPROF {label} rss_gb={rss:.2} hwm_gb={hwm:.2}");
+    }
+}
+
+/// Evaluates codeword rows (row index in the coset-major codeword) on demand.
+pub trait RowOracle<V>: Send + Sync {
+    fn rows(&self, row_indices: &[usize]) -> Vec<Vec<V>>;
+}
+
+/// The recompute side of a streamed [`MerkleTree`].
+pub struct StreamSource<V, Digest> {
+    /// Virtual codeword height `c * 2^L` and width (number of polynomials).
+    pub height: usize,
+    pub width: usize,
+    /// Number of bottom levels not stored: `digest_layers[0]` is level `dropped`.
+    pub dropped: usize,
+    pub oracle: Arc<dyn RowOracle<V>>,
+    pub hash_leaf: Arc<dyn Fn(&[Vec<V>]) -> Digest + Send + Sync>,
+    pub compress: Arc<dyn Fn(Digest, Digest) -> Digest + Send + Sync>,
+}
+
+impl<V, Digest> Clone for StreamSource<V, Digest> {
+    fn clone(&self) -> Self {
+        Self {
+            height: self.height,
+            width: self.width,
+            dropped: self.dropped,
+            oracle: self.oracle.clone(),
+            hash_leaf: self.hash_leaf.clone(),
+            compress: self.compress.clone(),
+        }
+    }
+}
+
+impl<V, Digest> fmt::Debug for StreamSource<V, Digest> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "StreamSource(height={}, width={}, dropped={})", self.height, self.width, self.dropped)
+    }
+}
+
+/// Coefficient-form oracle: column `j` is the polynomial `sum_i coeffs[j][i] X^i`, row `p` is the
+/// evaluation at `zeta^(p >> L) * omega_L^(p mod 2^L)`.
+pub struct PolyOracle<F, V> {
+    pub coeffs: Vec<Vec<V>>,
+    pub log_domain: usize,
+    pub zeta: F,
+}
+
+impl<F, V> PolyOracle<F, V>
+where
+    F: TwoAdicField + PrimeField64,
+    V: ExtensionField<F>,
+{
+    fn point(&self, p: usize) -> F {
+        let a = p >> self.log_domain;
+        let u = p & ((1 << self.log_domain) - 1);
+        self.zeta.exp_u64(a as u64) * F::two_adic_generator(self.log_domain).exp_u64(u as u64)
+    }
+}
+
+impl<F, V> RowOracle<V> for PolyOracle<F, V>
+where
+    F: TwoAdicField + PrimeField64,
+    V: ExtensionField<F>,
+{
+    fn rows(&self, row_indices: &[usize]) -> Vec<Vec<V>> {
+        const B: usize = 8;
+        let ncols = self.coeffs.len();
+        // one task per (row, block of B columns); the B Horner chains run interleaved
+        let tasks: Vec<(usize, usize)> =
+            (0..row_indices.len()).flat_map(|r| (0..ncols.div_ceil(B)).map(move |cb| (r, cb))).collect();
+        let vals: Vec<(usize, usize, [V; B])> = tasks
+            .into_par_iter()
+            .map(|(r, cb)| {
+                let x = self.point(row_indices[r]);
+                let cols = &self.coeffs[cb * B..((cb + 1) * B).min(ncols)];
+                let mut acc = [V::ZERO; B];
+                let len = cols.iter().map(|c| c.len()).max().unwrap_or(0);
+                for i in (0..len).rev() {
+                    for (j, c) in cols.iter().enumerate() {
+                        acc[j] = acc[j] * x + c.get(i).copied().unwrap_or(V::ZERO);
+                    }
+                }
+                (r, cb, acc)
+            })
+            .collect();
+        let mut out = vec![vec![V::ZERO; ncols]; row_indices.len()];
+        for (r, cb, acc) in vals {
+            for j in 0..B {
+                if cb * B + j < ncols {
+                    out[r][cb * B + j] = acc[j];
+                }
+            }
+        }
+        out
+    }
+}
+
+fn flatten_row<F: PrimeField64, V: ExtensionField<F>>(row: &[V]) -> Vec<F> {
+    row.iter().flat_map(|v| v.as_basis_coefficients_slice().to_vec()).collect()
+}
+
+/// Streamed commitment of the polynomials `coeffs` (each of length `<= 2^log_domain`) on the
+/// `c * 2^log_domain` domain with `rows_per_query` rows per leaf. Equal (root, digests, openings)
+/// to `MerkleTree::new_with_cosets(hasher, rs_encode(..), rows_per_query, c)`.
+pub fn stream_commit<F, V, H>(
+    hasher: &H,
+    coeffs: Vec<Vec<V>>,
+    log_domain: usize,
+    c: usize,
+    rows_per_query: usize,
+) -> MerkleTree<V, H::Digest>
+where
+    F: TwoAdicField + PrimeField64 + Ord,
+    V: ExtensionField<F> + TwoAdicField,
+    H: MerkleHasher<F = F>,
+{
+    let t0 = std::time::Instant::now();
+    let width = coeffs.len();
+    assert!(width > 0);
+    let d_ext = V::DIMENSION;
+    let k = log2_ceil_usize(rows_per_query);
+    assert_eq!(1 << k, rows_per_query);
+    assert!(k <= log_domain);
+    let len = coeffs.iter().map(|c| c.len()).max().unwrap();
+    let n = log2_ceil_usize(len.max(1));
+    assert!(n <= log_domain);
+    let s = log_domain - n.max(k);
+    let log_sub = log_domain - s;
+    let sub = 1usize << log_sub;
+    let log_qs = log_domain - k;
+    let qs = 1usize << log_qs;
+    let nv = qs >> s; // leaves per sub-coset
+    let dropped = stream_drop_levels().min(log_qs);
+    let zeta = if c == 1 { F::ONE } else { crate::odd_domain::odd_root::<F>(c) };
+    let omega = F::two_adic_generator(log_domain);
+
+    // Row-major base-field coefficient matrix: row i = coordinates of coefficient i of every
+    // polynomial (polynomial-major, basis order), zero rows up to the sub-coset size.
+    let bw = width * d_ext;
+    let mut base = F::zero_vec(sub * bw);
+    base.par_chunks_exact_mut(bw).enumerate().for_each(|(i, row)| {
+        for (j, col) in coeffs.iter().enumerate() {
+            if let Some(v) = col.get(i) {
+                row[j * d_ext..(j + 1) * d_ext].copy_from_slice(v.as_basis_coefficients_slice());
+            }
+        }
+    });
+
+    let dft = Radix2DitParallel::<F>::default();
+    let mut joined: Vec<H::Digest> = Vec::with_capacity((c * qs) >> dropped);
+    let filler = hasher.hash_slice(&[]);
+    for a in 0..c {
+        let za = zeta.exp_u64(a as u64);
+        let mut buf: Vec<H::Digest> = vec![filler; qs];
+        for r in 0..(1usize << s) {
+            let shift = za * omega.exp_u64(r as u64);
+            let evals = dft
+                .coset_dft_batch(RowMajorMatrix::new(base.clone(), bw), shift)
+                .bit_reverse_rows();
+            let digests: Vec<H::Digest> = (0..nv)
+                .into_par_iter()
+                .map(|v| {
+                    let rows: Vec<Vec<F>> = (0..rows_per_query)
+                        .map(|t| {
+                            let i = reverse_bits_len(v + t * nv, log_sub);
+                            evals.values[i * bw..(i + 1) * bw].to_vec()
+                        })
+                        .collect();
+                    hasher.hash_coset(&rows)
+                })
+                .collect();
+            drop(evals);
+            for (v, dg) in digests.into_iter().enumerate() {
+                buf[r + (v << s)] = dg;
+            }
+        }
+        for _ in 0..dropped {
+            buf = buf.par_chunks_exact(2).map(|p| hasher.compress(p[0], p[1])).collect();
+        }
+        joined.extend_from_slice(&buf);
+    }
+    drop(base);
+    let mut digest_layers = vec![joined];
+    while digest_layers.last().unwrap().len() > 1 {
+        let prev = digest_layers.last_mut().unwrap();
+        if prev.len() % 2 == 1 {
+            prev.push(filler);
+        }
+        let layer: Vec<_> = prev.par_chunks_exact(2).map(|p| hasher.compress(p[0], p[1])).collect();
+        digest_layers.push(layer);
+    }
+    if std::env::var("NEARPROOF_MEMPROF").map(|v| v == "1").unwrap_or(false) {
+        println!(
+            "STREAM_COMMIT width={width} ext={d_ext} c={c} log_domain={log_domain} k={k} n={n} sub=2^{log_sub} subcosets={} dropped={dropped} stored_digests={} secs={:.1}",
+            c << s,
+            digest_layers.iter().map(|l| l.len()).sum::<usize>(),
+            t0.elapsed().as_secs_f64()
+        );
+    }
+    let h1 = hasher.clone();
+    let h2 = hasher.clone();
+    let source = StreamSource {
+        height: c << log_domain,
+        width,
+        dropped,
+        oracle: Arc::new(PolyOracle::<F, V> { coeffs, log_domain, zeta }),
+        hash_leaf: Arc::new(move |rows: &[Vec<V>]| {
+            let flat: Vec<Vec<F>> = rows.iter().map(|r| flatten_row::<F, V>(r)).collect();
+            h1.hash_coset(&flat)
+        }),
+        compress: Arc::new(move |l, r| h2.compress(l, r)),
+    };
+    MerkleTree {
+        backing_matrix: ColMajorMatrix::new_any_height(vec![], width),
+        digest_layers,
+        rows_per_query,
+        num_cosets: c,
+        stream: Some(source),
+    }
+}
+
+impl<V: Clone + Send + Sync, Digest: Copy + Send + Sync> MerkleTree<V, Digest> {
+    /// Codeword row indices of leaf (query index) `index`.
+    pub(crate) fn leaf_row_indices(&self, index: usize) -> Vec<usize> {
+        let query_stride = self.query_stride();
+        let (base, stride, index) = if self.num_cosets == 1 {
+            (0, query_stride, index)
+        } else {
+            let qs = query_stride / self.num_cosets;
+            ((index / qs) * qs * self.rows_per_query, qs, index % qs)
+        };
+        (0..self.rows_per_query).map(|t| base + t * stride + index).collect()
+    }
+
+    /// Streamed tree: rebuilt lower subtrees (levels `0..dropped`) of the level-`dropped` blocks
+    /// containing `leaves`.
+    pub(crate) fn low_subtrees(&self, leaves: &[usize]) -> BTreeMap<usize, Vec<Vec<Digest>>> {
+        let src = self.stream.as_ref().unwrap();
+        let d = src.dropped;
+        let mut blocks: Vec<usize> = leaves.iter().map(|&i| i >> d).collect();
+        blocks.sort_unstable();
+        blocks.dedup();
+        if d == 0 {
+            return BTreeMap::new();
+        }
+        let leaf_ids: Vec<usize> = blocks.iter().flat_map(|&b| (b << d)..((b + 1) << d)).collect();
+        let row_ids: Vec<usize> = leaf_ids.iter().flat_map(|&i| self.leaf_row_indices(i)).collect();
+        let rows = src.oracle.rows(&row_ids);
+        let rpq = self.rows_per_query;
+        let leaf_digests: Vec<Digest> =
+            rows.par_chunks_exact(rpq).map(|leaf_rows| (src.hash_leaf)(leaf_rows)).collect();
+        let mut out = BTreeMap::new();
+        for (bi, &b) in blocks.iter().enumerate() {
+            let mut layers = vec![leaf_digests[(bi << d)..((bi + 1) << d)].to_vec()];
+            while layers.len() < d {
+                let prev = layers.last().unwrap();
+                let next: Vec<Digest> = prev.chunks_exact(2).map(|p| (src.compress)(p[0], p[1])).collect();
+                layers.push(next);
+            }
+            out.insert(b, layers);
+        }
+        out
+    }
+}
