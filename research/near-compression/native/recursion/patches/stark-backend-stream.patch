diff --git a/crates/stark-backend/tests/stream_commit.rs b/crates/stark-backend/tests/stream_commit.rs
new file mode 100644
--- /dev/null
+++ b/crates/stark-backend/tests/stream_commit.rs
@@ -0,0 +1,173 @@
+//! [stream research] The streamed commitment (codeword never materialised) is identical to the
+//! in-memory one: Merkle digests, roots, opened rows, single and multi proofs, and whole proofs.
+
+use openvm_stark_backend::{
+    codec::Encode,
+    poly_common::Squarable,
+    prover::{
+        stacked_pcs::{rs_code_matrix_odd, MerkleTree},
+        stream_pcs::{set_stream_override, stream_commit},
+        ColMajorMatrix,
+    },
+    test_utils::{test_system_params_small, FibFixture, InteractionsFixture11, TestFixture},
+    StarkEngine, StarkProtocolConfig, SystemParams, WhirConfig, WhirLevers, WhirParams,
+};
+use openvm_stark_sdk::config::baby_bear_poseidon2::*;
+use p3_field::{PrimeCharacteristicRing, BasedVectorSpace};
+use rand::{rngs::StdRng, Rng, SeedableRng};
+
+type SC = BabyBearPoseidon2Config;
+type Engine = BabyBearPoseidon2RefEngine<DuplexSponge>;
+type F = <SC as StarkProtocolConfig>::F;
+type EF = <SC as StarkProtocolConfig>::EF;
+
+fn with_levers(mut p: SystemParams, levers: WhirLevers, x15: usize, bits: usize) -> SystemParams {
+    let w = &p.whir;
+    let h = p.l_skip + p.n_stack;
+    let lf = if levers.k_first != 0 {
+        let lf0 = p.log_final_poly_len();
+        lf0 + (h - levers.k_first - lf0) % w.k
+    } else {
+        p.log_final_poly_len()
+    };
+    let wp = WhirParams {
+        k: w.k,
+        log_final_poly_len: lf,
+        proximity: w.proximity,
+        // no grinding: the CPU grinder is parallel, so its witness (and the proof) is not
+        // deterministic run to run
+        query_phase_pow_bits: 0,
+        folding_pow_bits: 0,
+        mu_pow_bits: 0,
+    };
+    p.logup.pow_bits = 0;
+    p.whir = WhirConfig::new_full(p.log_blowup, h, wp, bits, levers, x15);
+    p
+}
+
+fn check_tree<V, Digest>(mem: &MerkleTree<V, Digest>, st: &MerkleTree<V, Digest>, rng: &mut StdRng)
+where
+    V: Clone + Send + Sync + PartialEq + std::fmt::Debug + p3_field::Field,
+    Digest: Copy + Send + Sync + PartialEq + std::fmt::Debug,
+{
+    assert!(st.is_streamed() && !mem.is_streamed());
+    assert_eq!(mem.root().unwrap(), st.root().unwrap(), "root");
+    assert_eq!(mem.proof_depth(), st.proof_depth(), "depth");
+    assert_eq!(mem.query_stride(), st.query_stride(), "stride");
+    assert_eq!(mem.matrix_height(), st.matrix_height());
+    assert_eq!(mem.matrix_width(), st.matrix_width());
+    let d = mem.digest_layers().len() - st.digest_layers().len();
+    assert_eq!(&mem.digest_layers()[d..], &st.digest_layers()[..], "stored layers");
+    let qs = mem.query_stride();
+    let picks: Vec<usize> = if qs <= 64 { (0..qs).collect() } else { (0..64).map(|_| rng.random_range(0..qs)).collect() };
+    for &i in &picks {
+        assert_eq!(mem.get_opened_rows(i).unwrap(), st.get_opened_rows(i).unwrap(), "rows {i}");
+        assert_eq!(mem.query_merkle_proof(i).unwrap(), st.query_merkle_proof(i).unwrap(), "proof {i}");
+    }
+    for n in [1usize, 3, 17, 40] {
+        let idx: Vec<usize> = (0..n).map(|_| rng.random_range(0..qs)).collect();
+        assert_eq!(mem.query_multiproof(&idx).unwrap(), st.query_multiproof(&idx).unwrap(), "multiproof");
+    }
+    // adjacent leaves (siblings derivable inside a dropped subtree)
+    let idx: Vec<usize> = (0..8.min(qs)).collect();
+    assert_eq!(mem.query_multiproof(&idx).unwrap(), st.query_multiproof(&idx).unwrap(), "multiproof adj");
+}
+
+#[test]
+fn stream_tree_matches_in_memory() {
+    let engine = Engine::new(test_system_params_small(2, 8, 3));
+    let hasher = engine.config().hasher().clone();
+    let mut rng = StdRng::seed_from_u64(7);
+    for drop in ["0", "2", "4", "30"] {
+        std::env::set_var("NEARPROOF_STREAM_DROP", drop);
+        for c in [1usize, 3, 15] {
+            // base field, several columns (initial round): n = 8 coefficients, blowup 2..3, k 1..3
+            for (log_n, b, k) in [(8usize, 2usize, 1usize), (8, 3, 3), (6, 1, 2)] {
+                let w = 5;
+                let coeffs: Vec<Vec<F>> =
+                    (0..w).map(|_| (0..1 << log_n).map(|_| F::from_u32(rng.random::<u32>() >> 2)).collect()).collect();
+                let log_rs = log_n + b;
+                let cw: Vec<F> = coeffs
+                    .iter()
+                    .flat_map(|col| openvm_stark_backend::odd_domain::rs_encode::<F, F>(col.clone(), log_rs, c))
+                    .collect();
+                let mem = MerkleTree::new_with_cosets(&hasher, ColMajorMatrix::new_any_height(cw, w), 1 << k, c).unwrap();
+                let st = stream_commit::<F, F, _>(&hasher, coeffs, log_rs, c, 1 << k);
+                check_tree(&mem, &st, &mut rng);
+            }
+            // extension field, one column (later WHIR rounds), keep-domain style rate
+            for (log_n, log_rs, k) in [(5usize, 9usize, 4usize), (7, 9, 3), (3, 6, 3)] {
+                let col: Vec<EF> = (0..1 << log_n)
+                    .map(|_| EF::from_basis_coefficients_fn(|_| F::from_u32(rng.random::<u32>() >> 2)))
+                    .collect();
+                let cw = openvm_stark_backend::odd_domain::rs_encode::<F, EF>(col.clone(), log_rs, c);
+                let mem = MerkleTree::new_with_cosets(&hasher, ColMajorMatrix::new_any_height(cw, 1), 1 << k, c).unwrap();
+                let st = stream_commit::<F, EF, _>(&hasher, vec![col], log_rs, c, 1 << k);
+                check_tree(&mem, &st, &mut rng);
+            }
+        }
+    }
+    std::env::remove_var("NEARPROOF_STREAM_DROP");
+    // the stacked-commit helper agrees with the per-column encoder used above
+    let m = ColMajorMatrix::new((0..64).map(F::from_u32).collect(), 2);
+    assert_eq!(rs_code_matrix_odd(2, 2, 3, &m).unwrap().values.len(), 2 * 3 * 128);
+    let _ = F::ONE.exp_powers_of_2();
+}
+
+fn prove_bytes(p: &SystemParams, fixture: usize, stream: bool) -> Vec<u8> {
+    set_stream_override(Some(stream));
+    let e = Engine::new(p.clone());
+    let (vk, pr) = if fixture == 0 {
+        FibFixture::new(0, 1, 1 << 9).keygen_and_prove(&e)
+    } else {
+        InteractionsFixture11.keygen_and_prove(&e)
+    };
+    e.verify(&vk, &pr).expect("proof verifies");
+    let mut b = vec![];
+    pr.encode(&mut b).unwrap();
+    set_stream_override(None);
+    b
+}
+
+/// Streamed and in-memory proofs are byte-identical at b = 2 (rate 1/4) on a small trace, for the
+/// upstream shape and for every WHIR lever together with the x15 domain (k1 = 1, keep-domain,
+/// multiproof), and for several dropped-level counts.
+#[test]
+fn stream_proof_byte_identical_b2() {
+    let all = WhirLevers {
+        k_first: 1,
+        keep_domain: true,
+        multiproof: true,
+        tight_heights: true,
+        whir_y: true,
+        ..Default::default()
+    };
+    let cases: Vec<(&str, WhirLevers, usize)> = vec![
+        ("default", WhirLevers::default(), 1),
+        ("x15", WhirLevers::default(), 15),
+        ("levers", all, 1),
+        ("levers+x15", all, 15),
+    ];
+    for (name, lv, x15) in cases {
+        let mut p = test_system_params_small(2, 10, 3);
+        p.max_constraint_degree = 4;
+        p.log_blowup = 2;
+        let p = with_levers(p, lv, x15, 40);
+        for fx in 0..2 {
+            let mem = prove_bytes(&p, fx, false);
+            let mem2 = prove_bytes(&p, fx, false);
+            println!("STREAM_DETERMINISTIC case={name} fixture={fx} {}", mem == mem2);
+            for drop in ["0", "3", "4"] {
+                std::env::set_var("NEARPROOF_STREAM_DROP", drop);
+                let st = prove_bytes(&p, fx, true);
+                if mem != st {
+                    let pos = mem.iter().zip(&st).position(|(a, b)| a != b);
+                    println!("STREAM_DIFF first={pos:?} lens {} {}", mem.len(), st.len());
+                }
+                println!("STREAM_IDENTITY case={name} fixture={fx} drop={drop} bytes={} identical={}", mem.len(), mem == st);
+                assert_eq!(mem, st, "streamed proof differs: {name} fixture {fx} drop {drop}");
+            }
+            std::env::remove_var("NEARPROOF_STREAM_DROP");
+        }
+    }
+}
