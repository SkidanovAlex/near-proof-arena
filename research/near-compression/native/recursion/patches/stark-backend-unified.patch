+/// Lever `next_mask`: per opened part (common main, preprocessed, cached mains), the columns read
+/// at offset 1 by any node of the constraint/interaction DAG.
+pub(crate) fn rotated_columns<F: Field>(
+    constraints: &SymbolicConstraintsDag<F>,
+    width: &TraceWidth,
+) -> Vec<Vec<bool>> {
+    let mut preprocessed = vec![false; width.preprocessed.unwrap_or(0)];
+    let mut main: Vec<Vec<bool>> = width.main_widths().into_iter().map(|w| vec![false; w]).collect();
+    for node in &constraints.constraints.nodes {
+        let SymbolicExpressionNode::Variable(var) = node else {
+            continue;
+        };
+        match var.entry {
+            Entry::Preprocessed { offset } if offset > 0 => preprocessed[var.index] = true,
+            Entry::Main { part_index, offset } if offset > 0 => main[part_index][var.index] = true,
+            _ => {}
+        }
+    }
+    // main_widths() lists cached mains first and the common main last (when non-empty).
+    let common = if width.common_main != 0 { main.pop().unwrap() } else { vec![] };
+    std::iter::once(common)
+        .chain(width.preprocessed.map(|_| preprocessed))
+        .chain(main)
+        .collect()
+}
