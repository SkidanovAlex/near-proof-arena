index 0000000..84d3de3
--- /dev/null
+++ b/crates/stark-backend/src/odd_domain.rs
@@ -0,0 +1,107 @@
+//! [x15 research] Reed-Solomon evaluation domains of size `c * 2^L` (`c` odd, `c | p - 1`).
+//!
+//! The domain is the multiplicative subgroup `D` of order `c * 2^L`. Since `gcd(c, 2^L) = 1`,
+//! `D = <zeta> x H` with `zeta = GENERATOR^((p-1)/c)` of order `c` and `H = <omega_L>` the
+//! two-adic subgroup of order `2^L`, i.e. `D` is the disjoint union of the `c` cosets
+//! `zeta^a * H`, `a in [0, c)`.
+//!
+//! Layout ("coset-major"): codeword position `a * 2^L + u` holds the value at `zeta^a * omega_L^u`.
+//! Coset `a` is an ordinary radix-2 coset LDE with shift `zeta^a`.
+//!
+//! WHIR folding uses `x -> x^(2^k)`, whose fibres are `x * <omega_{2^k}>`. With the layout above
+//! the fibre of `zeta^a * omega_L^u0` (`u0 < 2^(L-k)`) is the `2^k` positions
+//! `a * 2^L + u0 + j * 2^(L-k)` of coset `a`, so each fold coset lies inside one radix-2 block and
+//! the Merkle tree is built per block (upstream layout) and then joined across the `c` blocks.
+//! Query index `i = a * 2^(L-k) + u0` in `[0, c * 2^(L-k))`; the map
+//! `i -> (zeta^a omega_L^u0)^(2^k) = zeta^(a 2^k) omega_(L-k)^u0` is a bijection onto `D^(2^k)`
+//! (2 is invertible mod `c`), so a uniform index gives a uniform point of the folded domain,
+//! as WHIR's shift/final query analysis requires.
+//!
+//! For `c = 1` every function here reduces to the upstream power-of-two behaviour.
+
+use p3_dft::{Radix2DitParallel, TwoAdicSubgroupDft};
+use p3_field::{ExtensionField, Field, PrimeField64, TwoAdicField};
+use p3_maybe_rayon::prelude::*;
+
+use crate::{FiatShamirTranscript, StarkProtocolConfig};
+
+/// `ceil(log2(c))`, the extra Merkle depth of a `c`-coset tree (binary tree padded at the top).
+pub fn ceil_log2(c: usize) -> usize {
+    assert!(c >= 1);
+    (usize::BITS - (c - 1).leading_zeros()) as usize
+}
+
+/// Checks that `c` is a valid odd domain factor for `F`.
+pub fn check_odd_factor<F: PrimeField64>(c: usize) {
+    assert!(c >= 1 && c % 2 == 1, "domain odd factor must be odd, got {c}");
+    assert_eq!(
+        (F::ORDER_U64 - 1) % (c as u64),
+        0,
+        "domain odd factor {c} does not divide p - 1"
+    );
+}
+
+/// Generator `zeta` of the order-`c` subgroup: `GENERATOR^((p-1)/c)`.
+pub fn odd_root<F: Field + PrimeField64>(c: usize) -> F {
+    check_odd_factor::<F>(c);
+    F::GENERATOR.exp_u64((F::ORDER_U64 - 1) / (c as u64))
+}
+
+/// The fold-coset root `x = zeta^a * omega_L^u0` of query index `i = a * 2^(L-k) + u0`, where
+/// `log_domain = L` is the two-adic part of the current RS domain.
+pub fn query_root<F: TwoAdicField + PrimeField64>(
+    c: usize,
+    log_domain: usize,
+    k: usize,
+    index: usize,
+) -> F {
+    let omega = F::two_adic_generator(log_domain);
+    if c == 1 {
+        return omega.exp_u64(index as u64);
+    }
+    let log_q = log_domain - k;
+    let a = index >> log_q;
+    let u0 = index & ((1 << log_q) - 1);
+    debug_assert!(a < c);
+    odd_root::<F>(c).exp_u64(a as u64) * omega.exp_u64(u0 as u64)
+}
+
+/// Samples a WHIR query index. `c = 1`: upstream `sample_bits(log_q)`. `c > 1`: exactly uniform
+/// over `[0, c * 2^log_q)` by [`FiatShamirTranscript::sample_index_exact`].
+pub fn sample_query_index<SC: StarkProtocolConfig, TS: FiatShamirTranscript<SC>>(
+    transcript: &mut TS,
+    c: usize,
+    log_q: usize,
+) -> usize {
+    if c == 1 {
+        transcript.sample_bits(log_q) as usize
+    } else {
+        transcript.sample_index_exact((c as u64) << log_q) as usize
+    }
+}
+
+/// Reed-Solomon encodes the coefficient vector `coeffs` (length `<= 2^log_coset`) on the
+/// `c * 2^log_coset` domain, coset-major. `c = 1` is exactly the upstream `dft(coeffs)`.
+pub fn rs_encode<F, V>(mut coeffs: Vec<V>, log_coset: usize, c: usize) -> Vec<V>
+where
+    F: Field + PrimeField64,
+    V: TwoAdicField + ExtensionField<F> + Ord,
+{
+    let n = 1usize << log_coset;
+    assert!(coeffs.len() <= n);
+    coeffs.resize(n, V::ZERO);
+    let dft = Radix2DitParallel::default();
+    if c == 1 {
+        return dft.dft(coeffs);
+    }
+    let zeta = odd_root::<F>(c);
+    let shifts: Vec<F> = zeta.powers().take(c).collect();
+    let blocks: Vec<Vec<V>> = shifts
+        .into_par_iter()
+        .map(|shift| {
+            let dft = Radix2DitParallel::<V>::default();
+            dft.coset_dft(coeffs.clone(), V::from(shift))
+        })
+        .collect();
+    blocks.concat()
+}
