+    /// the certificate set used at setup); false: Johnson fallback, m = 64 (O-1, DKT26 Thm 5.12)
+    pub first_order: bool,
+}
+
+/// DKT26 certificate set: (n, k, A) triples (lane/pq-dkt-verify calc/dkt_certs.json, ell = 1).
+pub type CertSet = std::collections::HashSet<(u64, u64, u64)>;
+
+/// DKT26 first-order agreement a1(rho) (size_mca.py / bound_mca.py).
+pub fn dkt_a1(r: f64) -> f64 {
+    let rc = 11.0 - 3.0 * 13f64.sqrt();
+    if r < rc {
+        let s = (r / 2.0).sqrt();
+        let (mut lo, mut hi) = (0.0f64, 1.0f64);
+        for _ in 0..200 {
+            let mid = (lo + hi) / 2.0;
+            if mid * mid * (mid + 3.0) < s {
+                lo = mid;
+            } else {
+                hi = mid;
+            }
+        }
+        s * (1.0 + lo)
+    } else {
+        (3.0 * r + 2.0 * (r * (5.0 - r) * (2.0 - r)).sqrt()) / (8.0 - r)
+    }
+}
+
+impl AgreementTable {
+    /// O-2 first-order threshold of the round code (n, k).
+    pub fn first_order_agree(n: u64, kdim: u64, margin_milli: u32, m: u32) -> u64 {
+        let cap = 1.0 + 1.0 / (2.0 * m.max(1) as f64);
+        let rho = kdim as f64 / n as f64;
+        let ratio = (dkt_a1(rho) / rho.sqrt() + margin_milli as f64 / 1000.0).min(cap);
+        (ratio * ((kdim - 1) as f64 / n as f64).sqrt() * n as f64).ceil() as u64
+    }
+    /// Johnson fallback threshold (1 + 1/(2m)) sqrt(k/n) n (O-1).
+    pub fn johnson_agree(n: u64, kdim: u64, m: u32) -> u64 {
+        let rho = kdim as f64 / n as f64;
+        ((1.0 + 1.0 / (2.0 * m.max(1) as f64)) * rho.sqrt() * n as f64).ceil() as u64
+    }
+    /// Whether the round code and its fold sub-codes s = 0..=k_round are certified.
+    pub fn certified(certs: &CertSet, n: u64, kdim: u64, agree: u64, k_round: usize) -> bool {
+        (0..=k_round).all(|s| certs.contains(&(n >> s, kdim >> s, (agree + (1u64 << s) - 1) >> s)))
+    }
+    fn round(n: u64, kdim: u64, agree: u64, first_order: bool, target_bits: u32) -> AgreementRound {
+        let per_query = -((agree as f64) / (n as f64)).log2();
+        let queries = ((target_bits as f64) / per_query).ceil() as u32;
+        AgreementRound { n, kdim, agree, queries, first_order }
+    }
+    /// The canonical table for a WHIR schedule (round codes `(n_i, k_i)`, folding factors
+    /// `k_rounds`): a round uses its first-order threshold iff it is certified in `certs`;
+    /// otherwise (or without a certificate set) the Johnson fallback.
+    pub fn canonical(codes: &[(u64, u64)], k_rounds: &[usize], target_bits: u32, margin_milli: u32, m: u32, certs: Option<&CertSet>, max_commits: usize) -> Self {
+        let rounds = codes
+            .iter()
+            .zip(k_rounds)
+            .enumerate()
+            .map(|(i, (&(n, kdim), &kr))| {
+                let fo = Self::first_order_agree(n, kdim, margin_milli, m);
+                // round 0 of a layer with several commitments: Johnson (the round-0 list is
+                // squared by the commitment batching; final-soundness o2_table_bound.py)
+                let allowed = i > 0 || max_commits <= 1;
+                if allowed && certs.is_some_and(|c| Self::certified(c, n, kdim, fo, kr)) {
+                    Self::round(n, kdim, fo, true, target_bits)
+                } else {
+                    Self::round(n, kdim, Self::johnson_agree(n, kdim, m), false, target_bits)
+                }
+            })
+            .collect();
+        Self { target_bits, margin_milli, m, rounds }
+    }
+    /// Each round's threshold follows its declared regime's rule, with its query count.
+    pub fn consistent(&self, codes: &[(u64, u64)]) -> bool {
+        self.rounds.len() == codes.len()
+            && self.rounds.iter().zip(codes).all(|(r, &(n, kdim))| {
+                let agree = if r.first_order {
+                    Self::first_order_agree(n, kdim, self.margin_milli, self.m)
+                } else {
+                    Self::johnson_agree(n, kdim, self.m)
+                };
+                *r == Self::round(n, kdim, agree, r.first_order, self.target_bits)
+            })
+    }
+    /// Setup check (V_d / tests): every first-order round is certified in `certs`.
+    pub fn all_first_order_certified(&self, certs: &CertSet, k_rounds: &[usize]) -> bool {
+        self.rounds
+            .iter()
+            .zip(k_rounds)
+            .all(|(r, &kr)| !r.first_order || Self::certified(certs, r.n, r.kdim, r.agree, kr))
+    }
+}
