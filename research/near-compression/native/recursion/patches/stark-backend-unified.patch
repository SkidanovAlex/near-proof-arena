+/// Lever wire format of [`BatchConstraintProof`]: as upstream, except that after `n_max` and
+/// `s_deg` it writes `g:u32`, the number of leading rounds whose last evaluation is zero, and
+/// omits that (zero) evaluation in those rounds. Lossless; the verifier decides independently
+/// which rounds are Gruen rounds (`gruen_zerocheck`) and requires their last entry to be zero.
+impl<SC: StarkProtocolConfig> BatchConstraintProof<SC> {
+    pub fn encode_levers<W: Write>(&self, writer: &mut W) -> Result<()>
+    where
+        SC: EncodableConfig,
+    {
+        SC::encode_extension_field_slice(&self.numerator_term_per_air, writer)?;
+        SC::encode_extension_field_iter(self.denominator_term_per_air.iter(), writer)?;
+        SC::encode_extension_field_slice(&self.univariate_round_coeffs, writer)?;
+        let n_max = self.sumcheck_round_polys.len();
+        n_max.encode(writer)?;
+        if n_max > 0 {
+            let s_deg = self.sumcheck_round_polys[0].len();
+            s_deg.encode(writer)?;
+            let g = self
+                .sumcheck_round_polys
+                .iter()
+                .take_while(|r| r.last().is_some_and(|x| *x == SC::EF::ZERO))
+                .count();
+            g.encode(writer)?;
+            for (i, round_polys) in self.sumcheck_round_polys.iter().enumerate() {
+                if round_polys.len() != s_deg {
+                    return Err(invalid("ragged batch sumcheck rounds"));
+                }
+                let n = if i < g { s_deg - 1 } else { s_deg };
+                SC::encode_extension_field_iter(round_polys[..n].iter(), writer)?;
+            }
+        }
+        for part_col_openings in &self.column_openings {
+            part_col_openings.len().encode(writer)?;
+            for col_opening in part_col_openings {
+                SC::encode_extension_field_slice(col_opening, writer)?;
+            }
+        }
+        Ok(())
+    }
+
+    pub fn decode_levers<R: Read>(reader: &mut R) -> Result<Self>
+    where
+        SC: DecodableConfig,
+    {
+        let numerator_term_per_air = SC::decode_extension_field_vec(reader)?;
+        let num_present_airs = numerator_term_per_air.len();
+        let denominator_term_per_air = SC::decode_extension_field_n(reader, num_present_airs)?;
+        let univariate_round_coeffs = SC::decode_extension_field_vec(reader)?;
+        let n_max = usize::decode(reader)?;
+        let mut sumcheck_round_polys = vec_with_capped_capacity(n_max);
+        if n_max > 0 {
+            let s_deg = usize::decode(reader)?;
+            let g = usize::decode(reader)?;
+            if s_deg == 0 || g > n_max {
+                return Err(invalid("batch sumcheck shape"));
+            }
+            for i in 0..n_max {
+                let mut v = SC::decode_extension_field_n(reader, if i < g { s_deg - 1 } else { s_deg })?;
+                if i < g {
+                    v.push(SC::EF::ZERO);
+                }
+                sumcheck_round_polys.push(v);
+            }
+        }
+        let mut column_openings = vec_with_capped_capacity(num_present_airs);
+        for _ in 0..num_present_airs {
+            let num_parts = usize::decode(reader)?;
+            let mut parts = vec_with_capped_capacity(num_parts);
+            for _ in 0..num_parts {
+                parts.push(SC::decode_extension_field_vec(reader)?);
+            }
+            column_openings.push(parts);
+        }
+        Ok(Self {
+            numerator_term_per_air,
+            denominator_term_per_air,
+            univariate_round_coeffs,
+            sumcheck_round_polys,
+            column_openings,
+        })
+    }
+}
+
+/// Lever wire format of [`GkrProof`]: `logup_pow_witness:F, num_layers:u32`, per layer
+/// `p_xi_0, q_xi_0, [p_xi_1 unless gkr_derive_claims], q_xi_1`, then `q0_claim` unless
+/// (`gkr_derive_claims` and num_layers > 0), then per layer-sumcheck round `s(1), s(2),
+/// [s(3) unless gruen_gkr]`. Omitted fields decode as zero (the verifier derives them).
+impl<SC: StarkProtocolConfig> GkrProof<SC> {
+    pub fn encode_levers<W: Write>(&self, levers: &WhirLevers, writer: &mut W) -> Result<()>
+    where
+        SC: EncodableConfig,
+    {
+        let derive = levers.gkr_derive_claims && !self.claims_per_layer.is_empty();
+        SC::encode_base_field(&self.logup_pow_witness, writer)?;
+        self.claims_per_layer.len().encode(writer)?;
+        for c in &self.claims_per_layer {
+            SC::encode_extension_field(&c.p_xi_0, writer)?;
+            SC::encode_extension_field(&c.q_xi_0, writer)?;
+            if !derive {
+                SC::encode_extension_field(&c.p_xi_1, writer)?;
+            }
+            SC::encode_extension_field(&c.q_xi_1, writer)?;
+        }
+        if !derive {
+            SC::encode_extension_field(&self.q0_claim, writer)?;
+        }
+        let n = if levers.gruen_gkr { 2 } else { 3 };
+        for round in &self.sumcheck_polys {
+            for arr in round {
+                SC::encode_extension_field_iter(arr[..n].iter(), writer)?;
+            }
+        }
+        Ok(())
+    }
+
+    pub fn decode_levers<R: Read>(reader: &mut R, levers: &WhirLevers) -> Result<Self>
+    where
+        SC: DecodableConfig,
+    {
+        let logup_pow_witness = SC::decode_base_field(reader)?;
+        let num_layers = usize::decode(reader)?;
+        if num_layers > 64 {
+            return Err(invalid("GKR layer count"));
+        }
+        let derive = levers.gkr_derive_claims && num_layers > 0;
+        let mut claims_per_layer = Vec::with_capacity(num_layers);
+        for _ in 0..num_layers {
+            let p_xi_0 = SC::decode_extension_field(reader)?;
+            let q_xi_0 = SC::decode_extension_field(reader)?;
+            let p_xi_1 = if derive {
+                SC::EF::ZERO
+            } else {
+                SC::decode_extension_field(reader)?
+            };
+            let q_xi_1 = SC::decode_extension_field(reader)?;
+            claims_per_layer.push(GkrLayerClaims {
+                p_xi_0,
+                q_xi_0,
+                p_xi_1,
+                q_xi_1,
+            });
+        }
+        let q0_claim = if derive {
+            SC::EF::ZERO
+        } else {
+            SC::decode_extension_field(reader)?
+        };
+        let mut sumcheck_polys = Vec::with_capacity(num_layers.saturating_sub(1));
+        for n in 1..num_layers {
+            let mut round = Vec::with_capacity(n);
+            for _ in 0..n {
+                let a = SC::decode_extension_field(reader)?;
