+/// G-11 (final-soundness GAPS): with zero PoW bits the witness must be zero (non-malleable).
+#[test]
+fn test_zero_bit_pow_requires_zero_witness() {
+    let mut s = default_duplex_sponge();
+    assert!(FiatShamirTranscript::<SC>::check_witness(&mut s, 0, BabyBear::ZERO));
+    assert!(!FiatShamirTranscript::<SC>::check_witness(&mut s, 0, BabyBear::ONE));
+    assert!(FiatShamirTranscript::<SC>::check_witness_wide(&mut s, 0, [BabyBear::ZERO; 2]));
+    assert!(!FiatShamirTranscript::<SC>::check_witness_wide(&mut s, 0, [BabyBear::ZERO, BabyBear::ONE]));
+}
