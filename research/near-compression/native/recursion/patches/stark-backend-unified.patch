+    pub gkr_derive_claims: bool,
+    /// Next-row (rotated) column openings only for columns that some constraint or interaction
+    /// reads at offset 1 (per-column mask computed at keygen and stored in the verifying key).
+    pub next_mask: bool,
+    /// Batch-constraint sumcheck rounds in which no trace is exhausted send one evaluation less:
+    /// there `s(X) = eq(xi, X) * s'(X)` and the verifier reconstructs s' (Gruen).
+    pub gruen_zerocheck: bool,
+    /// Query-phase proof-of-work witnesses are two field elements (`grind_wide`), so
