+/// Proof-size levers layered on upstream WHIR. `WhirLevers::default()` is exactly upstream.
+#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize, PartialEq, Eq)]
+pub struct WhirLevers {
+    /// Folding factor of the first WHIR round (the stacked commitment's leaves hold `2^k_first`
+    /// rows). `0` means "same as `k`".
+    pub k_first: usize,
+    /// Send each round's Merkle openings as one canonical batched multiproof (siblings that the
+    /// verifier can compute from other opened leaves are omitted).
+    pub multiproof: bool,
+    /// Keep every WHIR round's evaluation domain at the initial size instead of halving it, so
+    /// the rate improves by `2^k` per round instead of `2^(k-1)`.
+    pub keep_domain: bool,
+    /// GKR layer sumchecks send only s(1), s(2): the round polynomial is `c * eq(xi_t, X) * t(X)`
+    /// with `t` quadratic, so the verifier reconstructs it (Gruen, ePrint 2024/108).
+    pub gruen_gkr: bool,
+    /// GKR claims the verifier can derive are not sent: `p_xi_1` of every layer (from the layer
