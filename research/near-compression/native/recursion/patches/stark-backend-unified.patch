+    pub wide_query_pow: bool,
+    /// Padding-free trace heights: each common-main trace commits only its rows up to the last
+    /// non-zero row (rounded up to `2^l_skip`), as power-of-two chunks; the zerocheck and GKR still
+    /// run over the power-of-two height with a virtual zero tail.
+    pub tight_heights: bool,
+    /// [NV lane, WHIR-Y] Observe each round's shift-query answers y_{i,.} (the folded values at
+    /// the query points, including the final round) before sampling gamma_i. Zero bytes; needed
+    /// for any future digest narrowing (lane/pq-weak-binding HROB.md).
+    pub whir_y: bool,
+}
+
+impl WhirLevers {
+    pub fn is_default(&self) -> bool {
+        *self == Self::default()
+    }
+
+    /// Wire flags byte for the GKR / opening levers (bit 0 gruen_gkr, bit 1 gkr_derive_claims,
+    /// bit 2 next_mask).
+    pub fn flags(&self) -> u8 {
+        self.gruen_gkr as u8
+            | (self.gkr_derive_claims as u8) << 1
+            | (self.next_mask as u8) << 2
+            | (self.gruen_zerocheck as u8) << 3
+            | (self.wide_query_pow as u8) << 4
+            | (self.tight_heights as u8) << 5
+            | (self.whir_y as u8) << 6
+    }
 }
 
