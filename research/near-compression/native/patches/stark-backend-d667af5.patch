+impl<SC: StarkProtocolConfig> StackedReductionCpuNew<'_, SC> {
+    pub fn nearproof_replace_column_weights(&mut self, pairs: &[[SC::EF; 2]]) {
+        assert_eq!(pairs.len(), self.trace_views.len());
+        for (tv, pair) in self.trace_views.iter().zip(pairs) {
+            self.lambda_pows[tv.lambda_eq_idx] = pair[0];
+            if let Some(i) = tv.lambda_rot_idx {
+                self.lambda_pows[i] = pair[1];
+            } else {
