+/// Per-column version of [`column_openings_by_rot`]: column `i` carries a rotated claim iff
+/// `mask[i]` (otherwise its rotated claim is 0 and absent from the proof).
+pub fn column_openings_by_mask<EF: PrimeCharacteristicRing + Copy>(
+    openings: &[EF],
+    mask: &[bool],
+) -> Vec<(EF, EF)> {
+    let mut out = Vec::with_capacity(mask.len());
+    let mut it = openings.iter();
+    for &rot in mask {
+        let (Some(&c), r) = (it.next(), if rot { it.next().copied() } else { Some(EF::ZERO) }) else {
+            break;
+        };
+        let Some(r) = r else { break };
+        out.push((c, r));
+    }
+    out
+}
