+/// Lever wire format of [`WhirProof`] (used iff `levers` is non-default; the enclosing proof then
+/// carries `CODEC_VERSION_LEVERS`):
+///
+/// ```text
+/// (the 4-byte lever header k_first, multiproof, keep_domain, flags precedes the whole proof body)
+/// mu_pow_witness:F
+/// num_sumcheck_rounds:u32  [2 x EF] * num_sumcheck_rounds
+/// codeword_commits: u32 len + digests        (num_whir_rounds = len + 1)
+/// ood_values: EF * (num_whir_rounds - 1)
+/// folding_pow_witnesses: F * num_sumcheck_rounds
+/// query_phase_pow_witnesses: F * num_whir_rounds
+/// num_commits:u32  q0:u32  width:u32 * num_commits
+/// opened rows: per commit, per query, 2^k_first rows of `width` F
+/// initial Merkle: per commit: multiproof ? (u32 count + digests) : (u32 depth, then q0*depth digests)
+/// per later round r: q_r:u32, then q_r * 2^k EF values
+/// per later round r: multiproof ? (u32 count + digests) : (u32 depth, then q_r*depth digests)
+/// final_poly: u32 len + EF values
+/// ```
+impl<SC: StarkProtocolConfig> WhirProof<SC> {
+    pub fn encode_levers<W: Write>(&self, writer: &mut W) -> Result<()>
+    where
+        SC: EncodableConfig,
+    {
+        let lv = &self.levers;
+        SC::encode_base_field(&self.mu_pow_witness, writer)?;
+        self.whir_sumcheck_polys.len().encode(writer)?;
+        for arr in &self.whir_sumcheck_polys {
+            SC::encode_extension_field_iter(arr.iter(), writer)?;
+        }
+        SC::encode_digest_slice(&self.codeword_commits, writer)?;
+        SC::encode_extension_field_iter(self.ood_values.iter(), writer)?;
+        SC::encode_base_field_iter(self.folding_pow_witnesses.iter(), writer)?;
+        SC::encode_base_field_iter(self.query_phase_pow_witnesses.iter(), writer)?;
+        let num_commits = self.initial_round_opened_rows.len();
+        num_commits.encode(writer)?;
+        let q0 = self.initial_round_opened_rows[0].len();
+        q0.encode(writer)?;
+        let widths: Vec<usize> = self
+            .initial_round_opened_rows
+            .iter()
+            .map(|c| c.first().and_then(|q| q.first()).map(|r| r.len()).unwrap_or(0))
+            .collect();
+        for w in &widths {
+            w.encode(writer)?;
+        }
+        for (commit_rows, &width) in self.initial_round_opened_rows.iter().zip(&widths) {
+            for query_rows in commit_rows {
+                for row in query_rows {
+                    if row.len() != width {
+                        return Err(invalid("ragged opened rows"));
+                    }
+                    SC::encode_base_field_iter(row.iter(), writer)?;
+                }
+            }
+        }
+        let encode_paths = |groups: &[Vec<Vec<SC::Digest>>], writer: &mut W| -> Result<()> {
+            for proofs in groups {
+                if lv.multiproof {
+                    if proofs.len() != 1 {
+                        return Err(invalid("multiproof must be a single entry"));
+                    }
+                    SC::encode_digest_slice(&proofs[0], writer)?;
+                } else {
+                    let depth = proofs.first().map(|p| p.len()).unwrap_or(0);
+                    depth.encode(writer)?;
+                    for p in proofs {
+                        if p.len() != depth {
+                            return Err(invalid("ragged merkle paths"));
+                        }
+                        SC::encode_digest_iter(p.iter(), writer)?;
+                    }
+                }
+            }
+            Ok(())
+        };
+        encode_paths(&self.initial_round_merkle_proofs, writer)?;
+        for round in &self.codeword_opened_values {
+            round.len().encode(writer)?;
+            for vals in round {
+                SC::encode_extension_field_iter(vals.iter(), writer)?;
+            }
+        }
+        for round in &self.codeword_merkle_proofs {
+            encode_paths(std::slice::from_ref(round), writer)?;
+        }
+        SC::encode_extension_field_slice(&self.final_poly, writer)
+    }
+
+    pub fn decode_levers<R: Read>(reader: &mut R, levers: WhirLevers) -> Result<Self>
+    where
+        SC: DecodableConfig,
+    {
+        let WhirLevers {
+            k_first,
+            multiproof,
+            ..
+        } = levers;
+        let mu_pow_witness = SC::decode_base_field(reader)?;
+        let num_sumcheck = usize::decode(reader)?;
+        let mut whir_sumcheck_polys = vec_with_capped_capacity(num_sumcheck);
+        for _ in 0..num_sumcheck {
+            whir_sumcheck_polys.push([
+                SC::decode_extension_field(reader)?,
+                SC::decode_extension_field(reader)?,
+            ]);
+        }
+        let codeword_commits = SC::decode_digest_vec(reader)?;
+        let num_rounds = codeword_commits.len() + 1;
+        // Per-round folding factors: round 0 folds k_first (or k), the rest fold k.
+        let (k0, k) = if k_first == 0 {
+            if num_sumcheck % num_rounds != 0 {
+                return Err(invalid("sumcheck rounds not a multiple of WHIR rounds"));
+            }
+            (num_sumcheck / num_rounds, num_sumcheck / num_rounds)
+        } else {
+            let rest = num_sumcheck
+                .checked_sub(k_first)
+                .ok_or_else(|| invalid("k_first exceeds sumcheck rounds"))?;
+            if num_rounds == 1 {
+                if rest != 0 {
+                    return Err(invalid("sumcheck rounds"));
+                }
+                (k_first, 0)
+            } else {
+                if rest % (num_rounds - 1) != 0 {
+                    return Err(invalid("sumcheck rounds"));
+                }
+                (k_first, rest / (num_rounds - 1))
+            }
+        };
+        if k0 > 16 || k > 16 {
+            return Err(invalid("folding factor"));
+        }
+        let ood_values = SC::decode_extension_field_n(reader, num_rounds - 1)?;
+        let folding_pow_witnesses = SC::decode_base_field_n(reader, num_sumcheck)?;
+        let query_phase_pow_witnesses =
+            SC::decode_base_field_n(reader, num_rounds * (1 + levers.wide_query_pow as usize))?;
+        let num_commits = usize::decode(reader)?;
+        if num_commits == 0 {
+            return Err(invalid("num_commits must be nonzero"));
+        }
+        let q0 = usize::decode(reader)?;
+        let mut widths = vec_with_capped_capacity(num_commits);
+        for _ in 0..num_commits {
+            widths.push(usize::decode(reader)?);
+        }
+        let mut initial_round_opened_rows = vec_with_capped_capacity(num_commits);
+        for &width in &widths {
+            let mut per_query = vec_with_capped_capacity(q0);
+            for _ in 0..q0 {
+                let mut rows = vec_with_capped_capacity(1 << k0);
+                for _ in 0..(1usize << k0) {
+                    rows.push(SC::decode_base_field_n(reader, width)?);
+                }
+                per_query.push(rows);
+            }
+            initial_round_opened_rows.push(per_query);
+        }
+        let decode_paths = |reader: &mut R, q: usize| -> Result<Vec<Vec<SC::Digest>>> {
+            if multiproof {
+                Ok(vec![SC::decode_digest_vec(reader)?])
+            } else {
+                let depth = usize::decode(reader)?;
+                if depth > 64 {
+                    return Err(invalid("merkle depth"));
+                }
+                let mut v = vec_with_capped_capacity(q);
+                for _ in 0..q {
+                    v.push(SC::decode_digest_n(reader, depth)?);
+                }
+                Ok(v)
+            }
+        };
+        let mut initial_round_merkle_proofs = vec_with_capped_capacity(num_commits);
+        for _ in 0..num_commits {
+            initial_round_merkle_proofs.push(decode_paths(reader, q0)?);
+        }
+        let mut codeword_opened_values = vec_with_capped_capacity(num_rounds - 1);
+        for _ in 0..num_rounds - 1 {
+            let q = usize::decode(reader)?;
+            let mut vals = vec_with_capped_capacity(q);
+            for _ in 0..q {
+                vals.push(SC::decode_extension_field_n(reader, 1 << k)?);
+            }
+            codeword_opened_values.push(vals);
+        }
+        let mut codeword_merkle_proofs = vec_with_capped_capacity(num_rounds - 1);
+        for vals in &codeword_opened_values {
+            codeword_merkle_proofs.push(decode_paths(reader, vals.len())?);
+        }
+        let final_poly = SC::decode_extension_field_vec(reader)?;
+        Ok(Self {
+            mu_pow_witness,
+            whir_sumcheck_polys,
+            codeword_commits,
+            ood_values,
+            folding_pow_witnesses,
+            query_phase_pow_witnesses,
+            initial_round_opened_rows,
+            initial_round_merkle_proofs,
+            codeword_opened_values,
+            codeword_merkle_proofs,
+            final_poly,
+            levers,
         })
     }
 }
