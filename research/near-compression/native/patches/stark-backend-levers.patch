+        } = levers;
+        let mu_pow_witness = SC::decode_base_field(reader)?;
+        let num_sumcheck = usize::decode(reader)?;
+        let mut whir_sumcheck_polys = vec_with_capped_capacity(num_sumcheck);
+        for _ in 0..num_sumcheck {
+            whir_sumcheck_polys.push([
+                SC::decode_extension_field(reader)?,
+                SC::decode_extension_field(reader)?,
+            ]);
+        }
+        let codeword_commits = SC::decode_digest_vec(reader)?;
+        let num_rounds = codeword_commits.len() + 1;
+        // Per-round folding factors: round 0 folds k_first (or k), the rest fold k.
+        let (k0, k) = if k_first == 0 {
+            if num_sumcheck % num_rounds != 0 {
+                return Err(invalid("sumcheck rounds not a multiple of WHIR rounds"));
+            }
+            (num_sumcheck / num_rounds, num_sumcheck / num_rounds)
+        } else {
+            let rest = num_sumcheck
+                .checked_sub(k_first)
+                .ok_or_else(|| invalid("k_first exceeds sumcheck rounds"))?;
+            if num_rounds == 1 {
+                if rest != 0 {
+                    return Err(invalid("sumcheck rounds"));
+                }
+                (k_first, 0)
+            } else {
+                if rest % (num_rounds - 1) != 0 {
+                    return Err(invalid("sumcheck rounds"));
+                }
+                (k_first, rest / (num_rounds - 1))
+            }
+        };
+        if k0 > 16 || k > 16 {
+            return Err(invalid("folding factor"));
+        }
+        let ood_values = SC::decode_extension_field_n(reader, num_rounds - 1)?;
+        let folding_pow_witnesses = SC::decode_base_field_n(reader, num_sumcheck)?;
+        let query_phase_pow_witnesses = SC::decode_base_field_n(reader, num_rounds)?;
+        let num_commits = usize::decode(reader)?;
+        if num_commits == 0 {
+            return Err(invalid("num_commits must be nonzero"));
+        }
+        let q0 = usize::decode(reader)?;
+        let mut widths = vec_with_capped_capacity(num_commits);
+        for _ in 0..num_commits {
+            widths.push(usize::decode(reader)?);
+        }
+        let mut initial_round_opened_rows = vec_with_capped_capacity(num_commits);
+        for &width in &widths {
+            let mut per_query = vec_with_capped_capacity(q0);
+            for _ in 0..q0 {
+                let mut rows = vec_with_capped_capacity(1 << k0);
+                for _ in 0..(1usize << k0) {
+                    rows.push(SC::decode_base_field_n(reader, width)?);
+                }
+                per_query.push(rows);
+            }
+            initial_round_opened_rows.push(per_query);
+        }
+        let decode_paths = |reader: &mut R, q: usize| -> Result<Vec<Vec<SC::Digest>>> {
+            if multiproof {
+                Ok(vec![SC::decode_digest_vec(reader)?])
+            } else {
+                let depth = usize::decode(reader)?;
+                if depth > 64 {
+                    return Err(invalid("merkle depth"));
+                }
+                let mut v = vec_with_capped_capacity(q);
+                for _ in 0..q {
+                    v.push(SC::decode_digest_n(reader, depth)?);
+                }
+                Ok(v)
+            }
+        };
+        let mut initial_round_merkle_proofs = vec_with_capped_capacity(num_commits);
+        for _ in 0..num_commits {
+            initial_round_merkle_proofs.push(decode_paths(reader, q0)?);
+        }
+        let mut codeword_opened_values = vec_with_capped_capacity(num_rounds - 1);
+        for _ in 0..num_rounds - 1 {
+            let q = usize::decode(reader)?;
+            let mut vals = vec_with_capped_capacity(q);
+            for _ in 0..q {
+                vals.push(SC::decode_extension_field_n(reader, 1 << k)?);
+            }
+            codeword_opened_values.push(vals);
+        }
+        let mut codeword_merkle_proofs = vec_with_capped_capacity(num_rounds - 1);
+        for vals in &codeword_opened_values {
+            codeword_merkle_proofs.push(decode_paths(reader, vals.len())?);
+        }
+        let final_poly = SC::decode_extension_field_vec(reader)?;
+        Ok(Self {
+            mu_pow_witness,
+            whir_sumcheck_polys,
+            codeword_commits,
+            ood_values,
+            folding_pow_witnesses,
+            query_phase_pow_witnesses,
+            initial_round_opened_rows,
+            initial_round_merkle_proofs,
+            codeword_opened_values,
+            codeword_merkle_proofs,
+            final_poly,
+            levers,
         })
     }
 }
