+/// Verify a canonical batched multiproof (see `MerkleTree::query_multiproof`): `leaves` are
+/// `(leaf index, leaf digest)` pairs in any order (duplicates must agree), `proof` the flat sibling
+/// list, consumed level by level in ascending node index. Every sibling must be consumed.
+pub fn merkle_multiproof_verify<H: MerkleHasher>(
+    hasher: &H,
+    root: H::Digest,
+    depth: usize,
+    leaves: &[(usize, H::Digest)],
+    proof: &[H::Digest],
+) -> Result<(), VerifyWhirError>
+where
+    H::Digest: Eq,
+{
+    let mut level: std::collections::BTreeMap<usize, H::Digest> = Default::default();
+    for &(idx, d) in leaves {
+        ensure(depth >= 64 || idx < (1usize << depth), VerifyWhirError::MerkleVerify)?;
+        if let Some(prev) = level.insert(idx, d) {
+            ensure(prev == d, VerifyWhirError::MerkleVerify)?;
+        }
+    }
+    ensure(!level.is_empty(), VerifyWhirError::MerkleVerify)?;
+    let mut stream = proof.iter();
+    for _ in 0..depth {
+        let mut next: std::collections::BTreeMap<usize, H::Digest> = Default::default();
+        let mut it = level.iter().peekable();
+        while let Some((&idx, &d)) = it.next() {
+            let parent = if idx & 1 == 0 {
+                let right = match it.peek() {
+                    Some((&j, &dj)) if j == idx + 1 => {
+                        it.next();
+                        dj
+                    }
+                    _ => *stream.next().ok_or(VerifyWhirError::MerkleVerify)?,
+                };
+                hasher.compress(d, right)
+            } else {
+                let left = *stream.next().ok_or(VerifyWhirError::MerkleVerify)?;
+                hasher.compress(left, d)
+            };
+            next.insert(idx >> 1, parent);
+        }
+        level = next;
+    }
+    ensure(stream.next().is_none(), VerifyWhirError::MerkleVerify)?;
+    ensure(
+        level.len() == 1 && level.get(&0) == Some(&root),
+        VerifyWhirError::MerkleVerify,
+    )
+}
