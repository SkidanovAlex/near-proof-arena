+impl<SC: StarkProtocolConfig> WhirProof<SC> {
+    pub fn encode_levers<W: Write>(&self, writer: &mut W) -> Result<()>
+    where
+        SC: EncodableConfig,
+    {
+        let lv = &self.levers;
+        let k_first: u8 = lv.k_first.try_into().map_err(Error::other)?;
+        k_first.encode(writer)?;
+        (lv.multiproof as u8).encode(writer)?;
+        (lv.keep_domain as u8).encode(writer)?;
+        SC::encode_base_field(&self.mu_pow_witness, writer)?;
+        self.whir_sumcheck_polys.len().encode(writer)?;
+        for arr in &self.whir_sumcheck_polys {
+            SC::encode_extension_field_iter(arr.iter(), writer)?;
+        }
+        SC::encode_digest_slice(&self.codeword_commits, writer)?;
+        SC::encode_extension_field_iter(self.ood_values.iter(), writer)?;
+        SC::encode_base_field_iter(self.folding_pow_witnesses.iter(), writer)?;
+        SC::encode_base_field_iter(self.query_phase_pow_witnesses.iter(), writer)?;
+        let num_commits = self.initial_round_opened_rows.len();
+        num_commits.encode(writer)?;
+        let q0 = self.initial_round_opened_rows[0].len();
+        q0.encode(writer)?;
+        let widths: Vec<usize> = self
+            .initial_round_opened_rows
+            .iter()
+            .map(|c| c.first().and_then(|q| q.first()).map(|r| r.len()).unwrap_or(0))
+            .collect();
+        for w in &widths {
+            w.encode(writer)?;
+        }
+        for (commit_rows, &width) in self.initial_round_opened_rows.iter().zip(&widths) {
+            for query_rows in commit_rows {
+                for row in query_rows {
+                    if row.len() != width {
+                        return Err(invalid("ragged opened rows"));
+                    }
+                    SC::encode_base_field_iter(row.iter(), writer)?;
+                }
+            }
+        }
+        let encode_paths = |groups: &[Vec<Vec<SC::Digest>>], writer: &mut W| -> Result<()> {
+            for proofs in groups {
+                if lv.multiproof {
+                    if proofs.len() != 1 {
+                        return Err(invalid("multiproof must be a single entry"));
+                    }
+                    SC::encode_digest_slice(&proofs[0], writer)?;
+                } else {
+                    let depth = proofs.first().map(|p| p.len()).unwrap_or(0);
+                    depth.encode(writer)?;
+                    for p in proofs {
+                        if p.len() != depth {
+                            return Err(invalid("ragged merkle paths"));
+                        }
