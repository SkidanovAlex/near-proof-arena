/-- The spec result of CMP flag index `idx` (0 = eqz, 1.. = relop `idx - 1`). -/
def cmpSpec (idx w a b : Nat) : Bool := if idx = 0 then decide (a = 0) else Num.relop w (idx - 1) a b

theorem eqf_val {z inv : Nat} (hz : z < P)
    (h : (z : F) * (((1 : Nat) : F) - (z : F) * (inv : F)) = 0) :
    ((1 : Nat) : F) - (z : F) * (inv : F) = ((if z = 0 then 1 else 0 : Nat) : F) := by
  split
  · rename_i h0; subst h0; rw [show ((0 : Nat) : F) = 0 from rfl]; grind
  · rename_i h0
    rcases mul_eq_zero' h with h1 | h1
    · exact absurd (natEq (h1.trans rfl) hz (by decide)) h0
    · rw [h1]; rfl

/-- `omega` after turning `decide p = true` / `¬ decide p = true` hypotheses into `p` / `¬ p`. -/
macro "dec_omega" : tactic => `(tactic| (
  repeat (first
    | (rename_i hc; replace hc := of_decide_eq_true hc)
    | (rename_i hc; replace hc := fun h => hc (decide_eq_true h)))
  omega))

theorem one_sub_cast {x : Nat} (hx : x ≤ 1) : ((1 : Nat) : F) - (x : F) = ((1 - x : Nat) : F) := by
  rcases (show x = 0 ∨ x = 1 by omega) with rfl | rfl <;> rfl


/-- The CMP result expression as a natural number (flags, borrows and the zero test are bits). -/
theorem cmp_res_nat (c : Nat → Nat) (rw : Row) (hz : c 33 + c 34 + c 35 + c 36 < P)
    (heq : ((c 33 + c 34 + c 35 + c 36 : Nat) : F) *
      (((1 : Nat) : F) - ((c 33 + c 34 + c 35 + c 36 : Nat) : F) * (c 41 : F)) = 0)
    (h16 : c 16 ≤ 1) (h38 : c 38 ≤ 1) (h40 : c 40 ≤ 1) :
    Cmp.res.eval (natRow c rw) = (((c 5 + c 6) * (if c 33 + c 34 + c 35 + c 36 = 0 then 1 else 0) + c 7 * (1 - (if c 33 + c 34 + c 35 + c 36 = 0 then 1 else 0)) + (c 8 + c 9 + c 10 + c 11) * ((1 - c 16) * c 38 + c 16 * c 40) + (c 12 + c 13 + c 14 + c 15) * (1 - ((1 - c 16) * c 38 + c 16 * c 40)) : Nat) : F) := by
  have hzv := eqf_val hz heq
  have hlt : (1 - c 16) * c 38 + c 16 * c 40 ≤ 1 := by
    rcases (show c 16 = 0 ∨ c 16 = 1 by omega) with h | h <;> simp [h] <;> omega
  have e1 := one_sub_cast hlt
  have e2 := one_sub_cast (x := if c 33 + c 34 + c 35 + c 36 = 0 then 1 else 0) (by split <;> omega)
  have e3 := one_sub_cast h16
  simp only [Cmp.res, Cmp.eqf, Cmp.zsum, Cmp.lt, Cmp.fEqz, Cmp.fEq, Cmp.fNe, Cmp.fLtS, Cmp.fLtU, Cmp.fGtS,
    Cmp.fGtU, Cmp.fLeS, Cmp.fLeU, Cmp.fGeS, Cmp.fGeU, Cmp.is64, Cmp.d, Cmp.br, Cmp.inv, v,
    Expr.eval_add', Expr.eval_sub', Expr.eval_mul', Expr.eval_ofNat', Expr.eval_col, natRow, Nat.reduceAdd]
  simp only [Lean.Grind.Semiring.natCast_add, Lean.Grind.Semiring.natCast_mul] at hzv e1 e2 e3 ⊢
  rw [hzv, e3, ← e1, ← e2]

