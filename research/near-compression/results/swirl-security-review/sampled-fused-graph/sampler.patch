+#[cfg(test)]
+mod sampler_tests {
+    use super::*;
+    #[test]
+    fn boundaries_rejection_positions_and_wrong_output() {
+        let b=CircuitBuilder::new();let input:Vec<_>=(0..12).map(|_|b.add_inout()).collect();
+        let output=sample_words(&b,&input);let expected:[Wire;4]=std::array::from_fn(|_|b.add_inout());
+        for j in 0..4 {b.assert_eq("sample",output[j],expected[j]);}
+        let circuit=b.build();
+        let check=|values:[u32;12], corrupt:bool| {
+            let answer=values.into_iter().filter(|&x|x<4026531842).take(4).map(|x|x%2013265921).collect::<Vec<_>>();
+            let mut witness=circuit.new_witness_filler();
+            for (wire,value) in input.iter().zip(values) {witness[*wire]=Word(value as u64);}
+            for j in 0..4 {witness[expected[j]]=Word(answer.get(j).copied().unwrap_or(0) as u64 ^ u64::from(corrupt && j==0));}
+            let valid=circuit.populate_wire_witness(&mut witness).is_ok();
+            assert_eq!(valid,answer.len()==4 && !corrupt);
+        };
+        check([0,2013265920,2013265921,4026531841,4026531842,u32::MAX,0,0,0,0,0,0],false);
+        check([u32::MAX;12],false);
+        check([0;12],true);
+        for offset in 0..9 {
+            let mut v=[u32::MAX;12];for j in 0..4 {v[offset+j]=2013265921+j as u32;}
+            check(v,false);
+        }
+        let mut state=782436u64;
+        for _ in 0..128 {
+            let v=std::array::from_fn(|_| {state=state.wrapping_mul(6364136223846793005).wrapping_add(1);(state>>32) as u32});
+            check(v,false);
+        }
+    }
