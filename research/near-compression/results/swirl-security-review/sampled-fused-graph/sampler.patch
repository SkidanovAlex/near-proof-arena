+// Input words are zero-extended u32 values in production. Comparisons return
+// MSB booleans; select consumes only that bit. Never add an unnormalized flag.
+fn sample_words(b: &CircuitBuilder, input: &[Wire]) -> [Wire;4] {
+    let zero=b.add_constant_64(0); let one=b.add_constant_64(1);
+    let prime=b.add_constant_64(2013265921);let limit=b.add_constant_64(4026531842);
+    let four=b.add_constant_64(4);let mut count=zero;let mut out=[zero;4];
+    for &word in input {
+        let accept=b.icmp_ult(word,limit);
+        let (diff,_)=b.isub_bin_bout(word,prime,zero);
+        let value=b.select(b.icmp_ult(word,prime),word,diff);
+        for (j,slot) in out.iter_mut().enumerate() {
+            let index=b.add_constant_64(j as u64);
+            let take=b.band(accept,b.icmp_eq(count,index));
+            *slot=b.select(take,value,*slot);
+        }
+        let active=b.band(accept,b.icmp_ult(count,four));
+        count=b.iadd(count,b.select(active,one,zero)).0;
+    }
+    b.assert_eq("four accepted words",count,four);
+    out
+}
