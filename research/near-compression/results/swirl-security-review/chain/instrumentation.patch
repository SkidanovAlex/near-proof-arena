+#[test]
+fn nearproof_recursive_chain() {
+    use openvm_stark_backend::{codec::Encode, prover::MatrixDimensions};
+    use openvm_stark_sdk::config::{
+        app_params_with_100_bits_security, internal_params_with_100_bits_security,
+        leaf_params_with_100_bits_security, root_params_with_100_bits_security,
+    };
+    let child_engine =
+        BabyBearPoseidon2CpuEngine::<DuplexSponge>::new(app_params_with_100_bits_security(12));
+    let fib = FibFixture::new_with_num_airs(0, 1, 1 << 8, 9);
+    let (mut child_vk, mut child_proof) = fib.keygen_and_prove(&child_engine);
+    for (name, params) in [
+        ("leaf", leaf_params_with_100_bits_security()),
+        ("internal", internal_params_with_100_bits_security()),
+        (
+            "root_geometry_babybear_hash",
+            root_params_with_100_bits_security(),
+        ),
+    ] {
+        let engine = BabyBearPoseidon2CpuEngine::<DuplexSponge>::new(params);
+        let (circuit, pk) = verifier_circuit_keygen::<2>(&engine, &child_vk);
+        let ctxs = circuit.generate_proving_ctxs_base(
+            &child_vk,
+            CachedTraceCtx::PcsData(circuit.commit_child_vk(&engine, &child_vk)),
+            &[child_proof],
+            &(),
+            default_duplex_sponge_recorder(),
+        );
+        let mut common_cells = 0;
+        let mut cached_cells = 0;
+        for (air, ctx) in circuit.airs::<BabyBearPoseidon2Config>().iter().zip(&ctxs) {
+            let height = ctx.common_main.height();
+            let width = ctx.common_main.width();
+            common_cells += height * width;
+            for cached in &ctx.cached_mains {
+                cached_cells += cached.trace.height() * cached.trace.width();
+            }
+            println!(
+                "NEARPROOF_TRACE stage={name} air={} height={height} width={width}",
+                air.name()
+            );
+        }
+        println!("NEARPROOF_CELLS stage={name} common={common_cells} cached={cached_cells}");
+        let ctx = ProvingContext::new(ctxs.into_iter().enumerate().collect());
+        engine.debug(&circuit.airs(), &ctx);
+        let d_pk = engine.device().transport_pk_to_device(&pk);
+        let proof = engine.prove(&d_pk, ctx).unwrap();
+        let vk = pk.get_vk();
+        engine.verify(&vk, &proof).unwrap();
+        let mut bytes = Vec::new();
+        proof.encode(&mut bytes).unwrap();
+        println!("NEARPROOF_CHAIN stage={name} bytes={}", bytes.len());
+        for (label, count) in [
+            ("gkr", {
+                let mut b = Vec::new();
+                proof.gkr_proof.encode(&mut b).unwrap();
+                b.len()
+            }),
+            ("constraints", {
+                let mut b = Vec::new();
+                proof.batch_constraint_proof.encode(&mut b).unwrap();
+                b.len()
+            }),
+            ("stacking", {
+                let mut b = Vec::new();
+                proof.stacking_proof.encode(&mut b).unwrap();
+                b.len()
+            }),
+            ("whir", {
+                let mut b = Vec::new();
+                proof.whir_proof.encode(&mut b).unwrap();
+                b.len()
+            }),
+        ] {
+            println!("NEARPROOF_PART stage={name} part={label} bytes={count}");
+        }
+        std::fs::write(format!("/tmp/nearproof-chain-{name}.proof"), bytes).unwrap();
+        child_vk = vk;
+        child_proof = proof;
+    }
+}
