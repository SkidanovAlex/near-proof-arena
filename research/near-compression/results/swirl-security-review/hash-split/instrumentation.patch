+#[test]
+fn nearproof_wire_census() {
+    use openvm_stark_backend::{
+        codec::{Decode, Encode},
+        proof::Proof,
+    };
+    for stage in ["leaf", "internal", "root_geometry_babybear_hash"] {
+        let bytes = std::fs::read(format!("/tmp/nearproof-chain-{stage}.proof")).unwrap();
+        let mut reader = &bytes[..];
+        let p = Proof::<BabyBearPoseidon2Config>::decode(&mut reader).unwrap();
+        assert!(reader.is_empty());
+        let mut encoded = Vec::new();
+        p.encode(&mut encoded).unwrap();
+        assert_eq!(bytes, encoded);
+        let opening = &p.whir_proof;
+        let first_q = opening.initial_round_opened_rows[0].len();
+        let first_base_per_query: usize = opening
+            .initial_round_opened_rows
+            .iter()
+            .map(|c| c[0].iter().map(Vec::len).sum::<usize>())
+            .sum();
+        let later_q: Vec<_> = opening
+            .codeword_opened_values
+            .iter()
+            .map(Vec::len)
+            .collect();
+        let later_values: Vec<_> = opening
+            .codeword_opened_values
+            .iter()
+            .map(|r| r[0].len())
+            .collect();
+        println!("NEARPROOF_QUERY_SHAPE stage={stage} first_q={first_q} first_base_per_query={first_base_per_query} later_q={later_q:?} later_values={later_values:?}");
+        let g = &p.gkr_proof;
+        let b = &p.batch_constraint_proof;
+        let s = &p.stacking_proof;
+        let w = &p.whir_proof;
+        let g_ef = 1
+            + 4 * g.claims_per_layer.len()
+            + g.sumcheck_polys.iter().map(|r| 3 * r.len()).sum::<usize>();
+        let column_ef = b
+            .column_openings
+            .iter()
+            .flatten()
+            .map(Vec::len)
+            .sum::<usize>();
+        println!("NEARPROOF_COLUMNS stage={stage} column_ef={column_ef}");
+        let b_ef = b.numerator_term_per_air.len()
+            + b.denominator_term_per_air.len()
+            + b.univariate_round_coeffs.len()
+            + b.sumcheck_round_polys.iter().map(Vec::len).sum::<usize>()
+            + b.column_openings
+                .iter()
+                .flatten()
+                .map(Vec::len)
+                .sum::<usize>();
+        let s_ef = s.univariate_round_coeffs.len()
+            + 2 * s.sumcheck_round_polys.len()
+            + s.stacking_openings.iter().map(Vec::len).sum::<usize>();
+        let w_ef = 2 * w.whir_sumcheck_polys.len()
+            + w.ood_values.len()
+            + w.codeword_opened_values
+                .iter()
+                .flatten()
+                .map(Vec::len)
+                .sum::<usize>()
+            + w.final_poly.len();
+        let ef = g_ef + b_ef + s_ef + w_ef;
+        let bf = p.public_values.iter().map(Vec::len).sum::<usize>()
+            + 2
+            + w.folding_pow_witnesses.len()
+            + w.query_phase_pow_witnesses.len()
+            + w.initial_round_opened_rows
+                .iter()
+                .flatten()
+                .flatten()
+                .map(Vec::len)
+                .sum::<usize>();
+        let digests = 1
+            + p.trace_vdata
+                .iter()
+                .flatten()
+                .map(|t| t.cached_commitments.len())
+                .sum::<usize>()
+            + w.codeword_commits.len()
+            + w.initial_round_merkle_proofs
+                .iter()
+                .flatten()
+                .map(Vec::len)
+                .sum::<usize>()
+            + w.codeword_merkle_proofs
+                .iter()
+                .flatten()
+                .map(Vec::len)
+                .sum::<usize>();
+        use openvm_stark_backend::codec::EncodableConfig;
+        let digest_refs = std::iter::once(&p.common_main_commit)
+            .chain(
+                p.trace_vdata
+                    .iter()
+                    .flatten()
+                    .flat_map(|t| t.cached_commitments.iter()),
+            )
+            .chain(w.codeword_commits.iter())
+            .chain(w.initial_round_merkle_proofs.iter().flatten().flatten())
+            .chain(w.codeword_merkle_proofs.iter().flatten().flatten());
+        let mut unique = std::collections::HashSet::new();
+        let mut seen = 0;
+        for d in digest_refs {
+            let mut b = Vec::new();
+            BabyBearPoseidon2Config::encode_digest(d, &mut b).unwrap();
+            unique.insert(b);
+            seen += 1;
+        }
+        assert_eq!(seen, digests);
+        println!(
+            "NEARPROOF_DIGESTS stage={stage} unique={} occurrences={digests}",
+            unique.len()
+        );
+        let framing = bytes
+            .len()
+            .checked_sub(16 * ef + 4 * bf + 32 * digests)
+            .unwrap();
+        assert!(framing < 4096);
+        println!("NEARPROOF_CENSUS stage={stage} bytes={} ef={ef} bf={bf} digests={digests} framing={framing} gkr_ef={g_ef} constraints_ef={b_ef} stacking_ef={s_ef} whir_ef={w_ef}",bytes.len());
+    }
+}
