+        BabyBearPoseidon2CpuEngine::<DuplexSponge>::new(app_params_with_100_bits_security(12));
+    let parent_engine =
+        BabyBearPoseidon2CpuEngine::<DuplexSponge>::new(leaf_params_with_100_bits_security());
+    let fib = FibFixture::new_with_num_airs(0, 1, 1 << 8, 9);
+    run_test::<2, _>(fib, &child_engine, &parent_engine, 1);
