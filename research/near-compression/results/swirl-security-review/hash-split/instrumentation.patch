+#[test]
+fn nearproof_recursive_chain() {
+    use openvm_stark_backend::{codec::Encode, prover::MatrixDimensions};
+    use openvm_stark_sdk::config::{
+        app_params_with_100_bits_security, baby_bear_poseidon2::F,
+        internal_params_with_100_bits_security, leaf_params_with_100_bits_security,
+        root_params_with_100_bits_security,
+    };
+    use p3_field::PrimeCharacteristicRing;
+    use p3_matrix::dense::RowMajorMatrix;
+    let child_engine =
+        BabyBearPoseidon2CpuEngine::<DuplexSponge>::new(app_params_with_100_bits_security(12));
+    let fib = FibFixture::new_with_num_airs(0, 1, 1 << 8, 9);
+    let (mut child_vk, mut child_proof) = fib.keygen_and_prove(&child_engine);
+    for (name, params) in [
+        ("leaf", leaf_params_with_100_bits_security()),
+        ("internal", internal_params_with_100_bits_security()),
+        (
+            "root_geometry_babybear_hash",
+            root_params_with_100_bits_security(),
+        ),
+    ] {
+        let engine = BabyBearPoseidon2CpuEngine::<DuplexSponge>::new(params);
+        let (circuit, mut pk) = verifier_circuit_keygen::<2>(&engine, &child_vk);
+        let mut ctxs = circuit.generate_proving_ctxs_base(
+            &child_vk,
+            CachedTraceCtx::PcsData(circuit.commit_child_vk(&engine, &child_vk)),
+            &[child_proof],
+            &(),
+            default_duplex_sponge_recorder(),
+        );
+        let mut airs = circuit.airs::<BabyBearPoseidon2Config>();
+        let split = name == "root_geometry_babybear_hash"
+            && std::env::var_os("NEARPROOF_SPLIT_HASH").is_some();
+        let name = if split { "root_split_hash" } else { name };
+        if split {
+            let idx = airs
+                .iter()
+                .position(|air| air.name().starts_with("Poseidon2Air<"))
+                .unwrap();
+            let original = &ctxs[idx];
+            assert!(original.cached_mains.is_empty() && original.public_values.is_empty());
+            let matrix = &original.common_main;
+            let width = matrix.width();
+            let live = matrix
+                .values
+                .chunks_exact(width)
+                .rposition(|row| row[width - 2] != F::ZERO || row[width - 1] != F::ZERO)
+                .unwrap()
+                + 1;
+            let first_height = 1usize << live.ilog2();
+            assert!(live > first_height);
+            let second_height = (live - first_height).next_power_of_two();
+            assert!(first_height + second_height <= matrix.height());
+            // Reuse valid zero-multiplicity padding rows; do not fabricate all-zero permutations.
+            for row in matrix.values[(first_height + second_height) * width..].chunks_exact(width) {
+                assert_eq!(row[width - 2], F::ZERO);
+                assert_eq!(row[width - 1], F::ZERO);
+            }
+            let first = RowMajorMatrix::new(matrix.values[..first_height * width].to_vec(), width);
+            let second = RowMajorMatrix::new(
+                matrix.values[first_height * width..(first_height + second_height) * width]
+                    .to_vec(),
+                width,
+            );
+            println!("NEARPROOF_SPLIT live={live} original={} first={first_height} second={second_height}", matrix.height());
+            ctxs[idx].common_main = first;
+            ctxs.push(AirProvingContext {
+                cached_mains: vec![],
+                common_main: second,
+                public_values: vec![],
+            });
+            airs.push(airs[idx].clone());
+            (pk, _) = engine.keygen(&airs);
+        }
+        let mut common_cells = 0;
+        let mut cached_cells = 0;
+        for (air, ctx) in airs.iter().zip(&ctxs) {
+            let height = ctx.common_main.height();
+            let width = ctx.common_main.width();
+            common_cells += height * width;
+            for cached in &ctx.cached_mains {
+                cached_cells += cached.trace.height() * cached.trace.width();
+            }
+            println!(
+                "NEARPROOF_TRACE stage={name} air={} height={height} width={width}",
+                air.name()
+            );
+        }
+        println!("NEARPROOF_CELLS stage={name} common={common_cells} cached={cached_cells}");
+        let ctx = ProvingContext::new(ctxs.into_iter().enumerate().collect());
+        engine.debug(&airs, &ctx);
+        let d_pk = engine.device().transport_pk_to_device(&pk);
+        let proof = engine.prove(&d_pk, ctx).unwrap();
+        let vk = pk.get_vk();
+        engine.verify(&vk, &proof).unwrap();
+        let mut bytes = Vec::new();
+        proof.encode(&mut bytes).unwrap();
+        println!("NEARPROOF_CHAIN stage={name} bytes={}", bytes.len());
+        for (label, count) in [
+            ("gkr", {
+                let mut b = Vec::new();
+                proof.gkr_proof.encode(&mut b).unwrap();
+                b.len()
+            }),
+            ("constraints", {
+                let mut b = Vec::new();
+                proof.batch_constraint_proof.encode(&mut b).unwrap();
+                b.len()
+            }),
+            ("stacking", {
+                let mut b = Vec::new();
+                proof.stacking_proof.encode(&mut b).unwrap();
+                b.len()
+            }),
+            ("whir", {
+                let mut b = Vec::new();
+                proof.whir_proof.encode(&mut b).unwrap();
+                b.len()
+            }),
+        ] {
+            println!("NEARPROOF_PART stage={name} part={label} bytes={count}");
+        }
+        std::fs::write(format!("/tmp/nearproof-chain-{name}.proof"), bytes).unwrap();
+        child_vk = vk;
+        child_proof = proof;
+    }
+}
