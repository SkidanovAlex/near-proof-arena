 "design": {
  "rounds_per_row": 2,
  "rows_per_compression": 44,
  "rows_layout": "0-1 input state (a/e slots), 2-41 rounds 0..79 (two per row), 42-43 output state (feed-forward)",
  "word_representation": "bits for a, e, W (needed by Sigma/sigma/Ch/Maj); 64-bit adds in 3 limbs 22/21/21 with carries range-checked by lookup into [0,64)",
  "history": "one-row-back via the 2-row window; slot-1 partial (d,h) via a packed copy D; slot-0 partial sums S; W[t-7], W[t-16]+sigma0(W[t-15]) and feed-forward words via a permutation bus keyed by the global row counter",
  "tables": "64-row control/range table AIR: one-hot u,v rotated by transition constraints (no preprocessed commitment); provides row flags and K limbs per row index",
  "interface": "bus 3 messages (cid=g-r, idx 0..31, four 16-bit limbs): 0..7 input state, 8..23 block, 24..31 output state; SHA-384 = SHA-384 IV + read words 24..29",
  "max_constraint_degree": 4,
  "main_columns": {
   "total": 442,
   "a_bits": 128,
   "e_bits": 128,
   "w_bits": 128,
   "partial_sums_S": 6,
   "copies_D": 6,
   "carries": 18,
   "received_limbs": 12,
   "K_limbs": 6,
   "row_index": 1,
   "global_row": 1,
   "flags": 8
  },
  "constraints": 848,
  "interactions_per_row": 43,
  "other_airs": {
   "table": "64 x 18 (1,152 cells, constant)",
   "harness": "32 rows x 7 per compression (test consumer of the interface; 224 cells/compression, not SHA cost)"
  }
 },
