/-!
# ZkFormal.NearV3.Assembly.LinkBus — per-bus balances of `nearAirV3` from `HoldsP`

`HoldsP.balance` is one equation per bus over all 25 tables and the public segments.  For the
link only the tables that actually touch a bus matter:

* `busCount_users` — `busCount nearAirV3` on bus `b` is the sum over an explicit list `U` of
  table indices, given the kernel-checked fact `UsersOk b U` (every other table has no
  interaction on `b`);
* `pubCount_nobus` — no prepared public segment on `b` ⇒ public count `0`;
* `bal_users` — so on a private bus the sends of the users equal their receives.

Instantiated with the exact traffic of the viewed tables (`V3RecordsTraffic`), this gives the
record-level balances the `Link/` layer is stated against:

* `parentBal_of` (`ParentBal`, bus `PARENT`: node, head),
* `vparentBal_of` (`VParentBal`, `VPARENT`: node, val),
* `entBal_of` (`EntBal`, `ENT`: node, val),
* `dupBal_of` (`DupBal`, `DUP`: node, val, uniq),
* `digsBal_of` (`DigsBal`, `DIGS`: node, head, uniq),
* `walkBal_of` (`WalkBal … B_EDGE` / `B_BMAP`: node, head, walk, ups),
* `upbBal_of` (`UpbBal`, `UPB`: node, ups).

The A7 extension interactions of `nodeA7`/`valA7`/`upsA7`/`sizeA7` use only `RPL`, `RPLV` and
`SIZE`, so they drop out of every bus above (`a7_nobus`).
-/

namespace ZkFormal.NearV3.Assembly

open ZkFormal.Air ZkFormal.Algebra ZkFormal.V2 ZkFormal.Near

/-! ## Generic: the users of a bus -/

/-- **`busCount` on bus `b` is the sum over its users.** -/
theorem busCount_users_d1 {b : Nat} {U : List Nat} (hU : U.Nodup) (hUn : ∀ t ∈ U, t < 30)
    (hok : ZkFormal.NearV3.D1.Link.UsersOkD1 b U = true) (tr : Trace Fp) (pub : List Fp) (s : Bool) (m : List Fp) :
    busCount ZkFormal.NearV3.D1.nearAirV3D1.toAir tr pub b s m =
      (U.map fun t => tableBusCount (ZkFormal.NearV3.D1.Link.isAtD1 t) tr t pub b s m).sum := by
  rw [ZkFormal.NearV3.D1.Link.busCount_nearAirV3D1, mapIdx_eq_range _ _ default]
  apply sum_map_range_users _ _ _ hU (fun t ht => hUn t ht)
  intro t ht htU
  apply tableBusCount_nobus
  intro i hi
  have h := List.all_eq_true.mp hok t (List.mem_range.mpr ht)
  have hc : U.contains t = false := by
    cases hct : U.contains t
    · rfl
    · exact absurd (List.contains_iff_mem.mp hct) htU
  rw [hc, Bool.false_or] at h
  have := List.all_eq_true.mp h i hi
  simpa using this

/-- No prepared public segment on bus `b`: public count `0`. -/
theorem pubCount_nobus_d1 {b : Nat}
    (hb : ZkFormal.NearV3.D1.Public.preparedSegmentsD1.all (fun s => s.bus != b) = true)
    (pub : List Fp) (sd : Bool) (msg : List Fp) : pubCount ZkFormal.NearV3.D1.nearAirV3D1 pub b sd msg = 0 := by
  unfold pubCount
  suffices ((pubMsgs ZkFormal.NearV3.D1.nearAirV3D1 pub).filter (fun x => decide (x = (b, sd, msg)))) = [] by
    rw [this]; rfl
  apply List.filter_eq_nil_iff.mpr
  intro x hx
  have hn : x ≠ (b, sd, msg) := by
    intro he
    subst x
    simp only [pubMsgs, List.mem_flatMap, List.mem_map] at hx
    obtain ⟨s, hseg, m, -, he⟩ := hx
    have hsb := congrArg (fun x : Nat × Bool × List Fp => x.1) he
    have := List.all_eq_true.mp hb s hseg
    simp only at hsb
    simp [hsb] at this
  simpa using hn

/-- **Balance on a private bus** (no public segment): the users' sends equal their receives. -/
theorem bal_users_d1 {pub : List Fp} {tr : Trace Fp} (hH : HoldsP ZkFormal.NearV3.D1.nearAirV3D1 pub tr) {b : Nat}
    {U : List Nat} (hU : U.Nodup) (hUn : ∀ t ∈ U, t < 30) (hok : ZkFormal.NearV3.D1.Link.UsersOkD1 b U = true)
    (hpb : ZkFormal.NearV3.D1.Public.preparedSegmentsD1.all (fun s => s.bus != b) = true)
    (m : List Fp) :
    (U.map fun t => tableBusCount (ZkFormal.NearV3.D1.Link.isAtD1 t) tr t pub b true m).sum =
      (U.map fun t => tableBusCount (ZkFormal.NearV3.D1.Link.isAtD1 t) tr t pub b false m).sum := by
  have h := hH.balance b m
  rw [pubCount_nobus_d1 hpb, pubCount_nobus_d1 hpb, busCount_users_d1 hU hUn hok,
    busCount_users_d1 hU hUn hok] at h
  simpa using h

/-! ## The viewed tables' counts at their indices -/

section Counts
variable {pub : List Fp} {tr : Trace Fp} {r : ZkFormal.NearV3.Assembly.V3Records} (T : ZkFormal.NearV3.D1.Link.BaseTrafficD1 pub tr r)
  (s : Bool) (b : Nat) (m : List Fp)
include T

theorem node_count_d1 (hb : ZkFormal.NearV3.UnfoldA7.Node.interactions.all (fun i => i.bus != b) = true) :
    tableBusCount (ZkFormal.NearV3.D1.Link.isAtD1 T_NODE) tr T_NODE pub b s m = tcnt (ZkFormal.NearV3.nodeTraffic3 r.nodes) s b m := by
  rw [show ZkFormal.NearV3.D1.Link.isAtD1 T_NODE = ZkFormal.NearV3.NodeV3.interactions ++ ZkFormal.NearV3.UnfoldA7.Node.interactions
    from rfl, tableBusCount_append, tableBusCount_nobus (nobus_of_all hb), tcnt_of_traffic T.nodes, Nat.add_zero]

theorem val_count_d1 (hb : ZkFormal.NearV3.UnfoldA7.Val.interactions.all (fun i => i.bus != b) = true) :
    tableBusCount (ZkFormal.NearV3.D1.Link.isAtD1 T_VAL) tr T_VAL pub b s m = tcnt (ZkFormal.NearV3.valTraffic r.values) s b m := by
  rw [show ZkFormal.NearV3.D1.Link.isAtD1 T_VAL = ZkFormal.NearV3.ValV3.interactions ++ ZkFormal.NearV3.UnfoldA7.Val.interactions
    from rfl, tableBusCount_append, tableBusCount_nobus (nobus_of_all hb), tcnt_of_traffic T.values, Nat.add_zero]

theorem ups_count_d1 (hb : ZkFormal.NearV3.UnfoldA7.Ups.interactions.all (fun i => i.bus != b) = true) :
    tableBusCount (ZkFormal.NearV3.D1.Link.isAtD1 T_UPS) tr T_UPS pub b s m = tcnt (ZkFormal.NearV3.upsTraffic r.ups) s b m := by
  rw [show ZkFormal.NearV3.D1.Link.isAtD1 T_UPS = ZkFormal.NearV3.UpsV3.interactions ++ ZkFormal.NearV3.UnfoldA7.Ups.interactions
    from rfl, tableBusCount_append, tableBusCount_nobus (nobus_of_all hb), tcnt_of_traffic T.ups, Nat.add_zero]

theorem head_count_d1 : tableBusCount (ZkFormal.NearV3.D1.Link.isAtD1 T_HEAD) tr T_HEAD pub b s m = tcnt (ZkFormal.NearV3.headTraffic r.heads) s b m :=
  tcnt_of_traffic T.heads s b m

theorem walk_count_d1 : tableBusCount (ZkFormal.NearV3.D1.Link.isAtD1 T_WALK) tr T_WALK pub b s m = tcnt (ZkFormal.NearV3.walkTraffic3 r.walks) s b m :=
  tcnt_of_traffic T.walks s b m

theorem uniq_count_d1 : tableBusCount (ZkFormal.NearV3.D1.Link.isAtD1 T_UNIQ) tr T_UNIQ pub b s m = tcnt (ZkFormal.NearV3.uniqTraffic r.uniq) s b m :=
  tcnt_of_traffic T.uniq s b m

end Counts

