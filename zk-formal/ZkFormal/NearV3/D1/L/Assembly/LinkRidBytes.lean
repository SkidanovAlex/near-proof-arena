  have s0 : (ddTraffic r.srcp r.srcpRep).sends B_RCL = [] := DDView.rcl_sends _ _
  have hs : [j, lOffs r.lists[j].rs r.lists[j].rs.length] ∈ rcptSends3 pub r.lists B_RCL := by
    simp only [rcptSends3, List.mem_flatMap, List.mem_range]
