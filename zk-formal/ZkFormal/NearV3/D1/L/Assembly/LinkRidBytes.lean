/-! ## Receipt encodings (hence ids) are bytes -/

theorem encBytes_d1 {cb : NearSpec.Bytes} {h : ZkFormal.NearV3.D1.HintD1} {p : NearSpecV3.Prep} {q : ZkFormal.NearV3.D1.Public.PrepD1} {oh : Nat}
    {tr : Trace Fp} {r : ZkFormal.NearV3.Assembly.V3Records} (hp : (ZkFormal.NearV3.D1.prepD1 cb h = .ok q ∧ q.base = p))
    (hsz : (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh).length < P)
    (hH : HoldsP ZkFormal.NearV3.D1.nearAirV3D1 (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)) tr)
    (T : ZkFormal.NearV3.D1.Link.BaseTrafficD1 (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)) tr r)
    (W : ZkFormal.NearV3.D1.Link.BaseWfD1 (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)) r) :
    ∀ x ∈ flatR r.lists, Bytes8 x.enc := by
  intro x hx
  obtain ⟨L, hL, hxL⟩ := List.mem_flatMap.mp hx
  obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hL
  obtain ⟨B, hB, hBj, hBL⟩ := rcl_block_d1 hH T W hj
  cases hBd : B.dup
  case true =>
    -- a `dup` reference has the empty list (`L = 12`), so the list has no receipt bytes
    have hb := W.srcp.block B hB
    simp only [hBd, ite_true] at hb
    have h12 := hBL.symm.trans hb.1
    have hxe : x.enc = [] := by
      have hl : (RcptLink.listEncoding (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh))
          r.lists[j]).length = 12 + (r.lists[j].rs.flatMap fun x => x.enc).length := by
        simp [RcptLink.listEncoding, RcptLink.list_header_length]
      have hsub : x.enc.length ≤ (r.lists[j].rs.flatMap fun x => x.enc).length := by
        obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hxL
        rw [List.length_flatMap]
        exact le_sum_of_mem' (List.mem_map_of_mem (f := fun x : RcptE => x.enc.length) (List.getElem_mem hi))
      exact List.eq_nil_of_length_eq_zero (by omega)
    intro y hy; rw [hxe] at hy; simp at hy
  have hdig : 0 < shaU tr (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)) true B_DIGEST (digMsg (msgId K_RC j)
      (RcptLink.listEncoding (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)) r.lists[j]).length B.leaf).toFp := by
    have hj22 : j < 2 ^ 22 := by have := W.listsCount.1; omega
    apply digest_provided_d1 hH (ZkFormal.NearV3.D1.Link.plfSmall_of hp.1 hsz hH) (t := T_SRCP) (by decide)
      (ZkFormal.NearV3.D1.Link.digMsg_ne_plf (by decide) (by decide) hj22)
    rw [show ZkFormal.NearV3.D1.Link.isAtD1 T_SRCP = ZkFormal.NearV3.Rcpt.Candidates.DedupTable.interactions from rfl,
      tcnt_of_traffic T.srcp]
    simp only [tcnt, Bool.false_eq_true, ite_false]
    apply List.count_pos_iff.mpr
    apply List.mem_map_of_mem
    have := DDView.leaf_recv W.srcp.len hB hBd
    rw [hBj, hBL] at this
    exact this
  have hsha := shaFacts_cover (shaU_facts_d1 hH) _ (sha_le_rc_d1 hH T)
  have hcB : (∀ v ∈ B.leaf, v < P) := by
    have hb := W.srcp.block B hB
    simp only [hBd, Bool.false_eq_true, ite_false] at hb
    exact fun v hv => hb.canon.2.2.1 v (List.mem_append_right _ hv)
  obtain ⟨hb8, -⟩ := ZkFormal.NearV3.D1.Link.list_sha_digest_G W.lists W.listsCount.1 W.listsCount.2 hsha
    (othersRC_d1 tr (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)) r) (fun m => if_pos rfl) (othersRC_kinds_d1 hp hsz hH T W) hj
    (listEncoding_lt_d1 W.lists W.listsCount.2 hj)
    hcB hdig
  intro y hy
  apply hb8
  simp only [RcptLink.listEncoding, List.mem_append, List.mem_flatMap]
  right
  exact ⟨x, hxL, hy⟩

theorem ridBytes_d1 {cb : NearSpec.Bytes} {h : ZkFormal.NearV3.D1.HintD1} {p : NearSpecV3.Prep} {q : ZkFormal.NearV3.D1.Public.PrepD1} {oh : Nat}
    {tr : Trace Fp} {r : ZkFormal.NearV3.Assembly.V3Records} (hp : (ZkFormal.NearV3.D1.prepD1 cb h = .ok q ∧ q.base = p))
