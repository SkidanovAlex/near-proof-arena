/-- **The codec's `BYTES` ids** are `11 + 16·τ` with `τ < 34` (a scheduler instance of the
prepared statement), so of kind `11`. -/
theorem codecKindIn_d1 {cb : NearSpec.Bytes} {h : ZkFormal.NearV3.D1.HintD1} {p : NearSpecV3.Prep} {q : ZkFormal.NearV3.D1.Public.PrepD1} {oh : Nat}
    {tr : Trace Fp} (hp : (ZkFormal.NearV3.D1.prepD1 cb h = .ok q ∧ q.base = p))
    (hsz : (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh).length < P)
    (hH : HoldsP ZkFormal.NearV3.D1.nearAirV3D1 (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)) tr) :
    ∀ y ∈ codecBytes tr (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)), ∀ a,
      y.head? = some a → a.toNat % 16 = 11 := by
  have hlen : (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh).length < 256 ^ 4 := by unfold P at hsz; omega
  have hrec := (ZkFormal.NearV3.Public.prepared_scheduler_index_d1 ZkFormal.NearV3.D1.nearAirV3D1 oh rfl hp (prepD0_roots_d1 hp)
    (prepD0_source_roots_d1 hp) hlen).2.1
  have hPs := ZkFormal.NearV3.Sched.prepD0_len_d1 hp
  have hL := ZkFormal.NearV3.Sched.codec_local hH codecOwn_d1
  have h22 := ZkFormal.NearV3.Sched.codec_h22 hH codecOwn_d1
  intro y hy a ha
  unfold codecBytes at hy
  obtain ⟨w, hw, hy⟩ := List.mem_flatMap.mp hy
  unfold rowTraffic at hy
  obtain ⟨i, hi, hy⟩ := List.mem_flatMap.mp hy
  split at hy
  · rename_i hbs
    obtain ⟨hpos, rfl⟩ := List.mem_replicate.mp hy
    have hi2 := ZkFormal.NearV3.Sched.Codec.bytes_send_i (show i ∈ ZkFormal.NearV3.Sched.Codec.interactions from hi)
      hbs.1 hbs.2
    subst hi2
    obtain ⟨f, j, hf, hF, -, -, hmsg⟩ := ZkFormal.NearV3.Sched.Codec.bytes_row hL h22 (List.mem_range.mp hw) hpos
    have hτ := (ZkFormal.NearV3.Sched.first_par hH codecOwn_d1 sparOwn_d1
      (ZkFormal.NearV3.Public.prepared_pubIdx_d1 ZkFormal.NearV3.D1.nearAirV3D1 p oh rfl (prepD0_roots_d1 hp) (prepD0_source_roots_d1 hp) hlen)
      (p.sched.map ZkFormal.NearV3.Sched.instOf) p.fwd hrec (by simp only [List.length_map]; omega) hf hF).1
    simp only [List.length_map] at hτ
    rw [hmsg] at ha
    simp only [List.map_cons, List.head?_cons, Option.some.injEq] at ha
    subst ha
    have hlt : 11 + 16 * ZkFormal.Chacha.cv tr T_CODEC f ZkFormal.NearV3.Sched.Codec.tau < P := by
      unfold P; omega
    rw [Fp.toNat_ofNat, Nat.mod_eq_of_lt hlt]
    omega
  · simp at hy

theorem codecKinds_d1 {cb : NearSpec.Bytes} {h : ZkFormal.NearV3.D1.HintD1} {p : NearSpecV3.Prep} {q : ZkFormal.NearV3.D1.Public.PrepD1} {oh : Nat}
    {tr : Trace Fp} (hp : (ZkFormal.NearV3.D1.prepD1 cb h = .ok q ∧ q.base = p))
    (hsz : (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh).length < P)
    (hH : HoldsP ZkFormal.NearV3.D1.nearAirV3D1 (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)) tr) :
    ∀ y ∈ codecBytes tr (ZkFormal.Udr.pubOf Fp (ZkFormal.NearV3.D1.Public.preparedBytesD1 q oh)), ∀ a,
      y.head? = some a → a.toNat % 16 ≠ K_NPRE ∧ a.toNat % 16 ≠ K_NPOST ∧ a.toNat % 16 ≠ K_VPRE := by
  intro y hy a ha
  have := codecKindIn_d1 hp hsz hH y hy a ha
  simp only [K_NPRE, K_NPOST, K_VPRE]
  omega

