/-- **`preB`**: the acct records' pre bytes are bytes. -/
theorem preB_of_d1 {pub : List Fp} {tr : Trace Fp} {r : ZkFormal.NearV3.Assembly.V3Records} (hH : HoldsP ZkFormal.NearV3.D1.nearAirV3D1 pub tr)
    (T : ZkFormal.NearV3.D1.Link.BaseTrafficD1 pub tr r) (W : ZkFormal.NearV3.D1.Link.BaseWfD1 pub r) {others : List Msg}
    {shaS shaR : Nat → List Fp → Nat}
    (S : ZkFormal.NearV3.Link3.ShaHyp r.nodes r.heads r.values others shaS shaR) :
    ∀ a ∈ r.accts, Bytes8 a.pre := by
  intro a ha
  have hw := W.accts.resolve_left (List.ne_nil_of_mem ha)
  obtain ⟨hpre, -⟩ := hw.v1.len a ha
  obtain ⟨p, hp, l, pre, po, hv⟩ := acct_written'_d1 hH T W ha
  obtain ⟨t, ht, hvt, hB⟩ :=
    ZkFormal.NearV3.Link3.val_bytes8 W.nodes W.values (vparentBal_of_d1 hH T) S hp hv
  apply Link.bytes8_of_getD hpre
  intro j hj
  obtain ⟨t', ht', hvt', he⟩ := acct_pre_byte_d1 hH T W ha hj
  have := ZkFormal.NearV3.Link3.vid_inj W.values (ZkFormal.NearV3.Link3.vlen_le W.values) ht ht'
    (by rw [hvt, hvt'])
  subst this
  rw [he]
  exact Link.getD_lt_of_bytes8 hB j

