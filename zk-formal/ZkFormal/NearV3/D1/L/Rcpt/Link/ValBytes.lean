  rw [val_count_d1 T _ _ _ (by decide +kernel), val_count_d1 T _ _ _ (by decide +kernel),
    show ZkFormal.NearV3.D1.Link.isAtD1 Assembly.T_ACCT = AcctV3.interactions from rfl, tcnt_of_traffic T.accts, tcnt_of_traffic T.accts,
    tableBusCount_noside (s := false) (is := ZkFormal.NearV3.D1.Link.isAtD1 T_CODEC) (by decide +kernel),
    tableBusCount_noside (s := false) (is := ZkFormal.NearV3.D1.Link.isAtD1 T_AKEY) (by decide +kernel),
    tableBusCount_noside (s := false) (is := ZkFormal.NearV3.D1.Link.isAtD1 T_QV) (by decide +kernel),
    tableBusCount_noside (s := false) (is := ZkFormal.NearV3.D1.Link.isAtD1 ZkFormal.NearV3.D1.T_AKM) (by decide +kernel),
    tableBusCount_noside (s := false) (is := ZkFormal.NearV3.D1.Link.isAtD1 ZkFormal.NearV3.D1.T_UVAL) (by decide +kernel)] at hb
