  have v0 : tcnt (valTraffic r.values) true B_VBYTES (Msg.toFp M) = 0 := by
    simp [tcnt, valTraffic, valSends, B_VBYTES, B_BYTES, B_ENT, B_SIZE]
  have hv : 0 < tcnt (valTraffic r.values) false B_VBYTES (Msg.toFp M) := by omega
