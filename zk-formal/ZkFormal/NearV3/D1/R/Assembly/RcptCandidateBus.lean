  have hm : (sT0, 40 + Lp + Lv, 1) ∈ plan h Lp Lv Ls kt := by simp [plan]
  have hg := con_d1 hL (r := s + i) (by omega) (e := sub (c gF) (.add (c rf) (.mul (c ee) (c sT0))))
