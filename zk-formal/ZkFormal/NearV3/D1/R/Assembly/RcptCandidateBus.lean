  simp only [eval_sub, eval_add, eval_mul, eval_c] at hg
  have h1 := rf_row_d1 hL lay hrf i hi
  have h2 := cell_state_d1 hL lay hm i hi
  have hee : tr.cell tt (s + i) ee = tr.cell tt s ee := by
    have := lay_const_d1 hL lay i hi ee (by simp [rconsts]); exact this
  rw [h1, h2, hee] at hg
