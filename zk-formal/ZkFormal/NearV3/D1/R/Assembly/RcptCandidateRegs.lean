# ZkFormal.NearV3.Rcpt.Extract.V.Regs — registers of `rcptV3` (v1's `RcptRegs`)

`reg` is loaded at a field's first row (`loads`) and shifted one byte per
row inside a receipt field, so in a register state the row's byte is the
register loaded `k` rows earlier: `b (r0 + k) = reg k (r0)`.
-/

namespace ZkFormal.NearV3.Assembly.ReceiptCandidateProof
open ZkFormal.NearV3.RcptV3Proof ZkFormal.NearV3.Assembly.RcptSkeleton

open ZkFormal.Air ZkFormal.Algebra ZkFormal.Near ZkFormal.Near.Dsl ZkFormal.NearV3.RcptV3

variable {tr : Trace Fp} {pub : List Fp} {tt : Nat}

variable (hL : ZkFormal.NearV3.D1.RcptD1.LocalD1 tr tt pub)
include hL

/-- In a register state the row's byte is the register head. -/
theorem b_reg0_d1 {q X : Nat} (hq : q < tr.height tt) (hX : X ∈ regStates) (h1 : tr.cell tt q X = 1) :
    tr.cell tt q b = tr.cell tt q (reg 0) := by
  have h := con_d1 hL hq (e := .mul (sum (regStates.map c)) (sub (c b) (c (reg 0)))) (mem_rg (by simp [cRegs]))
  simp only [eval_mul, eval_sub, eval_c, eval_sum_map_c] at h
  have oh := (oneHot_d1 hL hq (regStates_sub X hX) h1).2
  rw [fsum_single _ regStates X hX (by decide) (fun y hy hne => oh y (regStates_sub y hy) hne), h1] at h
  grind

/-- Register loads at a field's first row. -/
theorem reg_load_d1 {q X : Nat} {l : List Expr} (hq : q < tr.height tt) (hX : (X, l) ∈ loads)
    (h1 : tr.cell tt q X = 1) (hfs : tr.cell tt q fs = 1) :
    ∀ j (hj : j < l.length), tr.cell tt q (reg j) = l[j].eval tr tt q pub := by
  intro j hj
  have hz : (l[j], j) ∈ l.zip (List.range l.length) := by
    have : (l.zip (List.range l.length))[j]'(by simp [hj]) = (l[j], j) := by simp
    rw [← this]; exact List.getElem_mem _
  have hm : mul3 (c X) (c fs) (sub (c (reg j)) l[j]) ∈ loads.flatMap (fun (s, l) =>
      (l.zip (List.range l.length)).map fun (e, i) => mul3 (c s) (c fs) (sub (c (reg i)) e)) :=
    List.mem_flatMap.mpr ⟨(X, l), hX, List.mem_map.mpr ⟨(l[j], j), hz, rfl⟩⟩
  have h := con_d1 hL hq (e := mul3 (c X) (c fs) (sub (c (reg j)) l[j])) (mem_rg (by
    unfold cRegs; simp only [List.mem_append, hm, true_or]))
  simp only [eval_mul3, eval_c, eval_sub] at h
  rw [h1, hfs] at h; grind

/-- The register shift inside a receipt field. -/
theorem reg_shift_d1 {q : Nat} (hq : q + 1 < tr.height tt) (ha : tr.cell tt q act = 1)
    (he : tr.cell tt q fe = 0) :
    ∀ j, j < 31 → tr.cell tt (q + 1) (reg j) = tr.cell tt q (reg (j + 1)) := by
  intro j hj
  have hm : mul3 (c act) (Dsl.not (c fe)) (sub (n (reg j)) (c (reg (j + 1)))) ∈ (List.range 31).map
      (fun i => mul3 (c act) (Dsl.not (c fe)) (sub (n (reg i)) (c (reg (i + 1))))) :=
    List.mem_map.mpr ⟨j, List.mem_range.mpr hj, rfl⟩
  have h := con_d1 hL (by omega : q < _) (e := mul3 (c act) (Dsl.not (c fe)) (sub (n (reg j)) (c (reg (j + 1)))))
    (mem_rg (by unfold cRegs; simp only [List.mem_append, hm, true_or, or_true]))
  simp only [eval_mul3, eval_c, eval_not, eval_sub, eval_n, nxt hq] at h
  rw [ha, he] at h; grind

/-- Registers along a field (headers included). -/
theorem fld_reg_d1 {r0 L X : Nat} (hH : r0 + L ≤ tr.height tt) (F : Fld tr tt r0 L X) (hX : X ∈ states)
    (hne : X ≠ sCL) : ∀ k, k < L → ∀ j, j + k < 32 → tr.cell tt (r0 + k) (reg j) = tr.cell tt r0 (reg (j + k)) := by
  intro k
  induction k with
  | zero => intro _ j _; rfl
  | succ k ih =>
    intro hk j hj
    have hq : r0 + k < tr.height tt := by omega
    have he : tr.cell tt (r0 + k) fe = 0 := by rw [F.fe k (by omega), if_neg (by omega)]
    rw [show r0 + (k + 1) = r0 + k + 1 by omega, reg_shift_d1 hL (by omega) (F.act k (by omega)) he j (by omega),
      ih (by omega) (j + 1) (by omega), show j + 1 + k = j + (k + 1) by omega]

/-- **Bytes of a register field.** -/
theorem fld_bytes_d1 {r0 L X : Nat} (hH : r0 + L ≤ tr.height tt) (F : Fld tr tt r0 L X) (hX : X ∈ regStates)
    (hne : X ≠ sCL) (hL32 : L ≤ 32) : ∀ k, k < L → tr.cell tt (r0 + k) b = tr.cell tt r0 (reg k) := by
  intro k hk
  rw [b_reg0_d1 hL (by omega) hX (F.st k hk), fld_reg_d1 hL hH F (regStates_sub X hX) hne k hk 0 (by omega), Nat.zero_add]

/-- Bytes of a register field with a load. -/
theorem fld_load_d1 {r0 L X : Nat} {l : List Expr} (hH : r0 + L ≤ tr.height tt) (F : Fld tr tt r0 L X)
    (hX : X ∈ regStates) (hne : X ≠ sCL) (hl : (X, l) ∈ loads) (hLl : L ≤ l.length) (hL32 : L ≤ 32) :
    ∀ k (hk : k < L), tr.cell tt (r0 + k) b = (l[k]'(by omega)).eval tr tt r0 pub := by
  intro k hk
  have hfs : tr.cell tt r0 fs = 1 := by have := F.fs 0 F.pos; simpa using this
  rw [fld_bytes_d1 hL hH F hX hne hL32 k hk, reg_load_d1 hL (by have := F.pos; omega) hl (by simpa using F.st 0 F.pos) hfs k (by omega)]

end ZkFormal.NearV3.Assembly.ReceiptCandidateProof
