import ZkFormal.NearV3.D1.Tables.RcptD1Defs
import ZkFormal.NearV3.Assembly.RcptCandidateTableLocal
import ZkFormal.NearV3.Assembly.RoutingQCandidate
import ZkFormal.NearV3.D1.R.ViewDefs
import ZkFormal.Near.Extract.RcptCount

/-!
# `ZkFormal.NearV3.D1.R.Base` — the receipt table seen by the copied D0a chain

Lane `v3-d1-phase2`, item V4 (plan §7).  The D0a receipt view (`Assembly.RcptViewV3`) is
proved from `TableLocal receiptArithmeticCandidate` / `TableLocal candidateTable`.  The copies
under `D1/R/` (generated by `scripts/rcpt_d1_copy.py` from `scripts/RcptTaint.lean`) take
instead

  `TableLocal rcptK tr t pub`,  `rcptK = { receiptArithmeticCandidate with constraints := tableQD1.constraints }`:

`rcptV3D1`'s constraints (`tableQD1`) with D0a's interactions.  `nearAirV3D1`'s table 16
gives it (`local_K`: the interactions differ only in two messages, not in multiplicities).
The D1 traffic (the two replaced messages) is a separate delta (`D1/R/Delta/Traffic`).

`memD1`: a D0a constraint that `replC` leaves unchanged is a `rcptK` constraint.  The copied
`con_d1` takes the D0a membership and the side condition `replC e = e`, discharged by
`unchanged` (by `rfl` on closed constraints); only the six replaced constraints fail it.
-/

namespace ZkFormal.NearV3.D1.RcptD1

open ZkFormal.Air ZkFormal.Algebra ZkFormal.Near ZkFormal.NearV3 ZkFormal.NearV3.RcptV3
open ZkFormal.NearV3.Assembly ZkFormal.NearV3.Assembly.RcptSkeleton

/-- The replaced D0a constraints. -/
def oldC : List Expr := substC.map (·.1)

/-- `replC` with propositional equality (`replC` uses the derived `BEq`, which has no
`LawfulBEq` instance); equal to it on the table's constraints (`rcptK_constraints`). -/
def replC' (e : Expr) : Expr := ((substC.find? (fun p => decide (p.1 = e))).map (·.2)).getD e

theorem replC'_of_not_mem {e : Expr} (h : e ∉ oldC) : replC' e = e := by
  unfold replC'
  rw [List.find?_eq_none.mpr (fun p hp => by
    simp only [decide_eq_true_eq]
    intro he; exact h (he ▸ List.mem_map_of_mem hp))]
  rfl

/-- `rcptV3D1`'s constraints with D0a's receipt interactions. -/
def rcptK : ZkFormal.Air.Table :=
  { RcptSkeleton.receiptArithmeticCandidate with
    constraints := (RcptSkeleton.receiptArithmeticCandidate.constraints ++
      [RoutingQCandidate.qBound]).map replC' }

theorem tableK_interactions : rcptK.interactions = RcptV3.interactions := rfl

set_option maxRecDepth 65536 in
theorem rcptK_constraints : rcptK.constraints = tableQD1.constraints := by decide

/-- **Membership transport** for an unchanged constraint. -/
theorem memD1 {e : Expr} (he : e ∈ RcptSkeleton.receiptArithmeticCandidate.constraints)
    (hn : replC' e = e) : e ∈ rcptK.constraints := by
  show e ∈ List.map replC' _
  rw [← hn]
  exact List.mem_map_of_mem (List.mem_append_left _ he)

theorem qBound_mem : RoutingQCandidate.qBound ∈ rcptK.constraints := by
  show _ ∈ List.map replC' _
  exact List.mem_map_of_mem (f := replC') (List.mem_append_right _ (List.mem_singleton_self _))

set_option maxRecDepth 16384 in
theorem mults_eq : (RcptV3.interactions.map replI).map (·.mult) = RcptV3.interactions.map (·.mult) := by
  decide

theorem replI_mult : ∀ i ∈ RcptV3.interactions, (replI i).mult = i.mult := by
  intro i hi
  obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.mp hi
  have h := congrArg (·[k]?) mults_eq
  simp only [List.getElem?_map, List.getElem?_eq_getElem hk, Option.map_some] at h
  exact Option.some.inj h

theorem tableQD1_interactions : tableQD1.interactions = RcptV3.interactions.map replI := rfl

/-- `rcptV3D1`'s local legality gives `rcptK`'s. -/
theorem local_K {tr : Trace Fp} {t : Nat} {pub : List Fp} (h : TableLocal tableQD1 tr t pub) :
    TableLocal rcptK tr t pub := by
  refine ⟨h.log_ge, h.log_le, fun r hr e he => h.constr r hr e (rcptK_constraints ▸ he), ?_⟩
  intro r hr i hi b hb
  refine h.bits r hr (replI i) ?_ b ?_
  · rw [tableQD1_interactions]; exact List.mem_map_of_mem hi
  · rw [replI_mult i hi]; exact hb


/-! Constraint lists that contain no replaced constraint. -/

theorem notOld_of_all {L : List Expr}
    (h : (L.all fun e => !(oldC.any fun o => decide (o = e))) = true) : ∀ e ∈ L, e ∉ oldC := by
  intro e he hm
  have h1 := List.all_eq_true.mp h e he
  simp only [Bool.not_eq_eq_eq_not, Bool.not_true, List.any_eq_false, decide_eq_true_eq] at h1
  exact h1 e hm rfl

set_option maxRecDepth 65536 in
theorem notOld_cKey : ∀ e ∈ cKey, e ∉ oldC := notOld_of_all (by decide)
set_option maxRecDepth 65536 in
theorem notOld_cEmit : ∀ e ∈ cEmit, e ∉ oldC := notOld_of_all (by decide)
set_option maxRecDepth 65536 in
theorem notOld_cChars : ∀ e ∈ cChars, e ∉ oldC := notOld_of_all (by decide)
set_option maxRecDepth 65536 in
theorem notOld_cSys : ∀ e ∈ cSys, e ∉ oldC := notOld_of_all (by decide)
set_option maxRecDepth 65536 in
theorem notOld_cRoute : ∀ e ∈ cRoute, e ∉ oldC := notOld_of_all (by decide)
set_option maxRecDepth 65536 in
theorem notOld_gas : ∀ e ∈ RcptSkeleton.systemGasConstraints, e ∉ oldC := notOld_of_all (by decide)

/-- Side condition of the copied `con_d1`: the constraint is not one of the six replaced. -/
macro "rcpt_unchanged" : tactic =>
  `(tactic| first
    | rfl
    | exact ZkFormal.NearV3.D1.RcptD1.replC'_of_not_mem (ZkFormal.NearV3.D1.RcptD1.notOld_cKey _ ‹_›)
    | exact ZkFormal.NearV3.D1.RcptD1.replC'_of_not_mem (ZkFormal.NearV3.D1.RcptD1.notOld_cEmit _ ‹_›)
    | exact ZkFormal.NearV3.D1.RcptD1.replC'_of_not_mem (ZkFormal.NearV3.D1.RcptD1.notOld_cChars _ ‹_›)
    | exact ZkFormal.NearV3.D1.RcptD1.replC'_of_not_mem (ZkFormal.NearV3.D1.RcptD1.notOld_cSys _ ‹_›)
    | exact ZkFormal.NearV3.D1.RcptD1.replC'_of_not_mem (ZkFormal.NearV3.D1.RcptD1.notOld_cRoute _ ‹_›)
    | exact ZkFormal.NearV3.D1.RcptD1.replC'_of_not_mem (ZkFormal.NearV3.D1.RcptD1.notOld_gas _ ‹_›)
    | (apply ZkFormal.NearV3.D1.RcptD1.replC'_of_not_mem
       simp [ZkFormal.NearV3.D1.RcptD1.oldC, ZkFormal.NearV3.D1.RcptD1.substC, ZkFormal.Near.Dsl.c,
         ZkFormal.Near.Dsl.n, ZkFormal.Near.Dsl.k, ZkFormal.Near.Dsl.sub, ZkFormal.Near.Dsl.bool,
         ZkFormal.Near.Dsl.mul3, ZkFormal.Near.Dsl.not, ZkFormal.Near.Dsl.smul]
       done))

/-- **The hypothesis of the copied chain**: `rcptV3D1`'s constraints on table `t` (with D0a's
interactions, `local_K`) and the public extension `M0, T0, O0, TOK0` as bytes. -/
structure LocalD1 (tr : Trace Fp) (t : Nat) (pub : List Fp) : Prop extends TableLocal rcptK tr t pub where
  ext : ExtOk pub

theorem memRepl {e : Expr} (he : e ∈ RcptSkeleton.receiptArithmeticCandidate.constraints) :
    replC' e ∈ rcptK.constraints :=
  List.mem_map_of_mem (List.mem_append_left _ he)

/-! ## The public extension -/

section
variable {pub : List Fp}

theorem ext_u32 (hx : ExtBytes pub) {off : Nat} (ho : E_M0 ≤ off) (ho' : off + 4 ≤ E_M0 + EXT_LEN) :
    ∀ i, i < 4 → pubNat pub (off + i) < 256 := by
  intro i hi
  have := hx (off + i - E_M0) (by omega)
  rwa [show E_M0 + (off + i - E_M0) = off + i by omega] at this

/-- `u32` public value (as D0a's `ReceiptCandidateProof.public_u32_eval`). -/
theorem public_u32_eval (tr : Trace Fp) (tt q : Nat) (pub : List Fp) (off : Nat)
    (hb : ∀ i, i < 4 → pubNat pub (off + i) < 256) :
    (Dsl.sum ((List.range 4).map fun x => Dsl.smul (256 ^ x) (.pub (off + x)))).eval tr tt q pub =
      ((leN' (pubBytes pub off 4) : Nat) : Fp) := by
  rw [ZkFormal.Near.RcptProof.leN'4]
  have h0 := hb 0 (by omega)
  have h1 := hb 1 (by omega)
  have h2 := hb 2 (by omega)
  have h3 := hb 3 (by omega)
  simp only [Nat.add_zero] at h0
  rw [Nat.mod_eq_of_lt h0, Nat.mod_eq_of_lt h1, Nat.mod_eq_of_lt h2, Nat.mod_eq_of_lt h3]
  simp only [List.range_succ, List.range_zero, List.nil_append, List.map_cons, List.map_nil,
    List.map_append, List.cons_append, eval_sum_cons, eval_sum_nil, eval_smul, eval_pub,
    ZkFormal.Near.RcptProof.pub_eq_cast, natCast_add, natCast_mul]
  grind

theorem m0E_eval (hx : ExtBytes pub) (tr : Trace Fp) (t q : Nat) :
    m0E.eval tr t q pub = ((m0V pub : Nat) : Fp) :=
  public_u32_eval tr t q pub E_M0
    (ext_u32 hx (Nat.le_refl _) (by simp [E_M0, EXT_LEN]))
theorem t0E_eval (hx : ExtBytes pub) (tr : Trace Fp) (t q : Nat) :
    t0E.eval tr t q pub = ((t0V pub : Nat) : Fp) :=
  public_u32_eval tr t q pub E_T0
    (ext_u32 hx (by simp [E_M0, E_T0]) (by simp [E_M0, E_T0, EXT_LEN]))
theorem o0E_eval (hx : ExtBytes pub) (tr : Trace Fp) (t q : Nat) :
    o0E.eval tr t q pub = ((o0V pub : Nat) : Fp) :=
  public_u32_eval tr t q pub E_O0
    (ext_u32 hx (by simp [E_M0, E_O0]) (by simp [E_M0, E_O0, EXT_LEN]))

/-- A field equation `a = b` with `b < P` gives `b ≤ a` (`a` reduced mod `P`). -/
theorem le_of_cast_eq {a b : Nat} (hb : b < P) (h : ((a : Nat) : Fp) = ((b : Nat) : Fp)) : b ≤ a := by
  have h1 := congrArg Fp.toNat h
  rw [toNat_natCast, toNat_natCast, Nat.mod_eq_of_lt hb] at h1
  have := Nat.mod_le a P
  omega

theorem u32_lt (pub : List Fp) (off : Nat) : leN' (pubBytes pub off 4) < 2 ^ 32 := by
  rw [ZkFormal.Near.RcptProof.leN'4]; omega

theorem m0V_lt : m0V pub < 2 ^ 32 := u32_lt pub _
theorem t0V_lt : t0V pub < 2 ^ 32 := u32_lt pub _
theorem o0V_lt : o0V pub < 2 ^ 32 := u32_lt pub _

theorem tok0_byte (hx : ExtBytes pub) {i : Nat} (hi : i < 16) : pubNat pub (E_TOK0 + i) < 256 := by
  have := hx (12 + i) (by simp [EXT_LEN]; omega)
  rwa [show E_M0 + (12 + i) = E_TOK0 + i by simp [E_M0, E_TOK0]; omega] at this

end

end ZkFormal.NearV3.D1.RcptD1
